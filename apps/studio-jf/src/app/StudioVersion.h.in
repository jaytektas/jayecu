#pragma once

// THE STUDIO'S OWN VERSION. Generated by CMake from project(... VERSION x.y.z) in CMakeLists.txt —
// bump it THERE, never here. The update check compares this against the tag of the newest release,
// so a release tagged v0.2.0 must be built from a tree that says 0.2.0, or every user of it is told
// that the version they already have is an update.

// A beta build (make beta-release) says so here: "0.3.8-beta.1".
#define STUDIO_VERSION       "@STUDIO_VERSION_TEXT@"
#define STUDIO_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define STUDIO_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define STUDIO_VERSION_PATCH @PROJECT_VERSION_PATCH@
