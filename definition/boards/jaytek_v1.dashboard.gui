, limits clamp down, an override replaces the lot.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":78,"uid":"4a6802d0-82a9-41e6-807b-61020e417a92","type":"panel","x":860,"y":30,"w":410,"h":194,"groupId":0,"props":{"labelText":"Shaping","layoutMode":"0","padding":"0","children":"[{\"id\":79,\"uid\":\"6a5f6ae3-065d-43c7-8aed-e547343162f2\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":270,\"h\":20,\"groupId\":28,\"props\":{\"labelText\":\"Scale (x1000)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3\"}},{\"id\":80,\"uid\":\"be4716c6-2b83-456a-971c-44a3f8892ffd\",\"type\":\"configedit\",\"x\":286,\"y\":12,\"w\":100,\"h\":30,\"groupId\":28,\"props\":{\"signalName\":\"outputs.output[*].scale_x1000\",\"enableCondition\":\"[#outputs.output[*].function] == 3\"}},{\"id\":81,\"uid\":\"9115746f-c986-4aa1-a67e-f04e1ad6411b\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":270,\"h\":20,\"groupId\":29,\"props\":{\"labelText\":\"Offset (x10)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3\"}},{\"id\":82,\"uid\":\"a1910e46-c52a-43a3-bbe1-2f3224b59782\",\"type\":\"configedit\",\"x\":286,\"y\":42,\"w\":100,\"h\":30,\"groupId\":29,\"props\":{\"signalName\":\"outputs.output[*].offset_x10\",\"enableCondition\":\"[#outputs.output[*].function] == 3\"}},{\"id\":83,\"uid\":\"8ec44ed5-5b94-4172-8e8d-4d15d22ff18d\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":270,\"h\":20,\"groupId\":30,\"props\":{\"labelText\":\"Clamp Low (x10)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3\"}},{\"id\":84,\"uid\":\"b790efc3-5021-4cfe-99e0-de009a4a8ce0\",\"type\":\"configedit\",\"x\":286,\"y\":72,\"w\":100,\"h\":30,\"groupId\":30,\"props\":{\"signalName\":\"outputs.output[*].clamp_lo_x10\",\"enableCondition\":\"[#outputs.output[*].function] == 3\"}},{\"id\":85,\"uid\":\"f4c68349-8b14-42e7-b05b-5c31bc17e7f4\",\"type\":\"label\",\