:44,\"groupId\":0,\"props\":{\"labelText\":\"The two coils should look like a sine and a cosine of each other while the valve moves, and go quiet at the hold current when it arrives.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":61,"uid":"7ae66702-7352-4dc7-a31b-3169ebc41ab8","type":"panel","x":810,"y":376,"w":460,"h":128,"groupId":0,"props":{"labelText":"Its Parts","layoutMode":"0","padding":"0","children":"[{\"id\":62,\"uid\":\"fedf94e2-4179-4742-a7d1-a02baceedba0\",\"type\":\"label\",\"x\":10,\"y\":10,\"w\":400,\"h\":20,\"groupId\":17,\"props\":{\"labelText\":\"Idle Control  (what sets the demand)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Engine Functions/Idle Control\"}},{\"id\":63,\"uid\":\"e991481d-99b2-4234-b05e-08fa77304d18\",\"type\":\"label\",\"x\":10,\"y\":38,\"w\":400,\"h\":20,\"groupId\":18,\"props\":{\"labelText\":\"Half Bridge A\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Electrical/Half Bridges/Half Bridge A\"}},{\"id\":64,\"uid\":\"953563b7-2190-4d74-9f73-a11834dc4036\",\"type\":\"label\",\"x\":10,\"y\":66,\"w\":400,\"h\":20,\"groupId\":19,\"props\":{\"labelText\":\"Half Bridge B\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Electrical/Half Bridges/Half Bridge B\"}}]"}},{"id":65,"uid":"2ff4ff5b-3710-4311-b561-2b0a1fc73bf0","type":"label","x":810,"y":512,"w":380,"h":80,"groupId":0,"props":{"labelText":"On enable the valve is homed: driven closed past its full travel into its stop, which becomes 0. An engine stop leaves it where it is. From then on its position is the steps the ECU has issued.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}}]},"Configuration/Engine Functions/Nitrous":{"uid":"106a6c1d-50f2-452f-b45d-6d3f86c35bb0","canvasWidth":1280,"canvasHeight":694,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Nitrous","layout":0,"gridColumns":2,"focusIndex":0,"bord