Color\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"dfe52a7b-eae2-4fd9-9df5-5eae6019ba56\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":90,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Type\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":24,\"uid\":\"0d563bd0-6000-491c-8f65-7d11f2d4f153\",\"type\":\"combobox\",\"x\":106,\"y\":102,\"w\":150,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].type\"}},{\"id\":25,\"uid\":\"1d87aaf9-1650-4b63-918b-4c71eaef55a2\",\"type\":\"label\",\"x\":10,\"y\":142,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"The type decides the units, the sensible domain and how many points the curve needs. Changing it re-seeds the curve.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":26,\"uid\":\"36935336-fd4c-41a3-aba9-b2485562e113\",\"type\":\"label\",\"x\":10,\"y\":214,\"w\":284,\"h\":98,\"groupId\":0,\"props\":{\"labelText\":\"Input and output are both on screen because a calibration is a claim about how one becomes the other: watch the pair move together and a wrong curve shows itself immediately.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":27,\"uid\":\"8a752297-e8ee-4ef2-b891-ee54f6becd50\",\"type\":\"panel\",\"x\":10,\"y\":308,\"w\":284,\"h\":1,\"groupId\":0,\"props\":{\"bgColor\":\"#8a8f98\",\"padding\":\"0\"}},{\"id\":28,\"uid\":\"cc5f79e9-00b7-48a0-937e-e8dd21df2e04\",\"type\":\"label\",\"x\":10,\"y\":318,\"w\":284,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Diagnostics  (5 checks)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Sensors/Other/Rotary Trim Module 4/Diagnostics\"}},{\"id\":29,\"uid\":\"8bc65099-f25a-4b5c-b025-5d13b99673dd\",\"type\":\"label\",\"x\":10,\"y\":342,\"w\":284,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"What this input must complain about, when, and with which code.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}