:\"label\",\"x\":462,\"y\":6,\"w\":60,\"h\":16,\"groupId\":0,\"props\":{\"labelText\":\"Code\",\"align\":\"Left\",\"fontName\":\"|16|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":9,\"uid\":\"c3153caf-b6b1-49b4-af90-a7dd7a02e2aa\",\"type\":\"panel\",\"x\":10,\"y\":26,\"w\":512,\"h\":1,\"groupId\":0,\"props\":{\"bgColor\":\"#8a8f98\",\"padding\":\"0\"}},{\"id\":10,\"uid\":\"a39157d1-0224-4462-a35b-6501e4aeee69\",\"type\":\"label\",\"x\":10,\"y\":34,\"w\":500,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Electrical  (raw input, before calibration)\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":11,\"uid\":\"49d47668-56d1-4604-9672-23e917b33ebd\",\"type\":\"checkbox\",\"x\":10,\"y\":58,\"w\":22,\"h\":22,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.raw_min\"}},{\"id\":12,\"uid\":\"e501cd9c-ab35-4bbf-b221-1203c6301783\",\"type\":\"label\",\"x\":40,\"y\":56,\"w\":194,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Detect Raw Low\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":13,\"uid\":\"6de84ff4-451a-4039-b6b5-7869f6878fc1\",\"type\":\"configedit\",\"x\":240,\"y\":56,\"w\":96,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].diag_raw_min\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_min] == 1\"}},{\"id\":14,\"uid\":\"9a9a45f6-6f1c-46ea-a835-3af1bdc2cb4c\",\"type\":\"enum\",\"x\":346,\"y\":56,\"w\":110,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.raw_min\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_min] == 1\"}},{\"id\":15,\"uid\":\"0f4cb8c0-3165-47a8-979f-05d2488f3243\",\"type\":\"label\",\"x\":462,\"y\":60,\"w\":60,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"P1358\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_min] == 1\"}},{\"id\":16,\"uid\":\"b8cd74f7-904c-4d20-8d75-8c28f26337b3\",\"type\":\"label\",\"x\":34,\"y\":81,\"w\":515,\"h\":16,\"groupId\":3,\"props\":{\"labelText\":\"The pin reads below this \\u2014 an open circuit, or a short to ground.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":17,\"uid\":\"941e9e01-059b-440e-b7fe-d67bb56b739e\",\"type\":\"checkbox\",\"x\":10,\"y\":104,\"w\":22,\"h\":22,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.raw_max\"}},{\"id\":18,\"uid\":\"33fc9e04-fe65-4439-992c-a9a5fa84a227\",\"type\":\"label\",\"x\":40,\"y\":102,\"w\":194,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Detect Raw High\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":19,\"uid\":\"c22b66af-564b-44b6-b911-1a44d2133438\",\"type\":\"configedit\",\"x\":240,\"y\":102,\"w\":96,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].diag_raw_max\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_max] == 1\"}},{\"id\":20,\"uid\":\"2edc900c-2a9c-4864-b49b-a6299bc1b8b3\",\"type\":\"enum\",\"x\":346,\"y\":102,\"w\":110,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.raw_max\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_max] == 1\"}},{\"id\":21,\"uid\":\"fb30fb1a-bb43-40a6-84ec-6ba3b5a94c04\",\"type\":\"label\",\"x\":462,\"y\":106,\"w\":60,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"P1359\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_max] == 1\"}},{\"id\":22,\"uid\":\"da4e9667-5bdf-42f5-aef6-c5be76d72ef0\",\"type\":\"label\",\"x\":34,\"y\":127,\"w\":515,\"h\":16,\"groupId\":4,\"props\":{\"labelText\":\"The pin reads above this \\u2014 a short to power, or a missing pull-down.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"a168ad10-747d-497e-bd8a-41a30016a0cf\",\"type\":\"label\",\"x\":10,\"y\":148,\"w\":500,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Plausibility  (calibrated reading)\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":24,\"uid\":\"ad8d6e7e-5730-40e9-b047-6ded4965e770\",\"type\":\"checkbox\",\"x\":10,\"y\":172,\"w\":22,\"h\":22,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.op_min\"}},{\"id\":25,\"uid\":\"8b36c544-7817-4d66-8603-b5fa19c7abcf\",\"type\":\"label\",\"x\":40,\"y\":170,\"w\":194,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Detect Reading Low\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":26,\"uid\":\"c554c1fe-b3e7-4214-9a5e-4bbb084c2193\",\"type\":\"configedit\",\"x\":240,\"y\":170,\"w\":96,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_op_min\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":27,\"uid\":\"c6c9b517-d62f-4cee-8b06-c73d69efd58d\",\"type\":\"enum\",\"x\":346,\"y\":170,\"w\":110,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.op_min\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":28,\"uid\":\"1910329d-6bfb-41ad-b8d3-505b221d8124\",\"type\":\"label\",\"x\":462,\"y\":174,\"w\":60,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"P135A\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":29,\"uid\":\"8da799d5-2343-4d08-a341-1de33ae0eaed\",\"type\":\"label\",\"x\":34,\"y\":195,\"w\":515,\"h\":16,\"groupId\":5,\"props\":{\"labelText\":\"The calibrated reading is below what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":30,\"uid\":\"5190b254-d2b9-4df6-8966-57832b43f135\",\"type\":\"checkbox\",\"x\":10,\"y\":218,\"w\":22,\"h\":22,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.op_max\"}},{\"id\":31,\"uid\":\"ad98db1d-ec1a-46f7-8b0c-6606842cc65f\",\"type\":\"label\",\"x\":40,\"y\":216,\"w\":194,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Detect Reading High\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":32,\"uid\":\"b292f2a1-720c-4fb2-8873-d1e8b50bda48\",\"type\":\"configedit\",\"x\":240,\"y\":216,\"w\":96,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_op_max\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":33,\"uid\":\"8f43f111-c936-4cc9-8ff9-4823abd0d58f\",\"type\":\"enum\",\"x\":346,\"y\":216,\"w\":110,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.op_max\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":34,\"uid\":\"cdc71aec-60fd-40fd-a321-219831804a35\",\"type\":\"label\",\"x\":462,\"y\":220,\"w\":60,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"P135B\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":35,\"uid\":\"04f1d21f-68cb-412e-b282-86a3c9b01599\",\"type\":\"label\",\"x\":34,\"y\":241,\"w\":515,\"h\":16,\"groupId\":6,\"props\":{\"labelText\":\"The calibrated reading is above what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":36,\"uid\":\"fb80d84d-86bf-4b06-94c7-bf1701c6947d\",\"type\":\"label\",\"x\":560,\"y\":38,\"w\":140,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"DTC Delay\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":37,\"uid\":\"eeb51f5e-6ce8-40f5-b0f1-64280100c52f\",\"type\":\"configedit\",\"x\":706,\"y\":34,\"w\":123,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"sensors.sensor[*].diag_delay_ms\"}},{\"id\":38,\"uid\":\"6e8fd914-3f07-4359-a7e1-2ec0a5eb48b4\",\"type\":\"label\",\"x\":560,\"y\":68,\"w\":400,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"How long a check has to keep failing before it becomes a fault. A sensor that blips once on a starter crank is not a broken sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":39,\"uid\":\"7e8aa68b-0caa-4fd7-856c-534a4b0ca09d\",\"type\":\"label\",\"x\":560,\"y\":110,\"w\":400,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Precondition\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":40,\"uid\":\"48dfa371-40fc-4d84-969c-8d1677ef26d5\",\"type\":\"expression\",\"x\":560,\"y\":132,\"w\":400,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].precond_expr\"}},{\"id\":41,\"uid\":\"85f5e3ea-c6af-48a9-8499-56e73990a701\",\"type\":\"label\",\"x\":560,\"y\":164,\"w\":400,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"The plausibility checks only run while this holds \\u2014 an oil pressure of zero is a fault at 3000 rpm and the truth with the engine stopped.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":42,\"uid\":\"27b7b4aa-b1a6-4492-90f4-c3a82d58d03e\",\"type\":\"label\",\"x\":990,\"y\":34,\"w\":250,\"h\":170,\"groupId\":0,\"props\":{\"labelText\":\"The electrical pair tests the RAW input in the input's own units, before calibration; the plausibility pair tests the calibrated reading. Severity is what the DTC records and what the protection levels read. A check with no code is one this sensor cannot report, and is not offered \\u2014 which is why two sensors show different rows here.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[fuel_level_1]"},"Configuration/Sensors/Other/Fuel Level 2":{"uid":"493e10f1-cd31-48ed-8012-643e731ce042","canvasWidth":1280,"canvasHeight":700,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Fuel Level 2","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"c6214fe8-c750-478a-90e2-6f5b5289d4c5","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"sensors.sensor[*].enabled"}},{"id":2,"uid":"c3e55487-4949-40e7-b314-f78ea53a1c62","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"5e6fe9cf-7ee1-4cb8-bd41-760d7302c314","type":"label","x":136,"y":4,"w":379,"h":24,"groupId":0,"props":{"labelText":"What this input is wired to, and what its curve makes of it.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"833942f3-3a5d-4abd-991c-547884a4f8a0","type":"panel","x":10,"y":30,"w":300,"h":662,"groupId":0,"props":{"labelText":"1 · Input","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":5,\"uid\":\"7e5afb7e-218d-4d18-9b76-ab413905fa42\",\"type\":\"value\",\"x\":12,\"y\":10,\"w\":274,\"h\":54,\"groupId\":0,\"props\":{\"signalName\":\"[$~]\",\"fontName\":\"|26|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"4\"}},{\"id\":6,\"uid\":\"573bc7ec-7fc3-4dda-8690-ad877470a9f4\",\"type\":\"label\",\"x\":12,\"y\":66,\"w\":274,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Raw input  (as the pin reads it)\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":7,\"uid\":\"11d8e423-a76a-4b19-82d5-0e3a2132f9b5\",\"type\":\"label\",\"x\":10,\"y\":100,\"w\":90,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Interface\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":8,\"uid\":\"1b3198be-9a39-4e65-ba19-6e48b7f86d67\",\"type\":\"combobox\",\"x\":106,\"y\":96,\"w\":150,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].interface\"}},{\"id\":9,\"uid\":\"c6f83111-020f-4cd4-ba94-b77c050a76ff\",\"type\":\"wiring\",\"x\":10,\"y\":132,\"w\":274,\"h\":76,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].source\",\"condition\":\"[#sensors.sensor[*].interface] == 0 || [#sensors.sensor[*].interface] == 1 || [#sensors.sensor[*].interface] == 3 || [#sensors.sensor[*].interface] == 4 || [#sensors.sensor[*].interface] == 6 || [#sensors.sensor[*].interface] == 7\"}},{\"id\":10,\"uid\":\"98eb4b36-3420-4f73-8e9e-c448efd44028\",\"type\":\"label\",\"x\":10,\"y\":220,\"w\":90,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"CAN Field\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 5\"}},{\"id\":11,\"uid\":\"fe46e6d1-48cd-4798-aba7-80b8784373a0\",\"type\":\"canfield\",\"x\":106,\"y\":216,\"w\":170,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].can_frame\",\"condition\":\"[#sensors.sensor[*].interface] == 5\"}},{\"id\":12,\"uid\":\"dc3181ce-ac9f-4f0a-8b98-2e5fb3e062ba\",\"type\":\"checkbox\",\"x\":10,\"y\":252,\"w\":22,\"h\":22,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].flags.invert\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":13,\"uid\":\"67df2de1-595a-44d7-96a4-db96e6a23fae\",\"type\":\"label\",\"x\":40,\"y\":249,\"w\":220,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Invert  (switch inputs)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":14,\"uid\":\"8a2bfe70-91a6-4830-8459-a90376a0da8f\",\"type\":\"label\",\"x\":10,\"y\":292,\"w\":274,\"h\":224,\"groupId\":0,\"props\":{\"labelText\":\"Interface says HOW the pin is read, and decides which inputs the picker offers \\u2014 a frequency sensor cannot be wired to an analogue pin. Two sensors on one pin is a fault, not a preference. A CAN sensor has no pin at all: it reads a field defined on the Receive page for its bus, named here by that frame and the field's start bit. A field whose own Signal is set is greyed in the list \\u2014 the frame writes that channel itself, and the sensor publishing it too would put two producers on one channel.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":15,"uid":"a4e60494-88f4-4851-9477-3d1337e5e656","type":"panel","x":320,"y":30,"w":630,"h":662,"groupId":0,"props":{"labelText":"2 · Calibration","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":16,\"uid\":\"3079fc1d-29da-4fa7-9273-93f3777fc08d\",\"type\":\"table\",\"x\":10,\"y\":10,\"w\":600,\"h\":96,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"axisMode\":\"1\",\"displayUnit\":\"Auto\",\"displayUnitX\":\"Auto\",\"displayUnitY\":\"Auto\",\"cellTrace\":\"2\"}},{\"id\":17,\"uid\":\"d85eff84-9bfe-46af-96ad-ce5271e8160a\",\"type\":\"curve\",\"x\":10,\"y\":114,\"w\":600,\"h\":450,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"displayUnit\":\"Auto\",\"axisUnit\":\"Auto\",\"valueUnit\":\"Auto\"}},{\"id\":18,\"uid\":\"c46b3f2c-7503-4bdc-8a3e-eeba05b12b67\",\"type\":\"label\",\"x\":10,\"y\":568,\"w\":600,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"Raw in along the top, reading out underneath. Right-click either for insert, delete, linearise \\u2014 or to save this curve to a file and load it into the next car with the same sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\",\"signalName\":\"sensors.sensor[*].cal\"}},{\"id\":19,\"uid\":\"58ee3c7a-37fc-4aaa-b498-4bc7f5f0b930\",\"type\":\"bands\",\"x\":10,\"y\":10,\"w\":600,\"h\":616,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\"}}]"}},{"id":20,"uid":"251aeb90-bc32-4d3b-9a21-98497785295b","type":"panel","x":960,"y":30,"w":310,"h":662,"groupId":0,"props":{"labelText":"3 · Output","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":21,\"uid\":\"f0fb7409-86bd-4900-bf4c-cc5428a539d7\",\"type\":\"value\",\"x\":12,\"y\":10,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"signalName\":\"[$*]\",\"format\":\"%.2f\",\"fontName\":\"|30|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"4\"}},{\"id\":22,\"uid\":\"7c657b7e-336d-44ab-9063-2056f5c5da12\",\"type\":\"label\",\"x\":12,\"y\":74,\"w\":284,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Reading  (what everything downstream sees)\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"f5c50ce1-6786-4448-bcf2-90f5390eaa48\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":90,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Type\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":24,\"uid\":\"7088d3f3-53b9-42e2-8799-7a3ff20e1c52\",\"type\":\"label\",\"x\":106,\"y\":106,\"w\":190,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Level\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":25,\"uid\":\"e3a2c741-35ad-4034-951a-a987c17cc2e7\",\"type\":\"label\",\"x\":10,\"y\":142,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"This input's type is fixed by the ECU \\u2014 it is what the sensor IS. Only the generic inputs (aux, rotary trim) can be re-typed.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":26,\"uid\":\"8f255644-ef61-491f-9a31-21ea217f9d87\",\"type\":\"label\",\"x\":10,\"y\":214,\"w\":284,\"h\":98,\"groupId\":0,\"props\":{\"labelText\":\"Input and output are both on screen because a calibration is a claim about how one becomes the other: watch the pair move together and a wrong curve shows itself immediately.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":27,\"uid\":\"7c14b5fc-2323-4497-b969-ce0181d7947e\",\"type\":\"panel\",\"x\":10,\"y\":308,\"w\":284,\"h\":1,\"groupId\":0,\"props\":{\"bgColor\":\"#8a8f98\",\"padding\":\"0\"}},{\"id\":28,\"uid\":\"05edd8c6-7ca0-47ec-a427-412c5324b034\",\"type\":\"label\",\"x\":10,\"y\":318,\"w\":284,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Diagnostics  (4 checks)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Sensors/Other/Fuel Level 2/Diagnostics\"}},{\"id\":29,\"uid\":\"1c8