"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}}]"}}]},"Configuration/Protection/Engine Protection":{"uid":"1ea96496-31c2-4770-b58e-abcb25cbe0b9","canvasWidth":1280,"canvasHeight":494,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Engine Protection","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"6f1f7871-1569-41f1-893b-ee8fe33474f1","type":"label","x":10,"y":4,"w":990,"h":24,"groupId":0,"props":{"labelText":"The limits the ECU enforces on its own, whatever the tune asks for. Everything here acts BEFORE damage, which is why the warning threshold matters as much as the cut.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"08bf832b-508a-4c21-9a5e-9bd4ad6e3d9c","type":"panel","x":10,"y":30,"w":420,"h":164,"groupId":0,"props":{"labelText":"Built-in Thresholds","layoutMode":"0","padding":"0","children":"[{\"id\":3,\"uid\":\"19b47f43-3489-4869-8912-68493901aa75\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":170,\"h\":20,\"groupId\":2,\"props\":{\"labelText\":\"Coolant Warning\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":4,\"uid\":\"08db1f5d-a8b2-4a22-b467-b1d4df3f6da8\",\"type\":\"configedit\",\"x\":186,\"y\":12,\"w\":100,\"h\":30,\"groupId\":2,\"props\":{\"signalName\":\"engine_protection.clt_warn_c\"}},{\"id\":5,\"uid\":\"28da2e18-8789-435b-8a22-3cd76871974a\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":170,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Coolant Cut\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":6,\"uid\":\"28c4f51d-ddd6-4c80-9bb0-32692e177d85\",\"type\":\"configedit\",\"x\":186,\"y\":42,\"w\":100,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"engine_protection.clt_cut_c\"}},{\"id\":7,\"uid\":\"e55fc503-6a5d-4065-97e6-0543f81441b9\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":170,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Air Temp Cut\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":8,\"uid\":\"f0a24a92-794b-40a1-a69d-d736ad825fe1\",\"type\":\"configedit\",\"x\":186,\"y\":72,\"w\":100,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"engine_protection.iat_cut_c\"}},{\"id\":9,\"uid\":\"698cb90c-7a68-4256-87ec-6279259cab22\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":170,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Overboost Cut\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":10,\"uid\":\"f99718f0-251a-435d-a306-a79cf2ab9edb\",\"type\":\"configedit\",\"x\":186,\"y\":102,\"w\":111,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"engine_protection.map_cut_kpa\"}}]"}},{"id":11,"uid":"da721226-bf35-4288-a202-5ea093a14e05","type":"label","x":10,"y":200,"w":410,"h":72,"groupId":0,"props":{"labelText":"Warning comes first and is the one worth setting carefully: it is the level at which the engine is still fine and something should be done about it. The cut is the last resort, and an engine that reaches it has already been at the warning level for a while.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":12,"uid":"81fcd094-2760-426d-9eae-5351310c714f","type":"panel","x":10,"y":302,"w":420,"h":104,"groupId":0,"props":{"labelText":"Trusting The Signals","layoutMode":"0","padding":"0","children":"[{\"id\":13,\"uid\":\"19b589cb-f769-40b7-8c95-747b5b6e77f1\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":170,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Sensor Stale Timeout\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":14,\"uid\":\"7b034a37-ca17-4c6c-b70b-d9f0abe2d745\",\"type\":\"configedit\",\"x\":186,\"y\":12,\"w\":115,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"engine_protection.sensor_timeout_ms\"}},{\"id\":15,\"uid\":\"18ad0fa6-ff7c-44e7-9cc7-ddfc52b055b4\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":170,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"Trigger Error Limit\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":16,\"uid\":\"8b7f514d-76b5-4564-9367-566616082bef\",\"type\":\"configedit\",\"x\":186,\"y\":42,\"w\":108,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"engine_protection.trigger_error_pct_limit\"}}]"}},{"id":17,"uid":"651e34b2-0f5e-42bb-976c-63632cb85c69","type":"label","x":10,"y":412,"w":410,"h":72,"groupId":0,"props":{"labelText":"A protection that reads a stale sensor is worse than none: it either cuts on a number that stopped being true, or misses the one it was watching for. Past the timeout the reading is treated as absent. The trigger-error limit is the same idea for position — 0 disables it.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":18,"uid":"f61258ad-0e82-4110-9e08-bfa1e612f55b","type":"panel","x":440,"y":30,"w":400,"h":156,"groupId":0,"props":{"labelText":"The Two Grids","layoutMode":"0","padding":"0","children":"[{\"id\":19,\"uid\":\"240af591-efa3-4580-8726-988ec1625aee\",\"type\":\"label\",\"x\":10,\"y\":10,\"w\":350,\"h\":20,\"groupId\":8,\"props\":{\"labelText\":\"Protection Levels  (3 levels)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Protection/Engine Protection/Protection Levels\"}},{\"id\":20,\"uid\":\"79e068f1-be45-46d9-bd2f-0969793cbe8f\",\"type\":\"label\",\"x\":10,\"y\":38,\"w\":350,\"h\":20,\"groupId\":9,\"props\":{\"labelText\":\"Threshold Monitors  (8 slots)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Protection/Engine Protection/Threshold Monitors\"}},{\"id\":21,\"uid\":\"513ebeff-fd9e-45ef-83dd-15891a48f29b\",\"type\":\"label\",\"x\":10,\"y\":66,\"w\":350,\"h\":20,\"groupId\":10,\"props\":{\"labelText\":\"Lambda Protection\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Protection/Lambda Protection\"}},{\"id\":22,\"uid\":\"b211de3a-bc45-4254-a941-863ee55fb7dd\",\"type\":\"label\",\"x\":10,\"y\":94,\"w\":350,\"h\":20,\"groupId\":11,\"props\":{\"labelText\":\"Misfire Detection\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Protection/Misfire Detection\"}}]"}},{"id":23,"uid":"40c44522-4b0c-4279-82b7-6b1f2bf9dd6d","type":"label","x":440,"y":192,"w":390,"h":104,"groupId":0,"props":{"labelText":"A LEVEL is a package of responses — enrich, retard, trim boost, drop the rev limit — raised by a DTC condition and held until it auto-resets. A MONITOR is a condition you write, over any bus signal, which is how you protect against something the built-in checks do not cover: oil pressure, a fuel-pressure differential, a gearbox temperature.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":24,"uid":"9cb590c4-b168-4a9d-9b7f-f0b2359e7c82","type":"panel","x":850,"y":30,"w":420,"h":400,"groupId":0,"props":{"labelText":"Right Now","layoutMode":"0","padding":"0","children":"[{\"id\":25,\"uid\":\"57152645-a3a2-459c-8f82-27db7115971f\",\"type\":\"value\",\"x\":15,\"y\":14,\"w\":120,\"h\":30,\"groupId\":12,\"props\":{\"signalName\":\"[$prot_ign_retard]\",\"format\":\"%.1f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":26,\"uid\":\"f846bb72-8f7f-4b77-8aca-173af8b3b305\",\"type\":\"label\",\"x\":15,\"y\":44,\"w\":120,\"h\":20,\"groupId\":12,\"props\":{\"labelText\":\"Ign Retard\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":27,\"uid\":\"29f7a04c-70a1-4a0b-9447-64b01e5078e9\",\"type\":\"value\",\"x\":145,\"y\":14,\"w\":120,\"h\":30,\"groupId\":13,\"props\":{\"signalName\":\"[$soft_cut_pct]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":28,\"uid\":\"7602b832-f6db-490f-8add-01a51366d881\",\"type\":\"label\",\"x\":145,\"y\":44,\"w\":120,\"h\":20,\"groupId\":13,\"props\":{\"labelText\":\"Soft Cut\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":29,\"uid\":\"85eccdf6-1ec9-41d7-9c42-3bbab79d04cd\",\"type\":\"value\",\"x\":275,\"y\":14,\"w\":120,\"h\":30,\"groupId\":14,\"props\":{\"signalName\":\"[$prot_rev_limit]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":30,\"uid\":\"309d6f72-0937-4e9c-a19f-8a48467f94c6\",\"type\":\"label\",\"x\":275,\"y\":44,\"w\":120,\"h\":20,\"groupId\":14,\"props\":{\"labelText\":\"Rev Limit\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":31,\"uid\":\"ac016bda-2a13-48c3-9e55-e563a5961f26\",\"type\":\"indicator\",\"x\":15,\"y\":80,\"w\":124,\"h\":40,\"groupId\":0,\"props\":{\"signalName\":\"[$prot_status] > 0\",\"onTitle\":\"PROTECTING\",\"offTitle\":\"PROTECTING\",\"onBg\":\"#ff8c28\",\"onFg\":\"#000000\",\"offBg\":\"#2a2a2e\",\"offFg\":\"#6e7178\",\"fontName\":\"|15|0|0\"}},{\"id\":32,\"uid\":\"a97265df-45c1-4770-acc4-0890c52dfcda\",\"type\":\"indicator\",\"x\":147,\"y\":80,\"w\":124,\"h\":40,\"groupId\":0,\"props\":{\"signalName\":\"[$fuel_cut]\",\"onTitle\":\"FUEL CUT\",\"offTitle\":\"FUEL CUT\",\"onBg\":\"#ff453a\",\"onFg\":\"#000000\",\"offBg\":\"#2a2a2e\",\"offFg\":\"#6e7178\",\"fontName\":\"|15|0|0\"}},{\"id\":33,\"uid\":\"65c37e13-2718-4dfd-a44f-02351669cf26\",\"type\":\"indicator\",\"x\":279,\"y\":80,\"w\":124,\"h\":40,\"groupId\":0,\"props\":{\"signalName\":\"[$ign_cut]\",\"onTitle\":\"IGN CUT\",\"offTitle\":\"IGN CUT\",\"onBg\":\"#ff453a\",\"onFg\":\"#000000\",\"offBg\":\"#2a2a2e\",\"offFg\":\"#6e7178\",\"fontName\":\"|15|0|0\"}},{\"id\":34,\"uid\":\"5d301efa-8bf3-4b87-b69a-ffebc1c38a70\",\"type\":\"value\",\"x\":15,\"y\":130,\"w\":120,\"h\":30,\"groupId\":15,\"props\":{\"signalName\":\"[$clt]\",\"format\":\"%.1f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":35,\"uid\":\"8b2c30d5-2349-45b4-a075-1cd948a17b63\",\"type\":\"label\",\"x\":15,\"y\":160,\"w\":120,\"h\":20,\"groupId\":15,\"props\":{\"labelText\":\"Coolant\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":36,\"uid\":\"5c5a727d-cf71-4de9-a5f5-07e45e85fc32\",\"type\":\"value\",\"x\":145,\"y\":130,\"w\":120,\"h\":30,\"groupId\":16,\"props\":{\"signalName\":\"[$iat]\",\"format\":\"%.1f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":37,\"uid\":\"a42bb8ed-c3e2-4c7a-9246-30b48cccfe8c\",\"type\":\"label\",\"x\":145,\"y\":160,\"w\":120,\"h\":20,\"groupId\":16,\"props\":{\"labelText\":\"Air Temp\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":38,\"uid\":\"44de2cc3-75e8-48c1-9031-6818f792798f\",\"type\":\"value\",\"x\":275,\"y\":130,\"w\":120,\"h\":30,\"groupId\":17,\"props\":{\"signalName\":\"[$map]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":39,\"uid\":\"4d238862-0a10-499b-9f7c-9af83e1ab649\",\"type\":\"label\",\"x\":275,\"y\":160,\"w\":120,\"h\":20,\"groupId\":17,\"props\":{\"labelText\":\"MAP\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":40,\"uid\":\"e1570ecb-a120-45f9-a671-fb3ab69cd7cd\",\"type\":\"livegraph\",\"x\":15,\"y\":196,\"w\":390,\"h\":100,\"groupId\":0,\"props\":{\"lines\":\"clt,0,130,0,0,0\\nmap,0,300,0,0,0\\nprot_ign_retard,0,60,0,0,0\",\"showLegend\":\"1\",\"displayUnit\":\"Auto\",\"borderWidth\":\"1\"}},{\"id\":41,\"uid\":\"3b67dbb5-c24b-42a2-8f1c-3fc3753a3cd1\",\"type\":\"label\",\"x\":15,\"y\":302,\"w\":390,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"Retard and the reduced rev limit are what protection looks like before a cut: if they are on, something is already over a threshold.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}]},"Configuration/Protection/Engine Protection/Protection Levels":{"uid":"3bd753c3-649a-4699-bca1-c1431228d45c","canvasWidth":1280,"canvasHeight":700,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Protection Levels","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"938cfadf-d63d-4771-a59c-