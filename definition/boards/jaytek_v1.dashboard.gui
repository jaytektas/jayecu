gn\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":26,\"uid\":\"de87cfac-bdd4-4e36-968d-31093c3d1b98\",\"type\":\"configedit\",\"x\":240,\"y\":170,\"w\":96,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_op_min\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":27,\"uid\":\"55ec0ea2-b77c-4bd1-b57c-2ad6c41cb357\",\"type\":\"enum\",\"x\":346,\"y\":170,\"w\":110,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.op_min\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":28,\"uid\":\"2e506e9f-baed-45ed-a732-d21885956309\",\"type\":\"label\",\"x\":462,\"y\":174,\"w\":60,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"P1122\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":29,\"uid\":\"ca35220b-fb11-4127-b80b-f6872934b5c8\",\"type\":\"label\",\"x\":34,\"y\":195,\"w\":515,\"h\":16,\"groupId\":5,\"props\":{\"labelText\":\"The calibrated reading is below what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":30,\"uid\":\"b70e40b3-52c8-4644-891c-20ca78030d7e\",\"type\":\"checkbox\",\"x\":10,\"y\":218,\"w\":22,\"h\":22,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.op_max\"}},{\"id\":31,\"uid\":\"77a8fbc5-7e7e-4a2f-aa51-c5f30d0a1486\",\"type\":\"label\",\"x\":40,\"y\":216,\"w\":194,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Detect Reading High\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":32,\"uid\":\"88abc9a6-7866-4fcd-8de0-40e104f67f1d\",\"type\":\"configedit\",\"x\":240,\"y\":216,\"w\":96,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_op_max\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":33,\"uid\":\"40765fd2-b599-4806-8a62-9574c8d80e71\",\"type\":\"enum\",\"x\":346,\"y\":216,\"w\":110,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.op_max\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":34,\"uid\":\"b2cc9f73-9335-41d3-8752-8278392acb4a\",\"type\":\"label\",\"x\":462,\"y\":220,\"w\":60,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"P1123\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":35,\"uid\":\"c1206036-622c-4872-80ab-2a263c8168d6\",\"type\":\"label\",\"x\":34,\"y\":241,\"w\":515,\"h\":16,\"groupId\":6,\"props\":{\"labelText\":\"The calibrated reading is above what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":36,\"uid\":\"19f85eb1-fc1b-41d9-82ed-23bc7468e7aa\",\"type\":\"label\",\"x\":560,\"y\":38,\"w\":140,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"DTC Delay\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":37,\"uid\":\"2c695e70-7c49-49b2-8a79-86c50c630e49\",\"type\":\"configedit\",\"x\":706,\"y\":34,\"w\":123,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"sensors.sensor[*].diag_delay_ms\"}},{\"id\":38,\"uid\":\"af6b6595-45e6-422a-a956-360e9001d3f2\",\"type\":\"label\",\"x\":560,\"y\":68,\"w\":400,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"How long a check has to keep failing before it becomes a fault. A sensor that blips once on a starter crank is not a broken sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":39,\"uid\":\"049bcb8f-96e5-4424-8577-d7d4051d2c10\",\"type\":\"label\",\"x\":560,\"y\":110,\"w\":400,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Precondition\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":40,\"uid\":\"c5572a15-53c7-4836-bdd5-572442a585a2\",\"type\":\"expression\",\"x\":560,\"y\":132,\"w\":400,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].precond_expr\"}},{\"id\":41,\"uid\":\"ac186c5c-887f-4bcb-a66b-3467ff898f4e\",\"type\":\"label\",\"x\":560,\"y\":164,\"w\":400,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"The plausibility checks only run while this holds \\u2014 an oil pressure of zero is a fault at 3000 rpm and the truth with the engine stopped.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":42,\"uid\":\"b9e5e7f3-8c6f-4a72-b8d8-bf8816181b12\",\"type\":\"label\",\"x\":990,\"y\":34,\"w\":250,\"h\":170,\"groupId\":0,\"props\":{\"labelText\":\"The electrical pair tests the RAW input in the input's own units, before calibration; the plausibility pair tests the calibrated reading. Severity is what the DTC records and what the protection levels read. A check with no code is one this sensor cannot report, and is not offered \\u2014 which is why two sensors show different rows here.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[egt_10]"},"Configuration/Sensors/Engine/Exhaust Gas Temperature 11":{"uid":"b26236bd-e406-44e4-8777-f12c99d8a854","canvasWidth":1280,"canvasHeight":700,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Exhaust Gas Temperature 11","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"d4d66de0-58cd-41a0-af0e-de07752824df","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"sensors.sensor[*].enabled"}},{"id":2,"uid":"3cb1248b-20fe-4df2-8246-2ad1fb2544f2","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"e6256283-1695-4704-99aa-9d72cb24ca9e","type":"label","x":136,"y":4,"w":379,"h":24,"groupId":0,"pr