f-ac2bf93a11c8\",\"type\":\"label\",\"x\":34,\"y\":81,\"w\":515,\"h\":16,\"groupId\":3,\"props\":{\"labelText\":\"The pin reads below this \\u2014 an open circuit, or a short to ground.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":17,\"uid\":\"e79de264-7e14-4d22-857e-cb6a86d4659d\",\"type\":\"checkbox\",\"x\":10,\"y\":104,\"w\":22,\"h\":22,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.raw_max\"}},{\"id\":18,\"uid\":\"c6015ea5-32d6-42d9-ab74-9206776e4468\",\"type\":\"label\",\"x\":40,\"y\":102,\"w\":194,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Detect Raw High\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":19,\"uid\":\"d0e93c7f-88ee-4c1c-903c-484cf28682c4\",\"type\":\"configedit\",\"x\":240,\"y\":102,\"w\":96,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].diag_raw_max\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_max] == 1\"}},{\"id\":20,\"uid\":\"d17680d8-dd80-4e8c-8134-9adb6d37663b\",\"type\":\"enum\",\"x\":346,\"y\":102,\"w\":110,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.raw_max\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_max] == 1\"}},{\"id\":21,\"uid\":\"8b6c55d2-9c84-430e-a4a9-163250793fbc\",\"type\":\"label\",\"x\":462,\"y\":106,\"w\":60,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"P1349\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_max] == 1\"}},{\"id\":22,\"uid\":\"7e06e103-c24c-4914-9dad-3f5ac8e606a6\",\"type\":\"label\",\"x\":34,\"y\":127,\"w\":515,\"h\":16,\"groupId\":4,\"props\":{\"labelText\":\"The pin reads above this \\u2014 a short to power, or a missing pull-down.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"fac27437-592c-41ee-9102-cf325491e516\",\"type\":\"label\",\"x\":10,\"y\":148,\"w\":500,\"h\":18,\"groupId\":0,\"props\