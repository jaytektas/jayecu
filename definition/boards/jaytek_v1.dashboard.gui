 Control":{"uid":"7319fb4f-2c84-45da-ac1c-aeeedf53f784","canvasWidth":1280,"canvasHeight":722,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Knock Control","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"2564b995-5c86-40f1-b70a-146320a095f5","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"knock.enabled"}},{"id":2,"uid":"e91609cf-76b0-44eb-be7c-117f53563e26","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"e348e703-420a-486f-8896-300db14f6486","type":"label","x":136,"y":4,"w":864,"h":40,"groupId":0,"props":{"labelText":"Listens in a window around each cylinder's combustion, compares what it hears to the learned noise floor at that operating point, and pulls timing when the difference says detonation.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"6f0d779a-5c78-432b-8612-313e1ea6d923","type":"panel","x":10,"y":46,"w":430,"h":194,"groupId":0,"props":{"labelText":"1 · Listening","layoutMode":"0","padding":"0","children":"[{\"id\":5,\"uid\":\"d84ff71b-87af-442b-a08f-4ab46f3e1e26\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":200,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Detection Source\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#knock.enabled] == 1\"}},{\"id\":6,\"uid\":\"a8b1d6c1-7ad6-45da-aa66-15bd4730c52a\",\"type\":\"combobox\",\"x\":216,\"y\":12,\"w\":190,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"knock.source\",\"enableCondition\":\"[#knock.enabled] == 1\"}},{\"id\":7,\"uid\":\"fee35cce-8dfe-4322-a513-8bed74ee944c\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":200,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"External Intensity\",\"align\":\"Le