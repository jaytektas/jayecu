put at all.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":12,"uid":"60137e52-e8e1-4686-91b8-c9d23c330607","type":"panel","x":10,"y":302,"w":470,"h":132,"groupId":0,"props":{"labelText":"Right Now","layoutMode":"0","padding":"0","children":"[{\"id\":13,\"uid\":\"988c40dd-237c-44c9-87dc-b382b04a4f82\",\"type\":\"value\",\"x\":15,\"y\":12,\"w\":170,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"rpm\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":14,\"uid\":\"52327055-da49-4dc8-90ec-49b681c9449b\",\"type\":\"label\",\"x\":15,\"y\":42,\"w\":170,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Engine RPM\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":15,\"uid\":\"f9fbb871-2e8e-401f-8203-d54c834d9205\",\"type\":\"value\",\"x\":195,\"y\":12,\"w\":170,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"clt\",\"format\":\"%.1f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":16,\"uid\":\"f6597b88-4278-4411-9d7a-e34421ca7a8f\",\"type\":\"label\",\"x\":195,\"y\":42,\"w\":170,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Coolant\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":17,\"uid\":\"abbbba9f-d23f-48a9-a089-a678f4ef5d26\",\"type\":\"label\",\"x\":15,\"y\":76,\"w\":340,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Outputs  (the duty)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Electrical/Outputs\"}}]"}},{"id":18,"uid":"cc4316da-0a89-4ede-82d5-e1506c167290","type":"panel","x":500,"y":30,"w":470,"h":150,"groupId":0,"props":{"labelText":"The Tables","layoutMode":"0","padding":"0","children":"[{\"id\":19,\"uid\":\"c9a4147c-e273-40a7-8ab6-4eb43fefec84\",\"type\":\"label\",\"x\":10,\"y\":12,\"w\":450,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"A carrier table is a table like any other \\u2014 the generic pool is where one with no other job lives. Edit the cells there; name it here.\",\"align\":\"Left\