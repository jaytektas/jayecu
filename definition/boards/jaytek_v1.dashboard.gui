 a steady error so the car settles ON the set speed rather than a little under it up a grade. It is highest at zero error on purpose — on target the loop is purely integral, which is what makes it sit still instead of hunting.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"ba805435-66cb-47c5-9be2-c7efe529e1df","type":"table","x":10,"y":46,"w":1066,"h":75,"groupId":0,"props":{"signalName":"cruise_control.cruise_i_gain","axisMode":"1","displayUnit":"Auto","displayUnitX":"Auto","displayUnitY":"Auto","displayUnitZ":"Auto","cellTrace":"2","anchorX":"both","anchorY":"both"}},{"id":3,"uid":"aa861914-8b90-4b98-89b7-bd8841b32bd5","type":"value","x":10,"y":129,"w":88,"h":30,"groupId":2,"props":{"signalName":"cruise_control.cruise_i_gain","format":"%.2f","fontName":"|20|0|0","align":"Center","anchorY":"bottom"}},{"id":4,"uid":"29360dea-30f8-418d-a62f-a3b81832dcec","type":"label","x":10,"y":159,"w":88,"h":20,"groupId":2,"props":{"labelText":"Integral Gain","align":"Center","fontName":"|15|0|0","fgColor":"#8a8f98","anchorY":"bottom"}},{"id":5,"uid":"d5361d4e-5629-43b1-9123-7b33f17d3923","type":"value","x":110,"y":129,"w":83,"h":30,"groupId":3,"props":{"signalName":"cruise_error_kph","format":"%.1f","fontName":"|20|0|0","align":"Center","anchorY":"bottom"}},{"id":6,"uid":"74c090d1-5284-4e70-8c18-39f93aa276b3","type":"label","x":110,"y":159,"w":83,"h":20,"groupId":3,"props":{"labelText":"Speed Error","align":"Center","fontName":"|15|0|0","fgColor":"#8a8f98","anchorY":"bottom"}},{"id":7,"uid":"a3558b59-c7c1-4d33-9bac-fe23106555fa","type":"value","x":205,"y":129,"w":83,"h":30,"groupId":4,"props":{"signalName":"cruise_target","format":"%.1f","fontName":"|20|0|0","align":"Center","anchorY":"bottom"}},{"id":8,"uid":"a9e53a87-c34a-428f-8de6-f4c3175d3759","type":"label","x":205,"y":159,"w":83,"h":20,"groupId":4,"props":{"labelText":"Set Speed","align":"Center","fontName":"|15|0|0","fgColor":"#8a8f98","anchorY":"bottom"}},{"id":9,"uid":"ea731db1-d7c0-