upId\":0,\"props\":{\"labelText\":\"Severity\",\"align\":\"Left\",\"fontName\":\"|16|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":8,\"uid\":\"11ae33f0-a481-465d-b6a1-5a27d46ae3eb\",\"type\":\"label\",\"x\":462,\"y\":6,\"w\":60,\"h\":16,\"groupId\":0,\"props\":{\"labelText\":\"Code\",\"align\":\"Left\",\"fontName\":\"|16|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":9,\"uid\":\"8c707ece-f226-4abd-b8ff-7d0148a66c17\",\"type\":\"panel\",\"x\":10,\"y\":26,\"w\":512,\"h\":1,\"groupId\":0,\"props\":{\"bgColor\":\"#8a8f98\",\"padding\":\"0\"}},{\"id\":10,\"uid\":\"46dda732-28d3-4e67-ac30-1a48297c786f\",\"type\":\"label\",\"x\":10,\"y\":34,\"w\":500,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Behaviour\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":11,\"uid\":\"f28616e8-d0ab-496e-a47f-6b0e557b5030\",\"type\":\"checkbox\",\"x\":10,\"y\":58,\"w\":22,\"h\":22,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.stuck\"}},{\"id\":12,\"uid\":\"310d8c12-7bd2-4d35-94aa-794d88710dae\",\"type\":\"label\",\"x\":40,\"y\":56,\"w\":194,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Detect Stuck\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":13,\"uid\":\"8fe12099-2076-4c27-8526-054fb38352f0\",\"type\":\"configedit\",\"x\":240,\"y\":56,\"w\":96,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].diag_stuck_ms\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.stuck] == 1\"}},{\"id\":14,\"uid\":\"ccc18bda-f536-42fb-a293-22a698cd8d76\",\"type\":\"enum\",\"x\":346,\"y\":56,\"w\":110,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.stuck\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.stuck] == 1\"}},{\"id\":15,\"uid\":\"60f9bfdb-8364-41bf-a0e5-e7fc1a69ada5\",\"type\":\"label\",\"x\":462,\"y\":60,\"w\":60,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"P11FC\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.stuck] == 1\"}},{\"id\":16,\"uid\":\"9e4f4560-a6a8-4db3-9cc9-6fd6e348e865\",\"type\":\"label\",\"x\":34,\"y\":81,\"w\":515,\"h\":16,\"groupId\":3,\"props\":{\"labelText\":\"The reading has not moved at all for this long \\u2014 a switch input that never changes.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":17,\"uid\":\"05bcb0fb-0512-4d6e-a431-734470000ffc\",\"type\":\"label\",\"x\":560,\"y\":38,\"w\":140,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"DTC Delay\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":18,\"uid\":\"b84612bd-571d-4d65-ab6b-c3478cb1af7c\",\"type\":\"configedit\",\"x\":706,\"y\":34,\"w\":123,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].diag_delay_ms\"}},{\"id\":19,\"uid\":\"fd6bcc63-a1db-42f4-a4c6-328e4d7e97f8\",\"type\":\"label\",\"x\":560,\"y\":68,\"w\":400,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"How long a check has to keep failing before it becomes a fault. A sensor that blips once on a starter crank is not a broken sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":20,\"uid\":\"081e9781-3179-4a02-bdee-d396ab2a4dbd\",\"type\":\"label\",\"x\":560,\"y\":110,\"w\":400,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Precondition\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":21,\"uid\":\"13277716-a17d-4a94-8b70-f3d7cf68d0ad\",\"type\":\"expression\",\"x\":560,\"y\":132,\"w\":400,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].precond_expr\"}},{\"id\":22,\"uid\":\"fe196439-2bb1-4e71-bff8-b79687e1de66\",\"type\":\"label\",\"x\":560,\"y\":164,\"w\":400,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"The plausibility checks only run while this holds \\u2014 an oil pressure of zero is a fault at 3000 rpm and the truth with the engine stopped.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":23,\"uid\":\"976c99ea-0a44-4de5-8e88-2b879d7f61ae\",\"type\":\"label\",\"x\":990,\"y\":34,\"w\":250,\"h\":170,\"groupId\":0,\"props\":{\"labelText\":\"The electrical pair tests the RAW input in the input's own units, before calibration; the plausibility pair tests the calibrated reading. Severity is what the DTC records and what the protection levels read. A check with no code is one this sensor cannot report, and is not offered \\u2014 which is why two sensors show different rows here.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[reverse_sw]"},"Configuration/Sensors/Transmission/Torque Converter Pressure":{"uid":"92e814b5-af42-4a08-a7c3-1ef9a1a82ac6","canvasWidth":1280,"canvasHeight":700,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Torque Converter Pressure","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"d52b2981-f1ac-49b1-a5c9-e22f5852f506","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"sensors.sensor[*].enabled"}},{"id":2,"uid":"5e02f20c-29da-46c5-972a-4f718bda8a30","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"a40eace8-ea1e-423c-a213-def8627906ff","type":"label","x":136,"y":4,"w":379,"h":24,"groupId":0,"props":{"labelText":"What this input is wired to, and what its curve makes of it.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"1756f881-da16-4984-a245-f435fdb23e5c","type":"panel","x":10,"y":30,"w":300,"h":662,"groupId":0,"props":{"labelText":"1 · Input","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":5,\"uid\":\"920cc5a7-eca6-4192-b714