sensors.sensor[*].flags.invert\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":13,\"uid\":\"6690316a-f543-426a-875d-06095c95a8e8\",\"type\":\"label\",\"x\":40,\"y\":249,\"w\":220,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Invert  (switch inputs)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":14,\"uid\":\"5e43d301-4a24-4e5f-9117-8536947e4812\",\"type\":\"label\",\"x\":10,\"y\":292,\"w\":274,\"h\":224,\"groupId\":0,\"props\":{\"labelText\":\"Interface says HOW the pin is read, and decides which inputs the picker offers \\u2014 a frequency sensor cannot be wired to an analogue pin. Two sensors on one pin is a fault, not a preference. A CAN sensor has no pin at all: it reads a field defined on the Receive page for its bus, named here by that frame and the field's start bit. A field whose own Signal is set is greyed in the list \\u2014 the frame writes that channel itself, and the sensor publishing it too would put two producers on one channel.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":15,"uid":"4472ee84-ae4e-49c9-b8f1-3bdebc492c9a","type":"panel","x":320,"y":30,"w":630,"h":662,"groupId":0,"props":{"labelText":"2 · Calibration","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":16,\"uid\":\"2273770c-f4d8-4ebe-b0f9-544170973f8a\",\"type\":\"table\",\"x\":10,\"y\":10,\"w\":600,\"h\":96,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"axisMode\":\"1\",\"displayUnit\":\"Auto\",\"displayUnitX\":\"Auto\",\"displayUnitY\":\"Auto\",\"cellTrace\":\"2\"}},{\"id\":17,\"uid\":\"ff77a5ba-6fb5-475d-8eef-9577dcbf091d\",\"type\":\"curve\",\"x\":10,\"y\":114,\"w\":600,\"h\":450,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"displayUnit\":\"Auto\",\"axisUnit\":\"Auto\",\"valueUnit\":\"Auto\"}},{\"id\":18,\"uid\":\"b7cb6a24-a9bb-477a-a55c-89a6f9f3446e\",\"