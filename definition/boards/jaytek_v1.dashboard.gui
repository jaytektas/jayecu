ops":{"labelText":"Scale and offset are a straight line from the engineering value to the actuator command, so two known points define them. The clamps are the ACTUATOR's limits rather than a control decision, and the failsafe is what is emitted when no candidate is valid — arbitration always emits something.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":90,"uid":"ef1b7d5f-f48b-4627-84bf-661f588bd96d","type":"panel","x":860,"y":358,"w":410,"h":92,"groupId":0,"props":{"labelText":"Right Now","layoutMode":"0","padding":"0","children":"[{\"id\":91,\"uid\":\"5b0a697b-8bac-4aef-ba19-29d1d106a34e\",\"type\":\"value\",\"x\":10,\"y\":12,\"w\":180,\"h\":40,\"groupId\":0,\"props\":{\"signalName\":\"[$*]\",\"format\":\"%.0f\",\"fontName\":\"|22|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"3\"}},{\"id\":92,\"uid\":\"1ff6942a-23a8-4535-bd39-ab14871327c2\",\"type\":\"label\",\"x\":200,\"y\":14,\"w\":200,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Commanded output\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":93,\"uid\":\"b02b7c29-13ba-4b4b-91ab-73476ae32af9\",\"type\":\"label\",\"x\":200,\"y\":38,\"w\":200,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Outputs  (every pin)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Electrical/Outputs\"}}]"}},{"id":94,"uid":"f4a81d77-b880-48d2-8101-3d9e9080c579","type":"panel","x":860,"y":458,"w":410,"h":256,"groupId":0,"props":{"labelText":"Bench Test","layoutMode":"0","padding":"0","children":"[{\"id\":95,\"uid\":\"0a38c2f8-3427-4abe-923f-909855037ceb\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":252,\"h\":20,\"groupId\":33,\"props\":{\"labelText\":\"Count\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":96,\"uid\":\"ddf0891c-cee8-4e19-b545-12f833967740\",\"type\":\"configedit\",\"x\":268,\"y\":12,\"w\":118,\"h\":30,\"groupId\":33,\"props\":{\"signalName\":\"pc.test_count\"}},{\"id\":97,\"uid\":\"2c3e517b-0365-4b9a-a945-d8214a3f4206\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":252,\"h\":20,\"groupId\":34,\"props\":{\"labelText\":\"On Time\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":98,\"uid\":\"0c1d9010-12ab-49bb-bc18-d202e41f3cb1\",\"type\":\"configedit\",\"x\":268,\"y\":42,\"w\":118,\"h\":30,\"groupId\":34,\"props\":{\"signalName\":\"pc.test_on_ms\"}},{\"id\":99,\"uid\":\"a312551a-9fb4-4403-a5ee-6cd2c823ce5e\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":252,\"h\":20,\"groupId\":35,\"props\":{\"labelText\":\"Off Time\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":100,\"uid\":\"45bd1df6-e8c7-46fa-9696-57c446413047\",\"type\":\"configedit\",\"x\":268,\"y\":72,\"w\":118,\"h\":30,\"groupId\":35,\"props\":{\"signalName\":\"pc.test_off_ms\"}},{\"id\":101,\"uid\":\"8d53d135-d21b-45bd-8ecd-720131a4889d\",\"type\":\"command\",\"x\":10,\"y\":110,\"w\":120,\"h\":30,\"groupId\":0,\"props\":{\"labelText\":\"Test\",\"command\":\"test 34\",\"arg0\":\"[#pc.test_count]\",\"arg1\":\"[#pc.test_on_ms]\",\"arg2\":\"[#pc.test_off_ms]\"}},{\"id\":102,\"uid\":\"d94ba65b-7ecc-4ab7-9d17-9ddba61a85b8\",\"type\":\"command\",\"x\":138,\"y\":110,\"w\":90,\"h\":30,\"groupId\":0,\"props\":{\"labelText\":\"Stop\",\"command\":\"test 34 0 0 0\"}},{\"id\":103,\"uid\":\"67f3acf2-1bcd-4d40-a217-db9b4f9c3c85\",\"type\":\"command\",\"x\":236,\"y\":110,\"w\":110,\"h\":30,\"groupId\":0,\"props\":{\"labelText\":\"Stop All\",\"command\":\"test 255 0 0 0\"}},{\"id\":104,\"uid\":\"0c755c9d-175b-4d5e-a9c2-2100a7b0a44a\",\"type\":\"label\",\"x\":10,\"y\":146,\"w\":390,\"h\":80,\"groupId\":0,\"props\":{\"labelText\":\"Engine stopped only; a start cancels it, and the ECU ends the test itself. What happens comes from the Function above \\u2014 a coil dwells then releases, an injector pulses, anything else is held on. On Time is used as given: mind the dwell on a coil.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"outputs.output[34]"},"Configuratio