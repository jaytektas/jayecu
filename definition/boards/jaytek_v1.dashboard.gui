ign\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":36,\"uid\":\"57d3532c-2824-47d7-b238-c733589181b5\",\"type\":\"configedit\",\"x\":250,\"y\":214,\"w\":170,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"engine_protection.protection_levels[0].rev_limit_rpm\",\"enableCondition\":\"[#engine_protection.protection_levels[0].enabled] == 1\"}},{\"id\":37,\"uid\":\"8536d5b2-24eb-4242-906e-793a2b87adda\",\"type\":\"configedit\",\"x\":460,\"y\":214,\"w\":170,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"engine_protection.protection_levels[1].rev_limit_rpm\",\"enableCondition\":\"[#engine_protection.protection_levels[1].enabled] == 1\"}},{\"id\":38,\"uid\":\"ff20024e-2473-47b8-9f8e-e78f15c26f92\",\"type\":\"configedit\",\"x\":670,\"y\":214,\"w\":170,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"engine_protection.protection_levels[2].rev_limit_rpm\",\"enableCondition\":\"[#engine_protection.protection_levels[2].enabled] == 1\"}},{\"id\":43,\"uid\":\"db8f7fb6-096d-43da-afd4-d4fa0934feec\",\"type\":\"label\",\"x\":10,\"y\":248,\"w\":230,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Auto Reset\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":44,\"uid\":\"48b30a7e-735c-464c-a3e9-d36ee73948bd\",\"type\":\"configedit\",\"x\":250,\"y\":244,\"w\":170,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"engine_protection.protection_levels[0].auto_reset_s\",\"enableCondition\":\"[#engine_protection.protection_levels[0].enabled] == 1\"}},{\"id\":45,\"uid\":\"82fab834-25bb-48fa-99d3-51f97e6010c1\",\"type\":\"configedit\",\"x\":460,\"y\":244,\"w\":170,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"engine_protection.protection_levels[1].auto_reset_s\",\"enableCondition\":\"[#engine_protection.protection_levels[1].enabled] == 1\"}},{\"id\":46,\"uid\":\"76822790-b692-4567-b069-3ff56c488621\",\"type\":\"configedit\",\"x\":670,\"y\":244,\"w\":170,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"engine_protection.protection_levels[2].auto_reset_s\",\"enableCondition\":\"[#engine_protection.protection_levels[2].enabled] == 1\"}}]"}},{"id":47,"uid":"9df4fe25-df40-4ae7-9101-8d6737a6fa7d","type":"panel","x":920,"y":30,"w":350,"h":336,"groupId":0,"props":{"labelText":"How A Level Works","layoutMode":"0","padding":"0","children":"[{\"id\":48,\"uid\":\"8fce39d7-d70a-49c6-a5ed-18fcbd749dc3\",\"type\":\"label\",\"x\":10,\"y\":10,\"w\":330,\"h\":296,\"groupId\":0,\"props\":{\"labelText\":\"A level is raised when its DTC condition is met \\u2014 CURRENT means the fault is happening now, STORED means it happened and has not been cleared. While it holds, every response in its column is applied at once: the mixture is enriched, timing is pulled, boost is trimmed and the rev limit drops.\\n\\nThe levels are meant to escalate: level 1 is what you can drive home on, level 3 is what stops the engine being damaged. Auto Reset is how long after the condition clears before the level lets go \\u2014 0 holds it until the fault is cleared by hand.\\n\\nA level with no responses set does nothing at all, whatever raises it.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":49,"uid":"8ba1c2e0-769c-4cfb-a1fd-1b5fd446c1ad","type":"panel","x":920,"y":376,"w":350,"h":316,"groupId":0,"props":{"labelText":"Right Now","layoutMode":"0","padding":"0","children":"[{\"id\":50,\"uid\":\"6759e980-2652-4a7d-ad39-b8a1f5ebe109\",\"type\":\"value\",\"x\":15,\"y\":14,\"w\":100,\"h\":30,\"groupId\":2,\"props\":{\"signalName\":\"[$prot_status]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":51,\"uid\":\"67d39023-f432-4ef3-b1e8-bc5819b9f3ef\",\"type\":\"label\",\"x\":15,\"y\":44,\"w\":100,\"h\":20,\"groupId\":2,\"props\":{\"labelText\":\"Status Bits\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":52,\"uid\":\"7f885ac4-b130-4c78-bb86-45bed58b998e\",\"type\":\"value\",\"x\":125,\"y\":14,\"w\":100,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"[$prot_ign_retard]\",\"format\":\"%.1f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":53,\"uid\":\"a078b67b-5ab2-423a-826e-fd3381324cc1\",\"type\":\"label\",\"x\":125,\"y\":44,\"w\":100,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Retard\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":54,\"uid\":\"e9e1d83b-ee3d-46c2-87d7-22df2ad92f99\",\"type\":\"value\",\"x\":235,\"y\":14,\"w\":100,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"[$prot_rev_limit]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":55,\"uid\":\"2810b75a-ef70-4a4f-a6ec-42c44b1d6c29\",\"type\":\"label\",\"x\":235,\"y\":44,\"w\":100,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Rev Limit\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":56,\"uid\":\"336b887d-5e19-4f1b-83fb-a1f25f64c084\",\"type\":\"label\",\"x\":15,\"y\":76,\"w\":320,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Engine Protection\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Protection/Engine Protection\"}}]"}}]},"Configuration/Protection/Engine Protection/Threshold Monitors":{"uid":"98b144d5-4df2-4781-9d7d-9c8fc1152caf","canvasWidth":1280,"canvasHeight":538,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Threshold Monitors","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"800d596a-0469-4611-9770-8bddad70dbfe","type":"label","x":10,"y":4,"w":990,"h":40,"groupId":0,"props":{"labelText":"Eight slots, written condition first — a slot with no condition watches nothing, so its action stays inert until one is typed. Each watches a CONDITION you write — any bus channel, any config setting, combined however the question needs — and acts while it holds. This is how you protect against something the built-in checks do not cover.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"409e6b46-6fbc-4062-8b19-4edce903ac42","type":"panel","x":10,"y":46,"w":900,"h":482,"groupId":0,"props":{"labelText":"Monitors","layoutMode":"0","padding":"0","children":"[{\"id\":3,\"uid\":\"f27dc1ea-e40b-4708-8bc3-b26c56331d6c\",\"type\":\"label\",\"x\":10,\"y\":8,\"w\":40,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"#\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":4,\"uid\":\"24d39506-dbc2-47f2-9b06-a548d2d46157\",\"type\":\"label\",\"x\":56,\"y\":8,\"w\":560,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Condition\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":5,\"uid\":\"00cd9713-9f1c-49ea-8839-6f39b629b472\",\"type\":\"label\",\"x\":626,\"y\":8,\"w\":200,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Action\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":6,\"uid\":\"52c1a95a-d770-49c3-8dc1-f5d8d8fd0c4a\",\"type\":\"label\",\"x\":836,\"y\":8,\"w\":50,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Trip\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":7,\"uid\":\"614771a6-c04b-4d22-8301-58a5c0850a20\",\"type\":\"panel\",\"x\":10,\"y\":28,\"w\":870,\"h\":1,\"groupId\":0,\"props\":{\"bgColor\":\"#8a8f98\",\"padding\":\"0\"}},{\"id\":8,\"uid\":\"c0a8a012-1f71-404a-b598-163942fd5661\",\"type\":\"label\",\"x\":10,\"y\":42,\"w\":40,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"1\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":9,\"uid\":\"5b638b15-1351-43ad-92bb-02f62ff95566\",\"type\":\"expression\",\"x\":56,\"y\":38,\"w\":560,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"engine_protection.threshold_monitors[0].condition\"}},{\"id\":10,\"uid\":\"f4306832-31be-40d5-b084-9f1167ac9140\",\"type\":\"combobox\",\"x\":626,\"y\":40,\"w\":200,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"engine_protection.thr