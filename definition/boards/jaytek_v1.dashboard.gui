,\"props\":{\"labelText\":\"P2128\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_max] == 1\"}},{\"id\":22,\"uid\":\"3260ff13-cb40-4b30-86de-24df0c28f11a\",\"type\":\"label\",\"x\":34,\"y\":127,\"w\":515,\"h\":16,\"groupId\":4,\"props\":{\"labelText\":\"The pin reads above this \\u2014 a short to power, or a missing pull-down.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"92383409-f6a8-44ea-8098-ff765b6eeaac\",\"type\":\"label\",\"x\":10,\"y\":148,\"w\":500,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Plausibility  (calibrated reading)\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":24,\"uid\":\"389a9683-8cbd-41a0-95d0-5fbe66e4d9d2\",\"type\":\"checkbox\",\"x\":10,\"y\":172,\"w\":22,\"h\":22,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.op_min\"}},{\"id\":25,\"uid\":\"542118ca-595a-41bc-8ca8-0c1893388a0d\",\"type\":\"label\",\"x\":40,\"y\":170,\"w\":194,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Detect Reading Low\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":26,\"uid\":\"0d93d53f-c28e-4922-b9e2-2036045396b0\",\"type\":\"configedit\",\"x\":240,\"y\":170,\"w\":96,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_op_min\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":27,\"uid\":\"d6e0c0be-e958-4de9-a9ca-d016cd3267f3\",\"type\":\"enum\",\"x\":346,\"y\":170,\"w\":110,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.op_min\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":28,\"uid\":\"e7d3fb79-0eb4-4b2c-a287-de10b322d584\",\"type\":\"label\",\"x\":462,\"y\":174,\"w\":60,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"P109A\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":29,\"uid\":\"d20d41bd-6692-4c04-9372-a1b948f81141\",\"type\":\"label\",\"x\":34,\"y\":195,\"w\":515,\"h\":16,\"groupId\":5,\"props\":{\"labelText\":\"The calibrated reading is below what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":30,\"uid\":\"d172e08d-2864-4ae9-89cb-a4b23c21f60f\",\"type\":\"checkbox\",\"x\":10,\"y\":218,\"w\":22,\"h\":22,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.op_max\"}},{\"id\":31,\"uid\":\"2296ee4a-5bc9-4333-9c8f-0fa4450639c1\",\"type\":\"label\",\"x\":40,\"y\":216,\"w\":194,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Detect Reading High\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":32,\"uid\":\"84e13496-7fee-4d75-a8e9-e115a0b7918f\",\"type\":\"configedit\",\"x\":240,\"y\":216,\"w\":96,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_op_max\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":33,\"uid\":\"c4c0ba6b-fb1d-4b1f-92fb-6900dbc4336a\",\"type\":\"enum\",\"x\":346,\"y\":216,\"w\":110,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.op_max\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":34,\"uid\":\"bd9e95ae-92bf-4444-b9f8-8da636e8170c\",\"type\":\"label\",\"x\":462,\"y\":220,\"w\":60,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"P109B\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":35,\"uid\":\"ed5a864f-3197-471a-9e6c-e5903005ab7b\",\"type\":\"label\",\"x\":34,\"y\":241,\"w\":515,\"h\":16,\"groupId\":6,\"props\":{\"labelText\":\"The calibrated reading is above what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":36,\"uid\":\"b0ffd517-5982-491a-ac9f-77fd06f44c17\",\"type\":\"label\",\"x\":560,\"y\":38,\"w\":140,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"DTC Delay\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":37,\"uid\":\"154185a7-b45e-4820-b6ac-35ab418a84c8\",\"type\":\"configedit\",\"x\":706,\"y\":34,\"w\":123,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"sensors.sensor[*].diag_delay_ms\"}},{\"id\":38,\"uid\":\"38fa618a-912e-428d-b22a-5e5a165025aa\",\"type\":\"label\",\"x\":560,\"y\":68,\"w\":400,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"How long a check has to keep failing before it becomes a fault. A sensor that blips once on a starter crank is not a broken sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":39,\"uid\":\"ab05785f-71a0-4da3-b9af-208369fa9d7d\",\"type\":\"label\",\"x\":560,\"y\":110,\"w\":400,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Precondition\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":40,\"uid\":\"5b4c53e0-4c33-4ae1-a5b3-a87c04474af5\",\"type\":\"expression\",\"x\":560,\"y\":132,\"w\":400,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].precond_expr\"}},{\"id\":41,\"uid\":\"59e1a70b-95e4-4d5c-a6b3-8a9a72f8a727\",\"type\":\"label\",\"x\":560,\"y\":164,\"w\":400,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"The plausibility checks only run while this holds \\u2014 an oil pressure of zero is a fault at 3000 rpm and the truth with the engine stopped.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":42,\"uid\":\"afbc2c44-3799-45ef-977c-39948ddc6bba\",\"type\":\"label\",\"x\":990,\"y\":34,\"w\":250,\"h\":170,\"groupId\":0,\"props\":{\"labelText\":\"The electrical pair tests the RAW input in the input's own units, before calibration; the plausibility pair tests the calibrated reading. Severity is what the DTC records and what the protection levels read. A check with no code is one this sensor cannot report, and is not offered \\u2014 which is why two sensors show different rows here.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[app_2]"},"Configuration/Sensors/Engine/Air Temperature":{"uid":"e5904818-41ec-4f9c-9b77-43c62645f995","canvasWidth":1280,"canvasHeight":700,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Air Temperature","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"d034e6f3-5464-450b-bfc9-34bf88310ee1","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"sensors.sensor[*].enabled"}},{"id":2,"uid":"192a3bfc-39bc-4707-9bfe-adbaf43e61a2","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"87d203ac-acfe-4a1c-892e-cbbeb0d0c013","type":"label","x":136,"y":4,"w":379,"h":24,"groupId":0,"props":{"labelText":"What this input is wired to, and what its curve makes of it.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"2f0057dd-718d-4c57-8f31-0c34d9003bd2","type":"panel","x":10,"y":30,"w":300,"h":662,"groupId":0,"props":{"labelText":"1 · Input","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":5,\"uid\":\"a08f4d3c-da06-4bea-a4fa-3b11975e425e\",\"type\":\"value\",\"x\":12,\"y\":10,\"w\":274,\"h\":54,\"groupId\":0,\"props\":{\"signalName\":\"[$~]\",\"fontName\":\"|26|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"4\"}},{\"id\":6,\"uid\":\"6bcd8c32-f1f1-4d80-aada-117a97023fff\",\"type\":\"label\",\"x\":12,\"y\":66,\"w\":274,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Raw input  (as the pin reads it)\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":7,\"uid\":\"3685ac8e-7808-4726-852f-fcd1a9e700ca\",\"type\":\"label\",\"x\":10,\"y\":100,\"w\":90,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Interface\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":8,\"uid\":\"9b57efec-9392-444b-a8d9-274b967cee13\",\"type\":\"combobox\",\"x\":106,\"y\":96,\"w\":150,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].interface\"}},{\"id\":9,\"uid\":\"679487ee-9ed7-4f1d-949f-86a280ce36c9\",\"type\":\"wiring\",\"x\":10,\"y\":132,\"w\":274,\"h\":76,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].source\",\"condition\":\"[#sensors.sensor[*].interface] == 0 || [#sensors.sensor[*].interface] == 1 || [#sensors.sensor[*].interface] == 3 || [#sensors.sensor[*].interface] == 4 || [#sensors.sensor[*].interface] == 6 || [#sensors.sensor[*].interface] == 7\"}},{\"id\":10,\"uid\":\"5fd3a212-4af8-4dd0-b4e6-b05ed166563e\",\"type\":\"label\",\"x\":10,\"y\":220,\"w\":90,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"CAN Field\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 5\"}},{\"id\":11,\"uid\":\"b3fa7cb4-fd39-4703-8150-0b68160a3fee\",\"type\":\"canfield\",\"x\":106,\"y\":216,\"w\":170,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].can_frame\",\"condition\":\"[#sensors.sensor[*].interface] == 5\"}},{\"id\":12,\"uid\":\"11816fd7-567f-4b15-ab8e-80144e7b0cb1\",\"type\":\"checkbox\",\"x\":10,\"y\":252,\"w\":22,\"h\":22,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].flags.invert\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":13,\"uid\":\"ed81f557-9e53-4560-86ea-c115c9f27ea9\",\"type\":\"label\",\"x\":40,\"y\":249,\"w\":220,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Invert  (switch inputs)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":14,\"uid\":\"279becae-7902-4612-9a27-3d0a8fbdbbbf\",\"type\":\"label\",\"x\":10,\"y\":292,\"w\":274,\"h\":224,\"groupId\":0,\"props\":{\"labelText\":\"Interface says HOW the pin is read, and decides which inputs the picker offers \\u2014 a frequency sensor cannot be wired to an analogue pin. Two sensors on one pin is a fault, not a preference. A CAN sensor has no pin at all: it reads a field defined on the Receive page for its bus, named here by that frame and the field's start bit. A field whose own Signal is set is greyed in the list \\u2014 the frame writes that channel itself, and the sensor publishing it too would put two producers on one channel.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":15,"uid":"e76b3435-96ce-4e09-b5b2-c2fefa7da7e3","type":"panel","x":320,"y":30,"w":630,"h":662,"groupId":0,"props":{"labelText":"2 · Calibration","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":16,\"uid\":\"683aa615-7f4a-4daf-a005-d1b4e2fc71a8\",\"type\":\"table\",\"x\":10,\"y\":10,\"w\":600,\"h\":96,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"axisMode\":\"1\",\"displayUnit\":\"Auto\",\"displayUnitX\":\"Auto\",\"displayUnitY\":\"Auto\",\"cellTrace\":\"2\"}},{\"id\":17,\"uid\":\"ee603870-3657-4710-b9b4-70263bde037d\",\"type\":\"curve\",\"x\":10,\"y\":114,\"w\":600,\"h\":450,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"displayUnit\":\"Auto\",\"axisUnit\":\"Auto\",\"valueUnit\":\"Auto\"}},{\"id\":18,\"uid\":\"77da11b4-7d09-4f94-9471-4f1aed65f513\",\"type\":\"label\",\"x\":10,\"y\":568,\"w\":600,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"Raw in along the top, reading out underneath. Right-click either for insert, delete, linearise \\u2014 or to save this curve to a file and load it into the next car with the same sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\",\"signalName\":\"sensors.sensor[*].cal\"}},{\"id\":19,\"uid\":\"cd91705b-df0c-4b92-a7f4-e418cd759643\",\"type\":\"bands\",\"x\":10,\"y\":10,\"w\":600,\"h\":616,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\"}}]"}},{"id":20,"uid":"af2af60d-570b-4ed5-a925-8ccf75e847cd","type":"panel","x":960,"y":30,"w":310,"h":662,"groupId":0,"props":{"labelText":"3 · Output","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":21,\"uid\":\"a9d2eeae-39f7-4082-8ea2-0a0c0c5ad683\",\"type\":\"value\",\"x\":12,\"y\":10,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"signalName\":\"[$*]\",\"format\":\"%.2f\",\"fontName\":\"|30|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"4\"}},{\"id\":22,\"uid\":\"d4c571e6-1193-49ba-a75e-97c34354510d\",\"type\":\"label\",\"x\":12,\"y\":74,\"w\":284,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Reading  (what everything downstream sees)\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"943049d1-d82b-40af-afb4-557acee89bdd\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":90,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Type\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":24,\"uid\":\"f444191e-0883-47c9-a0da-ea0c108285dc\",\"type\":\"label\",\"x\":106,\"y\":106,\"w\":190,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Temperature\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":25,\"uid\":\"950e269d-ec6f-47be-a530-25bf50d0412b\",\"type\":\"label\",\"x\":10,\"y\":142,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"This input's type is fixed by the ECU \\u2014 it is what the sensor IS. Only the generic inputs (aux, rotary trim) can be re-typed.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":26,\"uid\":\"96ddc6f4-0ba5-49c5-88e1-59e3bfe85311\",\"type\":\"label\",\"x\":10,\"y\":214,\"w\":284,\"h\":98,\"groupId\":0,\"props\":{\"labelText\":\"Input and output are both on screen because a calibration is a claim about how one becomes the ot