to fire\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#engine.cylinder_count] > 10\"}},{\"id\":64,\"uid\":\"2fb71452-4c63-4ba5-b90e-6c7e1604a46f\",\"type\":\"configedit\",\"x\":104,\"y\":334,\"w\":80,\"h\":30,\"groupId\":17,\"props\":{\"signalName\":\"engine.firing_order[10].cyl\",\"condition\":\"[#engine.cylinder_count] > 10\",\"ranges\":\"#ff453a,,,,0,[$firing_order_fault]\"}},{\"id\":65,\"uid\":\"1bcbd8f4-9238-482c-a515-0f4438a714ca\",\"type\":\"configedit\",\"x\":194,\"y\":334,\"w\":70,\"h\":30,\"groupId\":17,\"props\":{\"signalName\":\"engine.cyl[@engine.firing_order[10].cyl - 1].bank\",\"condition\":\"[#engine.cylinder_count] > 10\"}},{\"id\":66,\"uid\":\"08d0f356-3859-406a-88bd-dcf128394831\",\"type\":\"configedit\",\"x\":272,\"y\":334,\"w\":110,\"h\":30,\"groupId\":17,\"props\":{\"signalName\":\"engine.cyl[@engine.firing_order[10].cyl - 1].tdc_angle\",\"condition\":\"[#engine.cylinder_count] > 10\"}},{\"id\":67,\"uid\":\"fc5f82aa-61af-4efc-a12b-c847654190ad\",\"type\":\"label\",\"x\":10,\"y\":368,\"w\":90,\"h\":20,\"groupId\":18,\"props\":{\"labelText\":\"12th to fire\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#engine.cylinder_count] > 11\"}},{\"id\":68,\"uid\":\"fed4849d-0c3c-4ef0-bcc8-40e0c6b24722\",\"type\":\"configedit\",\"x\":104,\"y\":364,\"w\":80,\"h\":30,\"groupId\":18,\"props\":{\"signalName\":\"engine.firing_order[11].cyl\",\"condition\":\"[#engine.cylinder_count] > 11\",\"ranges\":\"#ff453a,,,,0,[$firing_order_fault]\"}},{\"id\":69,\"uid\":\"0acc759a-7029-4156-9f3c-da728e3b51ca\",\"type\":\"configedit\",\"x\":194,\"y\":364,\"w\":70,\"h\":30,\"groupId\":18,\"props\":{\"signalName\":\"engine.cyl[@engine.firing_order[11].cyl - 1].bank\",\"condition\":\"[#engine.cylinder_count] > 11\"}},{\"id\":70,\"uid\":\"e86505a7-032c-4be7-874d-5938fb9b9194\",\"type\":\"configedit\",\"x\":272,\"y\":364,\"w\":110,\"h\":30,\"groupId\":18,\"props\":{\"signalName\":\"engine.cyl[@engine.firing_order[11].cyl - 1].tdc_angle\",\"condition\":\"[#engine.cylinder_count] > 11\"}}]"}},{"id":71,"uid":"e3e0d7f3-079b-44ca-91c2-0a81265b0324","type":"panel","x":10,"y":428,"w":380,"h":216,"groupId":0,"props":{"labelText":"Right Now","layoutMode":"0","padding":"0","children":"[{\"id\":72,\"uid\":\"0600a61c-678b-4af5-9fcc-16d33bbe1d30\",\"type\":\"value\",\"x\":15,\"y\":14,\"w\":110,\"h\":30,\"groupId\":19,\"props\":{\"signalName\":\"[$rpm]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":73,\"uid\":\"e2e9691f-bb25-4c68-938d-32dba726a59e\",\"type\":\"label\",\"x\":15,\"y\":44,\"w\":110,\"h\":20,\"groupId\":19,\"props\":{\"labelText\":\"Engine RPM\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":74,\"uid\":\"b8a9a636-48ae-4d67-9af3-5e40cc4c0968\",\"type\":\"value\",\"x\":130,\"y\":14,\"w\":120,\"h\":30,\"groupId\":20,\"props\":{\"signalName\":\"[$crank_angle]\",\"format\":\"%.1f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":75,\"uid\":\"53a767f1-e2d0-4ad1-9bba-623317ab27e5\",\"type\":\"label\",\"x\":130,\"y\":44,\"w\":120,\"h\":20,\"groupId\":20,\"props\":{\"labelText\":\"Crank Angle\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":76,\"uid\":\"05ffded7-96e2-47d3-9b6b-db51fa085723\",\"type\":\"indicator\",\"x\":255,\"y\":14,\"w\":105,\"h\":44,\"groupId\":0,\"props\":{\"signalName\":\"[$sync_level] >= 1\",\"onTitle\":\"SYNC\",\"offTitle\":\"NO SYNC\",\"onBg\":\"#30d158\",\"onFg\":\"#000000\",\"offBg\":\"#2a2a2e\",\"offFg\":\"#6e7178\",\"fontName\":\"|15|0|0\"}},{\"id\":77,\"uid\":\"453d381a-9e0e-4ac5-92cb-38a92daeb1f9\",\"type\":\"indicator\",\"x\":255,\"y\":62,\"w\":105,\"h\":40,\"groupId\":0,\"props\":{\"signalName\":\"[$firing_order_fault]\",\"onTitle\":\"ORDER BAD\",\"offTitle\":\"ORDER OK\",\"onBg\":\"#ff453a\",\"onFg\":\"#000000\",\"offBg\":\"#1e3a24\",\"offFg\":\"#8a8f98\",\"fontName\":\"|15|0|0\"}},{\"id\":78,\"uid\":\"c6102ca7-af5a-4fbd-9ef4-96b8a3a47615\",\"type\":\"label\",\"x\":15,\"y\":108,\"w\":350,\"h\":80,\"groupId\":0,\"props\":{\"labelText\":\"Crank angle is measured from the trigger reference: with no sync there is no reference, and the TDC angles are just numbers. ORDER BAD means the ECU cannot use the order beside it \\u2014 a cylinder listed twice, or one missing.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":79,"uid":"6c41e8bd-ce88-4b04-8601-913b67ca427d","type":"panel","x":930,"y":30,"w":340,"h":332,"groupId":0,"props":{"labelText":"What These Are For","layoutMode":"0","padding":"0","children":"[{\"id\":80,\"uid\":\"b76729c5-422a-4ba5-94d9-5154dba8aeb5\",\"type\":\"label\",\"x\":10,\"y\":10,\"w\":320,\"h\":296,\"groupId\":0,\"props\":{\"labelText\":\"FIRING ORDER is the sequence, not the wiring: the 3rd row is whichever cylinder fires third, and the ignition and injection outputs are bound to cylinder NUMBER, so changing the order re-times the engine without rewiring it.\\n\\nBANK groups cylinders that share an exhaust side \\u2014 which wideband trims them, and which bank a per-bank correction applies to.\\n\\nTDC ANGLE is where that cylinder reaches top dead centre within the cycle, measured from the reference the trigger defines. An evenly-fired engine is the cycle divided by the cylinder count: 720/6 = 120\\u00b0 apart on a six. Odd-fire engines are not, which is what the Odd-Fire switch is about.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":81,"uid":"11c51e3d-60eb-456f-ae04-c81723042867","type":"panel","x":930,"y":372,"w":340,"h":128,"groupId":0,"props":{"labelText":"Reads This","layoutMode":"0","padding":"0","children":"[{\"id\":82,\"uid\":\"7c5429b6-8550-4dbb-a370-6faceb446129\",\"type\":\"label\",\"x\":10,\"y\":10,\"w\":296,\"h\":20,\"groupId\":21,\"props\":{\"labelText\":\"Ignition \\u00b7 Cylinder Trims\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Ignition Tuning/Cylinder Trims\"}},{\"id\":83,\"uid\":\"6e83269a-9bf5-41ff-b829-7d5273864da4\",\"type\":\"label\",\"x\":10,\"y\":38,\"w\":296,\"h\":20,\"groupId\":22,\"props\":{\"labelText\":\"Fuel \\u00b7 Corrections\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Fuel Tuning/Corrections\"}},{\"id\":84,\"uid\":\"66a0bc25-b704-479f-b0f0-ed90e956f138\",\"type\":\"label\",\"x\":10,\"y\":66,\"w\":296,\"h\":20,\"groupId\":23,\"props\":{\"labelText\":\"Trigger System\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Engine Configuration/Trigger System\"}}]"}}]},"Configuration/Engine Configuration/Fuel System":{"uid":"92ca70b0-9674-401f-bb5a-a86a842156ca","canvasWidth":1280,"canvasHeight":700,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Fuel System","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"51edff12-a397-4c6b-ad0e-989e05d8223a","type":"label","x":10,"y":4,"w":990,"h":24,"groupId":0,"props":{"labelText":"How fuel is DELIVERED: how many injection stages this engine has, how each one is driven and how many outputs it uses. What each stage squirts is Fuel Tuning.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"8681887c-6741-416a-a1a1-aebcec546b79","type":"panel","x":10,"y":30,"w":430,"h":188,"groupId":0,"props":{"labelText":"Injection System","layoutMode":"0","padding":"0","children":"[{\"id\":3,\"uid\":\"4793ecbf-eff9-4ae7-a917-9b4e84994976\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":190,\"h\":20,\"groupId\":2,\"props\":{\"labelText\":\"Injection Stages\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":4,\"uid\":\"9bf9e647-6e94-4e54-9580-a0b2f49274bd\",\"type\":\"configedit\",\"x\":206,\"y\":12,\"w\":80,\"h\":30,\"groupId\":2,\"props\":{\"signalName\":\"engine.num_inj_stages\"}},{\"id\":5,\"uid\":\"a320d647-3ffd-423e-b773-3b5b207a8030\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":190,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Injector Timing\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":6,\"uid\":\"c7ba20b9-711f-4b10-8fd1-f52ae4dfefda\",\"type\":\"combobox\",\"x\":206,\"y\":42,\"w\":190,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"engine.injector_timing_method\"}},{\"id\":7,\"uid\":\"a5635b63-f4ff-43f7-a0a5-3cf44c3786be\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":190,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Cylinders\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":8,\"uid\":\"045a8049-b324-4d77-a802-ecf43ddef360\",\"type\":\"configedit\",\"x\":206,\"y\":72,\"w\":80,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"engine.cylinder_count\"}},{\"id\":9,\"uid\":\"0d5f747c-cfa4-45de-ad44-f6124cd328e1\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":190,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Injector Outputs\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":10,\"uid\":\"49042661-0270-4256-865b-67d6803ab7ad\",\"type\":\"combobox\",\"x\":206,\"y\":102,\"w\":110,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"engine.inj_enable\"}},{\"id\":11,\"uid\":\"8ae75d8a-f376-4a5e-9c65-ebbe139c8008\",\"type\":\"label\",\"x\":10,\"y\":132,\"w\":410,\"h\":26,\"groupId\":0,\"props\":{\"labelText\":\"OFF \\u2014 no injector will open, and this survives a reset.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#d08770\",\"wrap\":\"1\",\"condition\":\"[#engine.inj_enable] == 0\"}}]"}},{"id":12,"uid":"d9edde5f-df5c-4451-9dc0-f036332ca8f0","type":"label","x":10,"y":226,"w":420,"h":120,"groupId":0,"props":{"labelText":"Injector timing says whether the angle in the tables is the END of the squirt or the START of it — the same number means two different things, and the fuel lands in the wrong place if it is set the wrong way. Changing the stages, a stage's mode or its outputs lays the injector outputs out again (LS1 = cylinder 1 and so on); each LS pin's own page under Electrical/Outputs shows its cylinder, stage and polarity.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":13,"uid":"675193d9-970b-4b7c-8fdd-087d0368149a","type":"panel","x":450,"y":30,"w":560,"h":218,"groupId":0,"props":{"labelText":"Stages","layoutMode":"0","padding":"0","children":"[{\"id\":14,\"uid\":\"8c8263f8-5f42-4a2f-b6d0-079cd5091b32\",\"type\":\"label\",\"x\":10,\"y\":8,\"w\":100,\"h\":16,\"groupId\":0,\"props\":{\"labelText\":\"Stage\",\"align\":\"Left\",\"fontName\":\"|16|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":15,\"uid\":\"9c5abbdb-7479-439d-a8dd-a5d5019bd1e5\",\"type\":\"label\",\"x\":114,\"y\":8,\"w\":90,\"h\":16,\"groupId\":0,\"props\":{\"labelText\":\"Outputs\",\"align\":\"Left\",\"fontName\":\"|16|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":16,\"uid\":\"79f9af07-1678-4dea-a536-1149b51f9bda\",\"type\":\"label\",\"x\":212,\"y\":8,\"w\":170,\"h\":16,\"groupId\":0,\"props\":{\"labelText\":\"Mode\",\"align\":\"Left\",\"fontName\":\"|16|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":17,\"uid\":\"5c962a5f-f713-4493-a15e-147355d4fecf\",\"type\":\"label\",\"x\":390,\"y\":8,\"w\":120,\"h\":16,\"groupId\":0,\"props\":{\"labelText\":\"Per Cycle\",\"align\":\"Left\",\"fontName\":\"|16|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":18,\"uid\":\"030957b7-bd63-4518-b9f9-11608cd3b3ad\",\"type\":\"panel\",\"x\":10,\"y\":28,\"w\":520,\"h\":1,\"groupId\":0,\"props\":{\"bgColor\":\"#8a8f98\",\"padding\":\"0\"}},{\"id\":19,\"uid\":\"57e0e340-aa93-4d57-94f0-d2a893350b63\",\"type\":\"label\",\"x\":10,\"y\":38,\"w\":100,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Stage 1\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Fuel Tuning/Stage 1/Setup\",\"enableCondition\":\"([#engine.num_inj_stages] > 0) && ([#engine.inj_stage[0].mode] == 2 || [#engine.inj_stage[0].mode] == 3)\"}},{\"id\":20,\"uid\":\"02266e79-b8bc-4f2c-9b49-d81d595abe9b\",\"type\":\"configedit\",\"x\":114,\"y\":34,\"w\":80,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"engine.inj_stage[0].num_outputs\",\"enableCondition\":\"([#engine.num_inj_stages] > 0) && ([#engine.inj_stage[0].mode] == 2 || [#engine.inj_stage[0].mode] == 3)\"}},{\"id\":21,\"uid\":\"796f6a2d-f2d7-4dd2-ac6b-fa768a63979b\",\"type\":\"combobox\",\"x\":212,\"y\":34,\"w\":170,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"engine.inj_stage[0].mode\",\"enableCondition\":\"[#engine.num_inj_stages] > 0\"}},{\"id\":22,\"uid\":\"2aa07548-8e33-44b9-a274-b8c46b8f0cc5\",\"type\":\"configedit\",\"x\":390,\"y\":34,\"w\":80,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"engine.inj_stage[0].injections_per_cycle\",\"enableCondition\":\"[#engine.num_inj_stages] > 0\"}},{\"id\":23,\"uid\":\"674a6da5-f08f-455e-853a-34884f3472c9\",\"type\":\"label\",\"x\":10,\"y\":68,\"w\":100,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"Stage 2\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Fuel Tuning/Stage 2/Setup\",\"enableCondition\":\"([#engine.num_inj_stages] > 1) && ([#engine.inj_stage[1].mode] == 2 || [#engine.inj_stage[1].mode] == 3)\"}},{\"id\":24,\"uid\":\"38f57e19-f36a-4b6e-a8da-200e8e8e84f8\",\"type\":\"configedit\",\"x\":114,\"y\":64,\"w\":80,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"engine.inj_stage[1].num_outputs\",\"enableCondition\":\"([#engine.num_inj_stages] > 1) && ([#engine.inj_stage[1].mode] == 2 || [#engine.inj_stage[1].mode] == 3)\"}},{\"id\":25,\"uid\":\"2f43d99d-11a4-4c9b-87c0-0031c7e1d7a2\",\"type\":\"combobox\",\"x\":212,\"y\":64,\"w\":170,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"engine.inj_stage[1].mode\",\"enableCondition\":\"[#engine.num_inj_stages] > 1\"}},{\"id\":26,\"uid\":\"5b680c44-fbf4-4156-a199-bf6029384ebc\",\"type\":\"configedit\",\"x\":390,\"y\":64,\"w\":80,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"engine.inj_stage[1].injections_per_cycle\",\"enableCondition\":\"[#engine.num_inj_stages] > 1\"}},{\"id\":27,\"uid\":\"a75f4b85-a933-4cd4-b8fa-078e84daded6\",\"type\":\"label\",\"x\":10,\"y\":98,\"w\":100,\"h\":20,\"groupId\":8,\"props\":{\"labelText\":\"Stage 3\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Fuel Tuning/Stage 3/Setup\",\"enableCondition\":\"([#engine.num_inj_stages] > 2) && ([#engine.inj_stage[2].mode] == 2 || [#engine.inj_stage[2].mode] == 3)\"}},{\"id\":28,\"uid\":\"b2a1413d-6435-442c-9179-e05f70b40b95\",\"type\":\"configedit\",\"x\":114,\"y\":94,\"w\":80,\"h\":30,\"groupId\":8,\"props\":{\"signalName\":\"engine.inj_stage[2].num_outputs\",\"enableCondition\":\"([#engine.num_inj_stages] > 2) && ([#engine.inj_stage[2].mode] == 2 || [#engine.inj_stage[2].mode] == 3)\"}},{\"id\":29,\"uid\":\"60bea014-627e-47a3-beb7-17caf7bbfc88\",\"type\":\"combobox\",\"x\":212,\"y\":94,\"w\":170,\"h\":30,\"groupId\":8,\"props\":{\"signalName\":\"engine.inj_stage[2].mode\",\"enableCondition\":\"[#engine.num_inj_stages] > 2\"}},{\"id\":30,\"uid\":\"ec991e95-d36f-4ada-9ddc-7ac587daf04b\",\"type\":\"configedit\",\"x\":390,\"y\":94,\"w\":80,\"h\":30,\"groupId\":8,\"props\":{\"signalName\":\"engine.inj_stage[2].injections_per_cycle\",\"enableCondition\":\"[#engine.num_inj_stages] > 2\"}},{\"id\":31,\"uid\":\"2e25045b-0142-4d0c-b583-8969b097a7ae\",\"type\":\"label\",\"x\":10,\"y\":128,\"w\":100,\"h\":20,\"groupId\":9,\"props\":{\"labelText\":\"Stage 4\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Fuel Tuning/Stage 4/Setup\",\"enableCondition\":\"([#engine.num_inj_stages] > 3) && ([#engine.inj_stage[3].mode] == 2 || [#engine.inj_stage[3].mode] == 3)\"}},{\"id\":32,\"uid\":\"82e013f9-ad51-4820-93cd-b08984c22ac1\",\"type\":\"configedit\",\"x\":114,\"y\":124,\"w\":80,\"h\":30,\"groupId\":9,\"props\":{\"signalName\":\"engine.inj_stage[3].num_outputs\",\"enableCondition\":\"([#engine.num_inj_stages] > 3) && ([#engine.inj_stage[3].mode] == 2 || [#engine.inj_stage[3].mode] == 3)\"}},{\"id\":33,\"uid\":\"9b730d61-0706-42f9-a3f0-3b38ba208cd6\",\"type\":\"combobox\",\"x\":212,\"y\":124,\"w\":170,\"h\":30,\"groupId\":9,\"props\":{\"signalName\":\"engine.inj_stage[3].mode\",\"enableCondition\":\"[#engine.num_inj_stages] > 3\"}},{\"id\":34,\"uid\":\"950781c2-4e14-4352-ae41-698ccbdcaa04\",\"type\":\"configedit\",\"x\":390,\"y\":124,\"w\":80,\"h\":30,\"groupId\":9,\"props\":{\"signalName\":\"engine.inj_stage[3].injections_per_cycle\",\"enableCondition\":\"[#engine.num_inj_stages] > 3\"}}]"}},{"id":35,"uid":"5a63edd4-21e4-4977-9304-9e6d49e222de","type":"label","x":450,"y":256,"w":550,"h":72,"groupId":0,"props":{"labelText":"A stage is a set of injectors that share a tune: sequential fires each on its own cylinder's event, bank groups them by the bank the cylinder is on, batch fires them together. The name is the way to that stage's tuning. A row greys out when the stage count says it does not exist — the settings are still stored, they are simply not run.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":36,"uid":"b3da7653-d6b2-4b08-938f-df7251e43818","type":"panel","x":1020,"y":30,"w":250,"h":184,"groupId":0,"props":{"labelText":"Then Tune It","layoutMode":"0","padding":"0","children":"[{\"id\":37,\"uid\":\"c4bdf8d8-5d46-4df3-91b4-1d9bf1b1f252\",\"type\":\"label\",\"x\":10,\"y\":10,\"w\":200,\"h\":20,\"groupId\":10,\"props\":{\"labelText\":\"Fuel Setup\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Engine Configuration/Fuel System/Fuel Setup\"}},{\"id\":38,\"uid\":\"32cbb836-151b-4495-bec0-0f77fa63ef38\",\"type\":\"label\",\"x\":10,\"y\":38,\"w\":200,\"h\":20,\"groupId\":11,\"props\":{\"labelText\":\"VE Table\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Fuel Tuning/VE Table\"}},{\"id\":39,\"uid\":\"ec79bb20-bf19-455b-8fdb-1225c77f6651\",\"type\":\"label\",\"x\":10,\"y\":66,\"w\":200,\"h\":20,\"groupId\":12,\"props\":{\"labelText\":\"Target Lambda\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Fuel Tuning/Target Lambda\"}},{\"id\":40,\"uid\":\"3c224f88-68a7-4195-893b-bb596abeeab9\",\"type\":\"label\",\"x\":10,\"y\":94,\"w\":200,\"h\":20,\"groupId\":13,\"props\":{\"labelText\":\"Prime Pulse\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Fuel Tuning/Fuel Prime Pulse\"}},{\"id\":41,\"uid\":\"b792a50d-599f-43c9-a1da-4ca067c42bca\",\"type\":\"label\",\"x\":10,\"y\":122,\"w\":200,\"h\":20,\"groupId\":14,\"props\":{\"labelText\":\"Fuel Tuning\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Fuel Tuning\"}}]"}},{"id":42,"uid":"84d3d805-2323-40be-8d54-c47e2f4cb9d3","type":"panel","x":10,"y":348,"w":1260,"h":344,"groupId":0,"props":{"labelText":"Right Now","layoutMode":"0","padding":"0","children":"[{\"id\":43,\"uid\":\"8a61c78e-f680-48ed-8b4d-135d7f02cbd1\",\"type\":\"value\",\"x\":20,\"y\":14,\"w\":130,\"h\":30,\"groupId\":15,\"props\":{\"signalName\":\"[$inj_pw]\",\"format\":\"%.2f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":44,\"uid\":\"1a7e9768-016f-4afd-af4b-24ba984dd0bc\",\"type\":\"label\",\"x\":20,\"y\":44,\"w\":130,\"h\":20,\"groupId\":15,\"props\":{\"labelText\":\"Injector PW\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":45,\"uid\":\"ff3eae82-7a27-4f1d-80bd-e8b902a5d363\",\"type\":\"value\",\"x\":160,\"y\":14,\"w\":130,\"h\":30,\"groupId\":16,\"props\":{\"signalName\":\"[$fuel_load]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":46,\"uid\":\"89cf3f6f-c240-4356-8bd2-2b655c795efa\",\"type\":\"label\",\"x\":160,\"y\":44,\"w\":130,\"h\":20,\"groupId\":16,\"props\":{\"labelText\":\"Fuel Load\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":47,\"uid\":\"457d1c7f-691c-411e-96e1-c872e2f812b2\",\"type\":\"value\",\"x\":300,\"y\":14,\"w\":130,\"h\":30,\"groupId\":17,\"props\":{\"signalName\":\"[$lambda_1]\",\"format\":\"%.2f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":48,\"uid\":\"12aa31bc-282c-491c-ab6a-2209dbd1024b\",\"type\":\"label\",\"x\":300,\"y\":44,\"w\":130,\"h\"