\":\"[#sensors.sensor[*].diag_enable.raw_min] == 1\"}},{\"id\":16,\"uid\":\"a8ad7c09-dbfc-4d82-933f-ff4af2ac19b8\",\"type\":\"label\",\"x\":34,\"y\":81,\"w\":515,\"h\":16,\"groupId\":3,\"props\":{\"labelText\":\"The pin reads below this \\u2014 an open circuit, or a short to ground.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":17,\"uid\":\"b9bd6208-840b-46a3-8d65-ebdfb193a89c\",\"type\":\"checkbox\",\"x\":10,\"y\":104,\"w\":22,\"h\":22,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.raw_max\"}},{\"id\":18,\"uid\":\"075fb9ab-4bf0-42da-92ba-388be99b30b1\",\"type\":\"label\",\"x\":40,\"y\":102,\"w\":194,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Detect Raw High\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":19,\"uid\":\"c8ca437a-3bd3-4bcb-9ea9-73d55c5bf7d8\",\"type\":\"configedit\",\"x\":240,\"y\":102,\"w\":96,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].diag_raw_max\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_max] == 1\"}},{\"id\":20,\"uid\":\"2917e9f2-6a53-43c5-a7e4-b459e2f258d7\",\"type\":\"enum\",\"x\":346,\"y\":102,\"w\":110,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.raw_max\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_max] == 1\"}},{\"id\":21,\"uid\":\"03235492-409d-420b-a302-d3b79dfca2ee\",\"type\":\"label\",\"x\":462,\"y\":106,\"w\":60,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"P10F1\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_max] == 1\"}},{\"id\":22,\"uid\":\"9e4630cf-7c87-43ff-b22c-1ac22e0febde\",\"type\":\"label\",\"x\":34,\"y\":127,\"w\":515,\"h\":16,\"groupId\":4,\"props\":{\"labelText\":\"The pin reads above this \\u2014 a short to power, or a missing pull-down.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"fb1b8cab-aead-4edd-8