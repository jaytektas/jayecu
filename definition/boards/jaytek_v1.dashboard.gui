{\"id\":29,\"uid\":\"22b8549b-21d3-4710-a8dd-f80a1a58c7af\",\"type\":\"configedit\",\"x\":176,\"y\":12,\"w\":108,\"h\":30,\"groupId\":13,\"props\":{\"signalName\":\"electronic_throttle.etb[0].at_check_duty_pct\"}},{\"id\":30,\"uid\":\"f9f6c743-dcb7-4e98-a13d-ea60796b7d00\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":160,\"h\":20,\"groupId\":14,\"props\":{\"labelText\":\"Check Minimum\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":31,\"uid\":\"3d45bfc2-2de7-4da3-a08e-f9ae913da65c\",\"type\":\"configedit\",\"x\":176,\"y\":42,\"w\":108,\"h\":30,\"groupId\":14,\"props\":{\"signalName\":\"electronic_throttle.etb[0].at_check_min_pct\"}},{\"id\":32,\"uid\":\"2caf2119-468f-4915-86eb-3d5f045a77cf\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":160,\"h\":20,\"groupId\":15,\"props\":{\"labelText\":\"Relay Timeout\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":33,\"uid\":\"304b6d02-ec1b-44b8-8a64-4852d54c87b5\",\"type\":\"configedit\",\"x\":176,\"y\":72,\"w\":123,\"h\":30,\"groupId\":15,\"props\":{\"signalName\":\"electronic_throttle.etb[0].at_relay_timeout_ms\"}}]"}},{"id":34,"uid":"7774a3df-d16d-4241-b9fd-dcf8571d5927","type":"label","x":890,"y":170,"w":300,"h":116,"groupId":0,"props":{"labelText":"Before it tunes, the body is nudged with Check Duty and must move at least Check Minimum — a plate that cannot move is a mechanical fault, and oscillating it deliberately would only make the fault worse. Relay Timeout gives up on a cycle that never comes back.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":35,"uid":"6efb1c9c-028a-4a99-a947-13dee3af0d5e","type":"panel","x":10,"y":332,"w":1260,"h":388,"groupId":0,"props":{"labelText":"While It Runs","layoutMode":"0","padding":"0","children":"[{\"id\":36,\"uid\":\"e9e8448a-246e-4f76-b0fb-c5f227cdc413\",\"type\":\"value\",\"x\":20,\"y\":14,\"w\":120,\"h\":30,\"groupId\":16,\"props\":{\"signalName\":\"[$throttle_demand]\",\"format\":\"%.1f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":37,\"uid\":\"abf28865-c7d5-4da0-a54d-d6676f427f80\",\"type\":\"label\",\"x\":20,\"y\":44,\"w\":120,\"h\":20,\"groupId\":16,\"props\":{\"labelText\":\"Demand\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":38,\"uid\":\"b6ec33ec-ee29-40e8-9c3e-5d3ffd7df99f\",\"type\":\"value\",\"x\":150,\"y\":14,\"w\":120,\"h\":30,\"groupId\":17,\"props\":{\"signalName\":\"[$etb_position_1]\",\"format\":\"%.1f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":39,\"uid\":\"275641a8-ce3c-455b-9d75-d16b25084b35\",\"type\":\"label\",\"x\":150,\"y\":44,\"w\":120,\"h\":20,\"groupId\":17,\"props\":{\"labelText\":\"Position\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":40,\"uid\":\"ab866b38-d42d-42bd-8773-928688c12384\",\"type\":\"value\",\"x\":280,\"y\":14,\"w\":120,\"h\":30,\"groupId\":18,\"props\":{\"signalName\":\"[$etb_duty_1]\",\"format\":\"%.1f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":41,\"uid\":\"7cd483ac-77f8-480d-8180-956d7af4310b\",\"type\":\"label\",\"x\":280,\"y\":44,\"w\":120,\"h\":20,\"groupId\":18,\"props\":{\"labelText\":\"Duty\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":42,\"uid\":\"4f2e5605-bcae-40e5-9dee-40eb46618a1c\",\"type\":\"label\",\"x\":420,\"y\":20,\"w\":400,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"Watch these while a step runs: a stop search that never sees motion, or a relay cycle that will not settle, shows here before the button turns red.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":43,\"uid\":\"ed4b6b9d-f69b-48df-8668-fbcfd2a911a5\",\"type\":\"label\",\"x\":850,\"y\":20,\"w\":390,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Throttle Body A\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Engine Functions/Electronic throttle/Throttle body A\"}}]"}}]},"Configuration/Engine Functions/Idle Stepper":{"uid":"a4596575-2919-442a-b0a3-5d8b9722b2b8","canvasWidth":1280,"canvasHeight":602,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Idle Stepper","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"858356f7-bfc5-47d9-9513-d61c9ba776a4","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"stepper.enabled"}},{"id":2,"uid":"d8ecfec6-d42f-4650-98fc-440c107d5830","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"47374083-46d4-404e-a77d-d26940189483","type":"label","x":136,"y":4,"w":864,"h":40,"groupId":0,"props":{"labelText":"A stepper idle valve instead of a PWM one. It follows a 0-100% demand — idle duty, normally — and steps a motor there, slowly enough that the valve does not miss steps.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"8d2e5e0e-a7d7-4dc9-998c-8ca8d61a274c","type":"panel","x":10,"y":46,"w":400,"h":134,"groupId":0,"props":{"labelText":"Driver","layoutMode":"0","padding":"0","enableCondition":"[#stepper.enabled] == 1","children":"[{\"id\":5,\"uid\":\"bda2ee1c-299d-4c07-8765-777167d20d96\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":150,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Driver Mode\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":6,\"uid\":\"adfb473d-8820-474c-8b96-f5b23fd1aa04\",\"type\":\"combobox\",\"x\":166,\"y\":12,\"w\":210,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"stepper.driver_mode\"}},{\"id\":7,\"uid\":\"e0909e09-b59c-43d7-a6b0-4a8cf3363cd7\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":150,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Demand Signal\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":8,\"uid\":\"82c149fa-c894-4d0a-a106-d2693382ea25\",\"type\":\"enum\",\"x\":166,\"y\":42,\"w\":200,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"stepper.input_sig\"}},{\"id\":9,\"uid\":\"3e40d26a-468e-4425-8efb-f8c2a9cdacf4\",\"type\":\"checkbox\",\"x\":10,\"y\":74,\"w\":22,\"h\":22,\"groupId\":5,\"props\":{\"signalName\":\"stepper.dir_invert\"}},{\"id\":10,\"uid\":\"12026d59-abeb-41c5-b95b-87dbe9e13282\",\"type\":\"label\",\"x\":40,\"y\":71,\"w\":220,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Rotation Invert\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}}]"}},{"id":11,"uid":"4a51be6a-8092-4b57-9b82-4d033bd6da4f","type":"label","x":10,"y":186,"w":390,"h":88,"groupId":0,"props":{"labelText":"H-BRIDGE drives the two coils itself and uses BOTH bridges — so it cannot share a car with dual drive-by-wire, which claims them too. STEP/DIRECTION emits pulses for an external driver IC (A4988, DRV8825) on plain GPIO outputs and leaves the bridges alone.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":12,"uid":"21300400-3748-4669-b01e-a02f9f2b49ef","type":"panel","x":10,"y":296,"w":400,"h":164,"groupId":0,"props":{"labelText":"Travel & Rate","layoutMode":"0","padding":"0","enableCondition":"[#stepper.enabled] == 1","children":"[{\"id\":13,\"uid\":\"37bb99f0-cb99-4a7c-addc-f354b2fb99aa\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":150,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Range\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":14,\"uid\":\"244442c2-b67f-4af5-8150-2d2d2fcd464b\",\"type\":\"configedit\",\"x\":166,\"y\":12,\"w\":139,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"stepper.range_steps\"}},{\"id\":15,\"uid\":\"341ec90c-7a32-44bf-b787-ae7fbbdc2b70\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":150,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"Step Period\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":16,\"uid\":\"01e6938f-05a5-465e-a3bc-559a9df3a2f3\",\"type\":\"configedit\",\"x\":166,\"y\":42,\"w\":107,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"stepper.step_period_ms\"}},{\"id\":17,\"uid\":\"c78f86d6-bd46-4d74-a183-ccaa9eb92fca\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":150,\"h\":20,\"groupId\":8,\"props\":{\"labelText\":\"Microsteps\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#stepper.enabled] == 1 && [#stepper.driver_mode] == 0\"}},{\"id\":18,\"uid\":\"6269a8f7-cfd6-44d3-bbeb-a55f59cad495\",\"type\":\"configedit\",\"x\":166,\"y\":72,\"w\":100,\"h\":30,\"groupId\":8,\"props\":{\"signalName\":\"stepper.microstep\",\"enableCondition\":\"[#stepper.enabled] == 1 && [#stepper.driver_mode] == 0\"}},{\"id\":19,\"uid\":\"099607a7-5257-43ab-b311-a47a1c4b9beb\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":150,\"h\":20,\"groupId\":9,\"props\":{\"labelText\":\"Max Steps / Update\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#stepper.enabled] == 1 && [#stepper.driver_mode] == 0\"}},{\"id\":20,\"uid\":\"f03a925a-0397-4aca-8b5f-2c5216218b5a\",\"type\":\"configedit\",\"x\":166,\"y\":102,\"w\":100,\"h\":30,\"groupId\":9,\"props\":{\"signalName\":\"stepper.max_step_per_update\",\"enableCondition\":\"[#stepper.enabled] == 1 && [#stepper.driver_mode] == 0\"}}]"}},{"id":21,"uid":"eca51ccc-f959-483f-a9d5-56b80384ec3a","type":"label","x":10,"y":466,"w":390,"h":104,"groupId":0,"props":{"labelText":"Range is the whole travel: 0-100% of demand maps onto it. Step period is the minimum time per FULL step — a GM-style IAC wants 5-10 ms, and going below what the valve can follow makes it miss steps silently, because a stepper has no feedback to notice. Microsteps and the per-service ceiling are H-Bridge only; an external driver owns its own microstepping.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":22,"uid":"02c02db7-4c3d-4079-9b00-7f8e2d023b41","type":"panel","x":420,"y":46,"w":380,"h":104,"groupId":0,"props":{"labelText":"Coil Current","layoutMode":"0","padding":"0","enableCondition":"[#stepper.enabled] == 1 && [#stepper.driver_mode] == 0","children":"[{\"id\":23,\"uid\":\"363ce018-2176-45e6-91c3-b3c9947d67a2\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":140,\"h\":20,\"groupId\":10,\"props\":{\"labelText\":\"Move Current\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":24,\"uid\":\"3a6f20d8-fbf7-4e12-a511-7160a2f9b454\",\"type\":\"configedit\",\"x\":156,\"y\":12,\"w\":108,\"h\":30,\"groupId\":10,\"props\":{\"signalName\":\"stepper.move_current_pct\"}},{\"id\":25,\"uid\":\"807e9119-1af7-469e-8333-447157a51825\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":140,\"h\":20,\"groupId\":11,\"props\":{\"labelText\":\"Hold Current\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":26,\"uid\":\"18e9b692-8ed5-4ede-8dd8-e6d04e1cfa94\",\"type\":\"configedit\",\"x\":156,\"y\":42,\"w\":108,\"h\":30,\"groupId\":11,\"props\":{\"signalName\":\"stepper.hold_current_pct\"}}]"}},{"id":27,"uid":"1d70a91e-ce6b-4d4d-a7e9-3b8316bb98dc","type":"label","x":420,"y":156,"w":370,"h":104,"groupId":0,"props":{"labelText":"Moving needs more current than holding: too little and the motor stalls and loses position without saying so. Holding is a static load with no back-EMF to help, so full current there is heat in the motor and the driver for no more holding torque — and too little lets the valve creep under spring or airflow load.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":28,"uid":"2ea82167-d97c-4aef-a191-db9b167a4876","type":"panel","x":420,"y":266,"w":380,"h":286,"groupId":0,"props":{"labelText":"Wiring · H-Bridge","layoutMode":"0","padding":"0","enableCondition":"[#stepper.enabled] == 1","condition":"[#stepper.driver_mode] == 0","children":"[{\"id\":29,\"uid\":\"560f3163-a017-4089-95b3-94bdf02aad35\",\"type\":\"label\",\"x\":10,\"y\":10,\"w\":360,\"h\":80,\"groupId\":0,\"props\":{\"labelText\":\"The module publishes two signed coil demands and their enables. Point the bridges at them by hand \\u2014 nothing does it for you, and a bridge left unassigned drives nothing while the valve looks stuck:\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":30,\"uid\":\"9d07e312-7be3-49ab-ba6f-03b5312db9b9\",\"type\":\"label\",\"x\":10,\"y\":108,\"w\":150,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Half Bridge A\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Electrical/Half Bridges/Half Bridge A\"}},{\"id\":31,\"uid\":\"2a7ae6f8-cfeb-4066-adf6-d1f62ea0d1bf\",\"type\":\"label\",\"x\":165,\"y\":108,\"w\":205,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"demand = step_demand_a\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":32,\"uid\":\"9dd1bd86-ee73-47ab-bf0f-3defd2160802\",\"type\":\"label\",\"x\":165,\"y\":128,\"w\":205,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"enable = step_en_a\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":33,\"uid\":\"6092e11d-a858-4e33-bd94-d6094a3c9d6b\",\"type\":\"label\",\"x\":10,\"y\":156,\"w\":150,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Half Bridge B\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Electrical/Half Bridges/Half Bridge B\"}},{\"id\":34,\"uid\":\"9714946e-52ff-41a2-8731-71c362977d73\",\"type\":\"label\",\"x\":165,\"y\":156,\"w\":205,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"demand = step_demand_b\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":35,\"uid\":\"03c57a19-33a7-4bac-b6fa-7a375b066189\",\"type\":\"label\",\"x\":165,\"y\":176,\"w\":205,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"enable = step_en_b\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":36,\"uid\":\"8b7c16a5-e39e-4219-8ab3-0f818c734c26\",\"type\":\"label\",\"x\":10,\"y\":208,\"w\":360,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"Both bridges must be set to UNIPOLAR: the coil demands are signed.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#ff8c28\",\"wrap\":\"1\"}}]"}},{"id":37,"uid":"395cc1ec-4ab4-49ed-a9d8-6845c17b7a35","type