b-0365-4b9a-a945-d8214a3f4206\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":252,\"h\":20,\"groupId\":34,\"props\":{\"labelText\":\"On Time\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":98,\"uid\":\"0c1d9010-12ab-49bb-bc18-d202e41f3cb1\",\"type\":\"configedit\",\"x\":268,\"y\":42,\"w\":118,\"h\":30,\"groupId\":34,\"props\":{\"signalName\":\"pc.test_on_ms\"}},{\"id\":99,\"uid\":\"a312551a-9fb4-4403-a5ee-6cd2c823ce5e\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":252,\"h\":20,\"groupId\":35,\"props\":{\"labelText\":\"Off Time\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":100,\"uid\":\"45bd1df6-e8c7-46fa-9696-57c446413047\",\"type\":\"configedit\",\"x\":268,\"y\":72,\"w\":118,\"h\":30,\"groupId\":35,\"props\":{\"signalName\":\"pc.test_off_ms\"}},{\"id\":101,\"uid\":\"8d53d135-d21b-45bd-8ecd-720131a4889d\",\"type\":\"command\",\"x\":10,\"y\":110,\"w\":120,\"h\":30,\"groupId\":0,\"props\":{\"labelText\":\"Test\",\"command\":\"test 13\",\"arg0\":\"[#pc.test_count]\",\"arg1\":\"[#pc.test_on_ms]\",\"arg2\":\"[#pc.test_off_ms]\"}},{\"id\":102,\"uid\":\"d94ba65b-7ecc-4ab7-9d17-9ddba61a85b8\",\"type\":\"command\",\"x\":138,\"y\":110,\"w\":90,\"h\":30,\"groupId\":0,\"props\":{\"labelText\":\"Stop\",\"command\":\"test 13 0 0 0\"}},{\"id\":103,\"uid\":\"67f3acf2-1bcd-4d40-a217-db9b4f9c3c85\",\"type\":\"command\",\"x\":236,\"y\":110,\"w\":110,\"h\":30,\"groupId\":0,\"props\":{\"labelText\":\"Stop All\",\"command\":\"test 255 0 0 0\"}},{\"id\":104,\"uid\":\"0c755c9d-175b-4d5e-a9c2-2100a7b0a44a\",\"type\":\"label\",\"x\":10,\"y\":146,\"w\":390,\"h\":80,\"groupId\":0,\"props\":{\"labelText\":\"Engine stopped only; a start cancels it, and the ECU ends the test itself. What happens comes from the Function above \\u2014 a coil dwells then releases, an injector pulses, anything else is held on. On Time is used as given: mind the dwell on a coil.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"outputs.output[13]"}