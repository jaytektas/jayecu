_enable.op_min] == 1\"}},{\"id\":28,\"uid\":\"18e3f6d2-1a5e-46ee-a1b9-0d740dc5197c\",\"type\":\"label\",\"x\":462,\"y\":174,\"w\":60,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"P0121\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":29,\"uid\":\"379d0080-dc75-48d0-80e4-c57bf5fc9adc\",\"type\":\"label\",\"x\":34,\"y\":195,\"w\":515,\"h\":16,\"groupId\":5,\"props\":{\"labelText\":\"The calibrated reading is below what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":30,\"uid\":\"146b1836-4e7c-448e-8284-ca6f70854476\",\"type\":\"checkbox\",\"x\":10,\"y\":218,\"w\":22,\"h\":22,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.op_max\"}},{\"id\":31,\"uid\":\"f54e2b56-8f9d-4d04-90e4-71070bc4025e\",\"type\":\"label\",\"x\":40,\"y\":216,\"w\":194,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Detect Reading High\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":32,\"uid\":\"ed94220e-1686-406b-993e-4f9f72e7e998\",\"type\":\"configedit\",\"x\":240,\"y\":216,\"w\":96,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_op_max\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":33,\"uid\":\"dd4318a4-3682-498c-8a7b-8397b49317a3\",\"type\":\"enum\",\"x\":346,\"y\":216,\"w\":110,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.op_max\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":34,\"uid\":\"1587bd84-7ab0-4b55-87c1-f2a46e88ba43\",\"type\":\"label\",\"x\":462,\"y\":220,\"w\":60,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"P1083\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":35,\"uid\":\"bad1d31f-d8c0-4447-9838-8e2285a249b0\",\"type\":\"label\",\"x\":34,\"y\":241,\"w\":515,\"h\":16,\"groupId\":6,\"props\":{\"labelText\":\"The calibrated reading is above what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":36,\"uid\":\"4165ee71-21d9-4a75-aa5b-7b71493f42cf\",\"type\":\"label\",\"x\":560,\"y\":38,\"w\":140,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"DTC Delay\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":37,\"uid\":\"814e042d-ddc3-465a-9b46-7c353cb8c6a6\",\"type\":\"configedit\",\"x\":706,\"y\":34,\"w\":123,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"sensors.sensor[*].diag_delay_ms\"}},{\"id\":38,\"uid\":\"e0c33e43-94a1-45c0-a4eb-3dc8e741694d\",\"type\":\"label\",\"x\":560,\"y\":68,\"w\":400,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"How long a check has to keep failing before it becomes a fault. A sensor that blips once on a starter crank is not a broken sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":39,\"uid\":\"33fff17a-1362-4630-b5e0-b0160c05b6b4\",\"type\":\"label\",\"x\":560,\"y\":110,\"w\":400,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Precondition\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":40,\"uid\":\"54207477-3a8f-4f98-b110-31384e2bfbd6\",\"type\":\"expression\",\"x\":560,\"y\":132,\"w\":400,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].precond_expr\"}},{\"id\":41,\"uid\":\"a6a7574f-2243-4841-827d-ce6f185771ac\",\"type\":\"label\",\"x\":560,\"y\":164,\"w\":400,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"The plausibility checks only run while this holds \\u2014 an oil pressure of zero is a fault at 3000 rpm and the truth with the engine stopped.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":42,\"uid\":\"50d31ff5-8f2b-45e7-9904-19d8830128cc\",\"type\":\"label\",\"x\":990,\"y\":34,\"w\":250,\"h\":170,\"groupId\":0,\"props\":{\"labelText\":\"The electrical pair tests the RAW input in the input's own units, before calibration; the plausibility pair tests the calibrated reading. Severity is what the DTC records and what the protection levels read. A check with no code is one this sensor cannot report, and is not offered \\u2014 which is why two sensors show different rows here.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[tps]"},"Configuration/Sensors/Engine/Throttle Position 2":{"uid":"8e43f780-1941-4e41-bda3-981973548b47","canvasWidth":1280,"canvasHeight":700,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Throttle Position 2","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"4703db39-8bf7-4932-afd0-d32090a4c2c8","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"sensors.sensor[*].enabled"}},{"id":2,"uid":"1e3531c0-9167-483a-96ba-99b9cd4e4688","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"a71f6f6c-b7f1-4023-97c7-96104f28740d","type":"label","x":136,"y":4,"w":379,"h":24,"groupId":0,"props":{"labelText":"What this input is wired to, and what its curve makes of it.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"62ff383f-d078-4ab7-9900-8112184b310c","type":"panel","x":10,"y":30,"w":300,"h":662,"groupId":0,"props":{"labelText":"1 · Input","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":5,\"uid\":\"dd2da907-4368-4af5-8f41-24b8ecb3b030\",\"type\":\"value\",\"x\":12,\"y\":10,\"w\":274,\"h\":54,\"groupId\":0,\"props\":{\"signalName\":\"[$~]\",\"fontName\":\"|26|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"4\"}},{\"id\":6,\"uid\":\"a7064849-ce5e-42c1-95fa-bfdc98c3c74b\",\"type\":\"label\",\"x\":12,\"y\":66,\"w\":274,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Raw input  (as the pin reads it)\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":7,\"uid\":\"d706c0f0-465c-47df-9d89-87d6b573f182\",\"type\":\"label\",\"x\":10,\"y\":100,\"w\":90,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Interface\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":8,\"uid\":\"32243ef0-af58-4f3f-bd98-b8f08678c898\",\"type\":\"combobox\",\"x\":106,\"y\":96,\"w\":150,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].interface\"}},{\"id\":9,\"uid\":\"74dd1a72-07ac-44e4-ae12-b46c3289e069\",\"type\":\"wiring\",\"x\":10,\"y\":132,\"w\":274,\"h\":76,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].source\",\"condition\":\"[#sensors.sensor[*].interface] == 0 || [#sensors.sensor[*].interface] == 1 || [#sensors.sensor[*].interface] == 3 || [#sensors.sensor[*].interface] == 4 || [#sensors.sensor[*].interface] == 6 || [#sensors.sensor[*].interface] == 7\"}},{\"id\":10,\"uid\":\"bdd1d121-de00-4d53-8abd-fbc51c95b7e4\",\"type\":\"label\",\"x\":10,\"y\":220,\"w\":90,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"CAN Field\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 5\"}},{\"id\":11,\"uid\":\"b6b878e0-557c-4224-a0d2-f91e438c6817\",\"type\":\"canfield\",\"x\":106,\"y\":216,\"w\":170,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].can_frame\",\"condition\":\"[#sensors.sensor[*].interface] == 5\"}},{\"id\":12,\"uid\":\"696e15f8-ab43-4851-a95d-ae4bdfbd1ff4\",\"type\":\"checkbox\",\"x\":10,\"y\":252,\"w\":22,\"h\":22,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].flags.invert\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":13,\"uid\":\"f80f3036-4e2f-4b49-898f-a07b82161ee3\",\"type\":\"label\",\"x\":40,\"y\":249,\"w\":220,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Invert  (switch inputs)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":14,\"uid\":\"124e0208-de4e-4251-9e78-37682c3a08e8\",\"type\":\"label\",\"x\":10,\"y\":292,\"w\":274,\"h\":224,\"groupId\":0,\"props\":{\"labelText\":\"Interface says HOW the pin is read, and decides which inputs the picker offers \\u2014 a frequency sensor cannot be wired to an analogue pin. Two sensors on one pin is a fault, not a preference. A CAN sensor has no pin at all: it reads a field defined on the Receive page for its bus, named here by that frame and the field's start bit. A field whose own Signal is set is greyed in the list \\u2014 the frame writes that channel itself, and the sensor publishing it too would put two producers on one channel.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":15,"uid":"7c6cae8a-640a-4911-aaed-2d6d44d59ab6","type":"panel","x":320,"y":30,"w":630,"h":662,"groupId":0,"props":{"labelText":"2 · Calibration","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":16,\"uid\":\"3a762904-9090-4176-8389-cd35c7e358b7\",\"type\":\"table\",\"x\":10,\"y\":10,\"w\":600,\"h\":96,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"axisMode\":\"1\",\"displayUnit\":\"Auto\",\"displayUnitX\":\"Auto\",\"displayUnitY\":\"Auto\",\"cellTrace\":\"2\"}},{\"id\":17,\"uid\":\"3ad79ced-4858-4f5a-8800-f75fda3a5b38\",\"type\":\"curve\",\"x\":10,\"y\":114,\"w\":600,\"h\":450,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"displayUnit\":\"Auto\",\"axisUnit\":\"Auto\",\"valueUnit\":\"Auto\"}},{\"id\":18,\"uid\":\"c2cf23ba-9451-41c6-8fe7-7559a1005a2a\",\"type\":\"label\",\"x\":10,\"y\":568,\"w\":600,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"Raw in along the top, reading out underneath. Right-click either for insert, delete, linearise \\u2014 or to save this curve to a file and load it into the next car with the same sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\",\"signalName\":\"sensors.sensor[*].cal\"}},{\"id\":19,\"uid\":\"669de7c8-de43-47d3-9b6f-02a1ce9faad8\",\"type\":\"bands\",\"x\":10,\"y\":10,\"w\":600,\"h\":616,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\"}}]"}},{"id":20,"uid":"e7ba8d01-a934-4395-840c-bfd42e6e37f6","type":"panel","x":960,"y":30,"w":310,"h":662,"groupId":0,"props":{"labelText":"3 · Output","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":21,\"uid\":\"67b49a3a-ada3-42f3-b9c5-cf2a74a71c2f\",\"type\":\"value\",\"x\":12,\"y\":10,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"signalName\":\"[$*]\",\"format\":\"%.2f\",\"fontName\":\"|30|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"4\"}},{\"id\":22,\"uid\":\"d60f82b7-6182-4b46-85b1-845ce847e091\",\"type\":\"label\",\"x\":12,\"y\":74,\"w\":284,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Reading  (what everything downstream sees)\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"bf71c503-5eac-40d9-aa6a-8a34bb20cec0\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":90,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Type\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":24,\"uid\":\"90b8d1ab-5c19-4511-9a1f-e1669cb9dbe1\",\"type\":\"label\",\"x\":106,\"y\":106,\"w\":190,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Percent\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":25,\"uid\":\"81023400-7585-45fa-ba91-83065cf55729\",\"type\":\"label\",\"x\":10,\"y\":142,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"This input's type is fixed by the ECU \\u2014 it is what the sensor IS. Only the generic inputs (aux, rotary trim) can be re-typed.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":26,\"uid\":\"b98067b6-645b-4ce8-b999-37e47d60ccdf\",\"type\":\"label\",\"x\":10,\"y\":214,\"w\":284,\"h\":98,\"groupId\":0,\"props\":{\"labelText\":\"Input and output are both on screen because a calibration is a claim about how one becomes the other: watch the pair move together and a wrong curve shows itself immediately.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":27,\"uid\":\"66fe34f0-dbb3-47c0-8456-ded1f378ac39\",\"type\":\"panel\",\"x\":10,\"y\":308,\"w\":284,\"h\":1,\"groupId\":0,\"props\":{\"bgColor\":\"#8a8f98\",\"padding\":\"0\"}},{\"id\":28,\"uid\":\"a8e2fd64-aa07-4a41-aff6-942aa34ba753\",\"type\":\"label\",\"x\":10,\"y\":318,\"w\":284,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Diagnostics  (4 checks)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Sensors/Engine/Throttle Position 2/Diagnostics\"}},{\"id\":29,\"uid\":\"efa80e75-d07d-452b-8926-fbd347b6df30\",\"type\":\"label\",\"x\":10,\"y\":342,\"w\":284,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"What this input must complain about, when, and with which code.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[tps_2]"},"Configuration/Sensors/Engine/Throttle Position 2/Diagnostics":{"uid":"a7c540de-613e-46ad-b3c2-e59c0c08c064","canvasWidth":1280,"canvasHeight":336,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Throttle Position 2 — Diagnostics","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"e99299c3-c0a7-4d76-8f83-196eb15193e5","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"sensors.sensor[*].enabled"}},{"id":2,"uid":"c09499a5-3e2a-4e9a-8ecb-0744a07aa46