type":"label","x":10,"y":200,"w":410,"h":72,"groupId":0,"props":{"labelText":"The duty cap is the safety limit on how hard the plate is pushed into its stop; motion threshold is the least sensor travel the sweep must see from stop to stop — with any less it fails, as a stuck, dead or miswired plate.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":12,"uid":"85a1107c-2438-4997-ab04-42bdc9be1f51","type":"panel","x":450,"y":30,"w":420,"h":254,"groupId":0,"props":{"labelText":"Step 3 · Autotuning the PID","layoutMode":"0","padding":"0","children":"[{\"id\":13,\"uid\":\"83d251cd-45e1-49a7-abe8-69a262c0f73f\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":180,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Relay Amplitude\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":14,\"uid\":\"b8e20255-2c52-4b84-9a31-67d320a2b56e\",\"type\":\"configedit\",\"x\":196,\"y\":12,\"w\":100,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"electronic_throttle.etb[0].at_relay_pct\"}},{\"id\":15,\"uid\":\"2a514876-91fe-44d7-86bb-de58899391c0\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":180,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"Settle Band\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":16,\"uid\":\"cecaebe1-e6e1-4ba2-bf4b-9bc2a07bde2e\",\"type\":\"configedit\",\"x\":196,\"y\":42,\"w\":100,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"electronic_throttle.etb[0].at_settle_band_pct\"}},{\"id\":17,\"uid\":\"a29b95b8-b130-4c72-af40-fefe095bc082\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":180,\"h\":20,\"groupId\":8,\"props\":{\"labelText\":\"Settle Dwell\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":18,\"uid\":\"ebd57ed3-f3b7-482b-877c-5af439a3065b\",\"type\":\"configedit\",\"x\":196,\"y\":72,\"w\":115,\"h\":30,\"groupId\":8,\"props\":{\"signalName\":\"electronic_throttle.etb[0].at_settle_dwell_ms\"}},{\"id\":19,\"uid\":\"cc633233-82af-4847-9ae4-117631c812e0\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":180,\"h\":20,\"groupId\":9