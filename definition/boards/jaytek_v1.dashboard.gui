":90,\"h\":30,\"groupId\":0,\"props\":{\"labelText\":\"Stop\",\"command\":\"test 35 0 0 0\"}},{\"id\":103,\"uid\":\"67f3acf2-1bcd-4d40-a217-db9b4f9c3c85\",\"type\":\"command\",\"x\":236,\"y\":110,\"w\":110,\"h\":30,\"groupId\":0,\"props\":{\"labelText\":\"Stop All\",\"command\":\"test 255 0 0 0\"}},{\"id\":104,\"uid\":\"0c755c9d-175b-4d5e-a9c2-2100a7b0a44a\",\"type\":\"label\",\"x\":10,\"y\":146,\"w\":390,\"h\":80,\"groupId\":0,\"props\":{\"labelText\":\"Engine stopped only; a start cancels it, and the ECU ends the test itself. What happens comes from the Function above \\u2014 a coil dwells then releases, an injector pulses, anything else is held on. On Time is used as given: mind the dwell on a coil.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"outputs.output[35]"},"Configuration/Electrical/Outputs/HS2/Frequency":{"uid":"7005d856-5610-4715-ba03-5231ec7d01fa","canvasWidth":980,"canvasHeight":444,"minWidth":980,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Frequency","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"bdf8b3c0-17cc-4906-9be6-a25e8936cfc3","type":"label","x":10,"y":4,"w":956,"h":24,"groupId":0,"props":{"labelText":"How fast this output is chopped. A fixed frequency, an expression, or a table it names — the duty is on the output's own page; this is only the carrier.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"21f4233b-aa0a-4829-87a8-7ac81a2ec94c","type":"panel","x":10,"y":30,"w":470,"h":168,"groupId":0,"props":{"labelText":"Carrier","layoutMode":"0","padding":"0","children":"[{\"id\":3,\"uid\":\"e0fced16-5ae6-4b03-85c2-682b7a5dd9f9\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":240,\"h\":20,\"groupId\":2,\"props\":{\"labelText\":\"Frequency From\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":4,\"uid\":\"f3f8d9d2-c087-4e1f-9c36-2d2ab9ab9f97\",\"type\":\"combobox\",\"x\":256,\"y\":12,\"w\":190,\"h\":30,\"groupId\":2,\"props\":{\"signalName\":\"outputs.output[*].freq_source\"}},{\"id\":5,\"uid\":\"2e5cbf1a-4636-4025-bdce-395198c23978\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":330,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Fixed Frequency\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 0\"}},{\"id\":6,\"uid\":\"80d40fe9-8924-4ab6-b7bc-778dbf09f132\",\"type\":\"configedit\",\"x\":346,\"y\":42,\"w\":100,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"outputs.output[*].pwm_freq_hz\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 0\"}},{\"id\":7,\"uid\":\"c42e98b1-cb04-47d6-b004-60d1818a8849\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":180,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Frequency Table\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 1\"}},{\"id\":8,\"uid\":\"83eee1e6-f933-4b44-9902-f474ce91366e\",\"type\":\"enum\",\"x\":196,\"y\":72,\"w\":250,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"outputs.output[*].freq_table_sel\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 1\"}},{\"id\":9,\"uid\":\"c90a2050-3b96-4bc4-8849-9382b8b6c480\",\"type\":\"label\",\"x\":10,\"y\":108,\"w\":110,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Expression\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 2\"}},{\"id\":10,\"uid\":\"328fc0a9-3f82-4fd2-b608-440ae0c6dcea\",\"type\":\"expression\",\"x\":124,\"y\":104,\"w\":336,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"outputs.output[*].freq_expr\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 2\"}}]"}},{"id":11,"uid":"895bd531-878f-456a-863a-855eb7f8f6fc","type":"label","x":10,"y":206,"w":470,"h":88,"groupId":0,"props":{"labelText":"Answers are hertz, clamped to what the timer can make. The pulse engine is software-timed, so a carrier much past two kilohertz costs more in edges than it buys in resolution. An unanswerable expression or table falls back to the fixed frequency rather than stopping the output — a duty with no carrier is not an output at all.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":12,"uid":"60137e52-e8e1-4686-91b8-c9d23c330607","type":"panel","x":10,"y":302,"w":470,"h":132,"groupId":0,"props":{"labelText":"Right Now","layoutMode":"0","padding":"0","children":"[{\"id\":13,\"uid\":\"988c40dd-237c-44c9-87dc-b382b04a4f82\",\"type\":\"value\",\"x\":15,\"y\":12,\"w\":170,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"rpm\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":14,\"uid\":\"52327055-da49-4dc8-90ec-49b681c9449b\",\"type\":\"label\",\"x\":15,\"y\":42,\"w\":170,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Engine RPM\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":15,\"uid\":\"f9fbb871-2e8e-401f-8203-d54c834d9205\",\"type\":\"value\",\"x\":195,\"y\":12,\"w\":170,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"clt\",\"format\":\"%.1f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":16,\"uid\":\"f6597b88-4278-4411-9d7a-e34421ca7a8f\",\"type\":\"label\",\"x\":195,\"y\":42,\"w\":170,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Coolant\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":17,\"uid\":\"abbbba9f-d23f-48a9-a089-a678f4ef5d26\",\"type\":\"label\",\"x\":15,\"y\":76,\"w\":340,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Outputs  (the duty)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Con