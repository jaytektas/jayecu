:\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"06daf964-bd15-4cb8-bdfa-bd6a78951bbf\",\"type\":\"value\",\"x\":14,\"y\":126,\"w\":120,\"h\":30,\"groupId\":11,\"props\":{\"signalName\":\"[$can1_bus_off]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":24,\"uid\":\"212524b5-46c3-4c13-a35c-7bfed4060df5\",\"type\":\"label\",\"x\":14,\"y\":156,\"w\":120,\"h\":20,\"groupId\":11,\"props\":{\"labelText\":\"Bus-Off\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":25,\"uid\":\"b147927c-550b-47eb-b5f7-2028dc0ea077\",\"type\":\"value\",\"x\":150,\"y\":126,\"w\":120,\"h\":30,\"groupId\":12,\"props\":{\"signalName\":\"[$can1_tx_fail]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":26,\"uid\":\"cf81c964-d043-4ee3-be0d-3f82b6bd31e3\",\"type\":\"label\",\"x\":150,\"y\":156,\"w\":120,\"h\":20,\"groupId\":12,\"props\":{\"labelText\":\"Refused\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":27,\"uid\":\"48ec0e80-b5e3-4cd1-9417-c152914401d3\",\"type\":\"value\",\"x\":14,\"y\":182,\"w\":396,\"h\":30,\"groupId\":13,\"props\":{\"signalName\":\"[$can1_last_err]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":28,\"uid\":\"c9b9f950-8591-40f4-983f-7dd271d1c235\",\"type\":\"label\",\"x\":14,\"y\":212,\"w\":396,\"h\":20,\"groupId\":13,\"props\":{\"labelText\":\"Last Error\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":29,\"uid\":\"698bd8b1-4428-40c7-b339-7373e6ba61e8\",\"type\":\"label\",\"x\":14,\"y\":238,\"w\":410,\"h\":80,\"groupId\":0,\"props\":{\"labelText\":\"A transmit error count above 127 is error-passive and 255 is bus-off; Refused counts frames the driver would not take, which is a jammed mailbox rather than a quiet wire. A bus reading zero load with errors climbing is talking to nobody.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}]},"Configuration/CAN Bus/CAN1/Transmit":{"uid":"66fda912-eb63-4a92-9b44-12c0a8c99f47","canvasWidth":1280,"canvasHeight":716,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"CAN1 Transmit","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"5ba408b5-a707-4cbc-9dc6-6f88bc266ecc","type":"label","x":10,"y":4,"w":990,"h":56,"groupId":0,"props":{"labelText":"Frames this ECU SENDS on CAN1, each on its own period, built from whatever the signal bus is carrying at the time. A transmit frame is unsolicited traffic — it goes on a wire that may already belong to something else — so a frame can be parked with its Enabled tick without losing how it was set up. CAN1 must be enabled on its own page (CAN Bus ▸ CAN1); edits live in ECU RAM until you burn.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"76b3995c-cf36-479c-b56d-4f4f5daf3f33","type":"genericcan","x":10,"y":62,"w":1260,"h":644,"groupId":0,"props":{"bus":"0","dir":"Transmit"}}]},"Configuration/CAN Bus/CAN1/Receive":{"uid":"b0d9d3a2-7d27-47c4-ba05-93b8ce962afb","canvasWidth":1280,"canvasHeight":716,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"CAN1 Receive","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"f6167b24-e217-46e9-9d4b-de4c25597d6d","type":"label","x":10,"y":4,"w":990,"h":56,"groupId":0,"props":{"labelText":"Frames this ECU DECODES on CAN1. Each signal lands on the bus with a TTL, so a sender going quiet leaves an absent channel rather than a number frozen at its last value. A signal left as “none” is one a SENSOR reads: point that sensor's CAN Field at the field and it publishes the channel with its own calibration and diagnostics. CAN1 must be enabled on its own page (CAN Bus ▸ CAN1); edits live in ECU RAM until you burn.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"8caafc70-fa28-44f1-895d-c7442cc14af0","type":"genericcan","x":10,"y":62,"w":1260,"h":644,"groupId":0,"props":{"bus":"0","dir":"Receive"}}]},"Configuration/CAN Bus/CAN2":{"uid":"0de82eb2-ac6d-4c4d-b155-a4d2d53ad50a","canvasWidth":1280,"canvasHeight":408,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"CAN2","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"9c79f8b3-57e4-453f-acf9-92a318fd3367","type":"label","x":10,"y":4,"w":990,"h":40,"groupId":0,"props":{"labelText":"CAN2 is a physical CAN controller. Nothing here is about what the bus CARRIES — that is Transmit and Receive below it — this is the wire itself: whether it is brought up, how fast, and whether the ECU is allowed to talk on it.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"cd90676c-9376-4d33-abf0-5a39a236ecde","type":"panel","x":10,"y":46,"w":430,"h":284,"groupId":0,"props":{"labelText":"Setup","layoutMode":"0","padding":"0","children":"[{\"id\":3,\"uid\":\"e0e19f2a-db1e-412d-a026-9882566de62b\",\"type\":\"checkbox\",\"x\":10,\"y\":15,\"w\":22,\"h\":22,\"groupId\":2,\"props\":{\"signalName\":\"can.bus[1].enabled\"}},{\"id\":4,\"uid\":\"d7e0d08c-7787-4e6a-93cb-de354e08eeaf\",\"type\":\"label\",\"x\":40,\"y\":16,\"w\":370,\"h\":20,\"groupId\":2,\"props\":{\"labelText\":\"Enabled\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":5,\"uid\":\"4034fed6-b4bf-41b6-8f1b-bd54cc3b9255\",\"type\":\"label\",\"x\":10,\"y\":50,\"w\":110,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Bitrate\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#can.bus[1].enabled] == 1\",\"enableCondition\":\"canframes(1) == 0\"}},{\"id\":6,\"uid\":\"80ccbf98-14c6-48c9-8f82-8c8b73c43b4f\",\"type\":\"combobox\",\"x\":126,\"y\":46,\"w\":150,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"can.bus[1].bitrate\",\"condition\":\"[#can.bus[1].enabled] == 1\",\"enableCondition\":\"canframes(1) == 0\"}},{\"id\":7,\"uid\":\"e28bbb66-030b-4fd2-8f37-33464427ae0c\",\"type\":\"checkbox\",\"x\":10,\"y\":83,\"w\":22,\"h\":22,\"groupId\":4,\"props\":{\"signalName\":\"can.bus[1].listen_only\",\"condition\":\"[#can.bus[1].enabled] == 1\"}},{\"id\":8,\"uid\":\"d9b49904-7860-441e-98cb-7cfc479c8e01\",\"type\":\"label\",\"x\":40,\"y\":84,\"w\":370,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Listen Only\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#can.bus[1].enabled] == 1\"}},{\"id\":9,\"uid\":\"d2e2e0f5-a43a-480f-89c3-b9960b63a0a9\",\"type\":\"label\",\"x\":10,\"y\":120,\"w\":410,\"h\":134,\"groupId\":0,\"props\":{\"labelText\":\"Listen Only never transmits \\u2014 not even an acknowledgement \\u2014 so the ECU can be put on somebody else's bus without affecting it. A bus that is off is not initialised at all. Every node on a bus must agree on the bit rate: a mismatch never ACKs, which looks exactly like nothing being connected \\u2014 which is why the rate is fixed once this bus carries a frame. Clear its Transmit and Receive lists to change it.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":10,"uid":"b2bc9b57-33da-4fe0-9df9-e758b7a3684e","type":"panel","x":456,"y":46,"w":430,"h":352,"groupId":0,"props":{"labelText":"Right Now","layoutMode":"0","padding":"0","children":"[{\"id\":11,\"uid\":\"60b5b4bc-c2d8-41b8-abeb-88eabd2e07c0\",\"type\":\"value\",\"x\":14,\"y\":14,\"w\":120,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"[$can2_load_pct]\",\"format\":\"%.1f\",\"fontName\":\"|20|0|0\",\"align\":\"Ce