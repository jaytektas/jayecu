:{"labelText":"Held while the engine is CRANKING, in place of the advance map — not added to it. The map is tuned for an engine that is running; at 200 rpm it hands out whatever its lowest RPM bin holds. A few degrees, more when cold because the burn is slower, keeps the kickback torque off the starter. It replaces the slow corrections too: the coolant advance correction reads the same coolant this table does, and applying both would count it twice.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"03356679-469d-4d46-a91e-da08a1fcf6c3","type":"table","x":10,"y":62,"w":938,"h":96,"groupId":0,"props":{"signalName":"ignition.cranking_ign_table","axisMode":"1","displayUnit":"Auto","displayUnitX":"Auto","displayUnitY":"Auto","displayUnitZ":"Auto","enableCondition":"[#ignition.cranking_ign_enable] == 1","cellTrace":"2","anchorX":"both","anchorY":"both"}},{"id":5,"uid":"2f2fa1ab-da4d-4a76-8215-dc550f91773c","type":"value","x":10,"y":166,"w":119,"h":30,"groupId":3,"props":{"signalName":"ignition.cranking_ign_table","format":"%.1f","fontName":"|20|0|0","align":"Center","anchorY":"bottom"}},{"id":6,"uid":"c75fb464-9351-4c84-bb67-8bed4461c0b6","type":"label","x":10,"y":196,"w":119,"h":20,"groupId":3,"props":{"labelText":"Cranking Advance","align":"Center","fontName":"|15|0|0","fgColor":"#8a8f98","anchorY":"bottom"}},{"id":7,"uid":"2f31c664-346e-4b09-b088-44137684a8a3","type":"value","x":141,"y":166,"w":83,"h":30,"groupId":4,"props":{"signalName":"advance","format":"%.1f","fontName":"|20|0|0","align":"Center","anchorY":"bottom"}},{"id":8,"uid":"3e958503-df04-4ca4-b500-fca86fd1676c","type":"label","x":141,"y":196,"w":83,"h":20,"groupId":4,"props":{"labelText":"Advance","align":"Center","fontName":"|15|0|0","fgColor":"#8a8f98","anchorY":"bottom"}},{"id":9,"uid":"7d608e5c-d57a-4e18-bc67-d4a0b4641415","type":"value","x":236,"y":166,"w":83,"h":30,"groupId":5,"props":{"signalName":"clt","format":"%.0f","fontName":"|20|0|0","align":"Center","anchorY"