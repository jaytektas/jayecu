\":\"c42e98b1-cb04-47d6-b004-60d1818a8849\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":180,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Frequency Table\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 1\"}},{\"id\":8,\"uid\":\"83eee1e6-f933-4b44-9902-f474ce91366e\",\"type\":\"enum\",\"x\":196,\"y\":72,\"w\":250,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"outputs.output[*].freq_table_sel\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 1\"}},{\"id\":9,\"uid\":\"c90a2050-3b96-4bc4-8849-9382b8b6c480\",\"type\":\"label\",\"x\":10,\"y\":108,\"w\":110,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Expression\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 2\"}},{\"id\":10,\"uid\":\"328fc0a9-3f82-4fd2-b608-440ae0c6dcea\",\"type\":\"expression\",\"x\":124,\"y\":104,\"w\":336,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"outputs.output[*].freq_expr\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 2\"}}]"}},{"id":11,"uid":"895bd531-878f-456a-863a-855eb7f8f6fc","type":"label","x":10,"y":206,"w":470,"h":88,"groupId":0,"props":{"labelText":"Answers are hertz, clamped to what the timer can make. The pulse engine is software-timed, so a carrier much past two kilohertz costs more in edges than it buys in resolution. An unanswerable expression or table falls back to the fixed frequency rather than stopping the output — a duty with no carrier is not an output at all.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":12,"uid":"60137e52-e8e1-4686-91b8-c9d23c330607","type":"panel","x":10,"y":302,"w":470,"h":132,"groupId":0,"props":{"labelText":"Right Now","layoutMode":"0","padding":"0","children":"[{\"id\":13,\"uid\":\"988c40dd-237c-44c9-87dc-b382b04a4f82\",