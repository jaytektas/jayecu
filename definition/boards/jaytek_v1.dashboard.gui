c8-462d-a46d-5fe45a48a544\",\"type\":\"value\",\"x\":355,\"y\":14,\"w\":120,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"[$trigger_last_error_kind]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":19,\"uid\":\"516fa893-9c9e-44a7-bebb-6a659bb24e59\",\"type\":\"label\",\"x\":355,\"y\":44,\"w\":120,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"Last Kind\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":20,\"uid\":\"e24a1fb0-98c5-43bc-9227-2d278c2c7d0e\",\"type\":\"value\",\"x\":485,\"y\":14,\"w\":120,\"h\":30,\"groupId\":8,\"props\":{\"signalName\":\"[$trigger_last_error_tooth]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":21,\"uid\":\"27ecf1d7-dcd4-4eb5-8d0f-e90ea6708e57\",\"type\":\"label\",\"x\":485,\"y\":44,\"w\":120,\"h\":20,\"groupId\":8,\"props\":{\"labelText\":\"Last Tooth\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":22,\"uid\":\"44a3af2b-4c3e-43c2-ac15-ac695ee6c08c\",\"type\":\"label\",\"x\":15,\"y\":84,\"w\":590,\"h\":80,\"groupId\":0,\"props\":{\"labelText\":\"Error rate is the share of teeth in the last pattern revolution that were rejected. It should be 0. Anything else is teeth being missed (a gap that is not there) or invented (noise read as a tooth) \\u2014 check the sensor gap, the shielding, and that the wheel in Trigger Streams is the wheel on the engine.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":23,"uid":"8c3cf684-f8f8-4d9b-b474-7c2636ec966f","type":"panel","x":10,"y":232,"w":1260,"h":460,"groupId":0,"props":{"labelText":"While It Cranks","layoutMode":"0","padding":"0","children":"[{\"id\":24,\"uid\":\"c32a750d-2610-45a7-832d-de1d50e478fb\",\"type\":\"livegraph\",\"x\":10,\"y\":10,\"w\":1240,\"h\":300,\"groupId\":0,\"props\":{\"lines\":\"rpm,0,8000,0,0,0\\nsync_level,0,2,0,0,0\\ntrigger_error_pct,0,100,0,0,0\",\"showLegend\":\"1\",\"displayUnit\":\"Auto\",\"