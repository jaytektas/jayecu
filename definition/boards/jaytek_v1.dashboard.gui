\":90,\"h\":30,\"groupId\":0,\"props\":{\"labelText\":\"Stop\",\"command\":\"test 28 0 0 0\"}},{\"id\":103,\"uid\":\"67f3acf2-1bcd-4d40-a217-db9b4f9c3c85\",\"type\":\"command\",\"x\":236,\"y\":110,\"w\":110,\"h\":30,\"groupId\":0,\"props\":{\"labelText\":\"Stop All\",\"command\":\"test 255 0 0 0\"}},{\"id\":104,\"uid\":\"0c755c9d-175b-4d5e-a9c2-2100a7b0a44a\",\"type\":\"label\",\"x\":10,\"y\":146,\"w\":390,\"h\":80,\"groupId\":0,\"props\":{\"labelText\":\"Engine stopped only; a start cancels it, and the ECU ends the test itself. What happens comes from the Function above \\u2014 a coil dwells then releases, an injector pulses, anything else is held on. On Time is used as given: mind the dwell on a coil.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"outputs.output[28]"},"Configuration/Electrical/Outputs/LS17/Frequency":{"uid":"7005d856-5610-4715-ba03-5231ec7d01fa","canvasWidth":980,"canvasHeight":444,"minWidth":980,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Frequency","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"bdf8b3c0-17cc-4906-9be6-a25e8936cfc3","type":"label","x":10,"y":4,"w":956,"h":24,"groupId":0,"props":{"labelText":"How fast this output is chopped. A fixed frequency, an expression, or a table it names — the duty is on the output's own page; this is only the carrier.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"21f4233b-aa0a-4829-87a8-7ac81a2ec94c","type":"panel","x":10,"y":30,"w":470,"h":168,"groupId":0,"props":{"labelText":"Carrier","layoutMode":"0","padding":"0","children":"[{\"id\":3,\"uid\":\"e0fced16-5ae6-4b03-85c2-682b7a5dd9f9\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":240,\"h\":20,\"groupId\":2,\"props\":{\"labelText\":\"Frequency From\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":4,\"uid\":\"f3f8d9d2-c087-4e1f-9c36-2d2ab9ab9f97\",\"type\":\"combobox\",\"x\":256,\"y\":12,\"w\":190,\"h\":30,\"groupId\":2,\"props\":{\"signalName\":\"outputs.output[*].freq_source\"}},{\"id\":5,\"uid\":\"2e5cbf1a-4636-4025-bdce-395198c23978\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":330,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Fixed Frequency\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 0\"}},{\"id\":6,\"uid\":\"80d40fe9-8924-4ab6-b7bc-778dbf09f132\",\"type\":\"configedit\",\"x\":346,\"y\":42,\"w\":100,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"outputs.output[*].pwm_freq_hz\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 0\"}},{\"id\":7,\"uid\":\"c42e98b1-cb04-47d6-b004-60d1818a8849\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":180,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Frequency Table\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 1\"}},{\"id\":8,\"uid\":\"83eee1e6-f933-4b44-9902-f474ce91366e\",\"type\":\"enum\",\"x\":196,\"y\":72,\"w\":250,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"outputs.output[*].freq_table_sel\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 1\"}},{\"id\":9,\"uid\":\"c90a2050-3b96-4bc4-8849-9382b8b6c480\",\"type\":\"label\",\"x\":10,\"y\":108,\"w\":110,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Expression\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 2\"}},{\"id\":10,\"uid\":\"328fc0a9-3f82-4fd2-b608-440ae0c6dcea\",\"type\":\"expression\",\"x\":124,\"y\":104,\"w\":336,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"outputs.output[*].freq_expr\",\"enableC