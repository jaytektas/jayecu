enableCondition\\\":\\\"[#pit_limiter.enabled] == 1\\\"}}]\"}}]"}}]},"Configuration/Vehicle Functions/Cruise Control":{"uid":"02e8c6d4-6fe9-4163-a7e8-0def7911397e","canvasWidth":1280,"canvasHeight":594,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Cruise Control","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"557f7e85-7604-412b-90b0-9ba60a834deb","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"cruise_control.enabled"}},{"id":2,"uid":"f8e4dde2-2b73-4d72-8c03-b5d30d0a280d","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"959af98c-2b53-4831-80b9-99044bf400fb","type":"label","x":136,"y":4,"w":864,"h":40,"groupId":0,"props":{"labelText":"Holds a road speed by asking the throttle for it — as a floor UNDER the pedal, so pressing harder always wins. What each stalk button MEANS is a condition you write, so one button can carry several meanings.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"6343acb1-60d3-416f-a98e-db0861bf5c35","type":"panel","x":10,"y":46,"w":620,"h":344,"groupId":0,"props":{"labelText":"What presses it","layoutMode":"0","padding":"0","children":"[{\"id\":5,\"uid\":\"cfebcb96-c0e3-436c-a523-1472c75edbae\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":150,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Enable When\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":6,\"uid\":\"d8cde41a-f5b9-4cb4-8274-2e96213b5899\",\"type\":\"expression\",\"x\":166,\"y\":12,\"w\":380,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"cruise_control.enable_expr\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":7,\"uid\":\"d93778b7-c688-4a69-ba2c-412cd62ad1a5\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":150,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Disable When\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":8,\"uid\":\"c38c193d-eaf5-4c30-abf0-7e04ba254c02\",\"type\":\"expression\",\"x\":166,\"y\":42,\"w\":380,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"cruise_control.disable_expr\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":9,\"uid\":\"c8d1cd14-fdaf-4330-b119-182f70c8043b\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":150,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Enable/Disable When\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":10,\"uid\":\"5a2a81d4-c9a2-452a-9bf8-9acf4b0c9334\",\"type\":\"expression\",\"x\":166,\"y\":72,\"w\":380,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"cruise_control.enable_disable_expr\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":11,\"uid\":\"1265a0bb-c6cf-4396-a6ba-7815ff4bba22\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":150,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Set When\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":12,\"uid\":\"79291a04-69b8-4c36-8598-866222ada551\",\"type\":\"expression\",\"x\":166,\"y\":102,\"w\":380,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"cruise_control.set_expr\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":13,\"uid\":\"dc25214f-8e44-4f01-917b-66fe9c96d604\",\"type\":\"label\",\"x\":10,\"y\":136,\"w\":150,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"Resume When\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":14,\"uid\":\"dd18d583-223c-49a9-8b41-df5c569c103c\",\"type\":\"expression\",\"x\":166,\"y\":132,\"w\":380,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"cruise_control.resume_expr\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":15,\"uid\":\"b881abfc-fb0c-4c07-8076-7fd72fe11f2e\",\"type\":\"label\",\"x\":10,\"y\":166,\"w\":150,\"h\":20,\"groupId\":8,\"props\":{\"labelText\":\"Cancel When\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":16,\"uid\":\"09de532f-7685-4211-81dd-6e10d99f1dac\",\"type\":\"expression\",\"x\":166,\"y\":162,\"w\":380,\"h\":30,\"groupId\":8,\"props\":{\"signalName\":\"cruise_control.cancel_expr\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":17,\"uid\":\"ae61bc38-2eb7-410a-aa0d-5de06d4a81e0\",\"type\":\"label\",\"x\":10,\"y\":196,\"w\":150,\"h\":20,\"groupId\":9,\"props\":{\"labelText\":\"Speed Up When\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":18,\"uid\":\"8dfdfca7-a269-459b-b269-7863e23010b1\",\"type\":\"expression\",\"x\":166,\"y\":192,\"w\":380,\"h\":30,\"groupId\":9,\"props\":{\"signalName\":\"cruise_control.bump_up_expr\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":19,\"uid\":\"d2ae067d-17b6-4a74-bd57-8c7ddeab9526\",\"type\":\"label\",\"x\":10,\"y\":226,\"w\":150,\"h\":20,\"groupId\":10,\"props\":{\"labelText\":\"Speed Down When\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":20,\"uid\":\"dc5f655f-85c5-444c-b8d5-e4c59e6d6da9\",\"type\":\"expression\",\"x\":166,\"y\":222,\"w\":380,\"h\":30,\"groupId\":10,\"props\":{\"signalName\":\"cruise_control.bump_down_expr\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":21,\"uid\":\"4a6785f9-f688-426b-bae4-66fe512c9e76\",\"type\":\"label\",\"x\":10,\"y\":256,\"w\":150,\"h\":20,\"groupId\":11,\"props\":{\"labelText\":\"Long Press Time\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":22,\"uid\":\"ce4bbc02-f7e2-4dc1-8bcc-fc1f17d073c0\",\"type\":\"configedit\",\"x\":166,\"y\":252,\"w\":115,\"h\":30,\"groupId\":11,\"props\":{\"signalName\":\"cruise_control.long_press_ms\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":23,\"uid\":\"b8933342-e318-465a-b8f3-9fe1f8b41314\",\"type\":\"label\",\"x\":10,\"y\":286,\"w\":150,\"h\":20,\"groupId\":12,\"props\":{\"labelText\":\"State At Power-On\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}},{\"id\":24,\"uid\":\"02cf58db-8aef-426f-817f-08b7cdd27c3f\",\"type\":\"combobox\",\"x\":166,\"y\":282,\"w\":190,\"h\":30,\"groupId\":12,\"props\":{\"signalName\":\"cruise_control.power_on_state\",\"enableCondition\":\"[#cruise_control.enabled] == 1\"}}]"}},{"id":25,"uid":"b6442f06-eb73-41e0-af29-4de7384a8f40","type":"panel","x":640,"y":46,"w":620,"h":344,"groupId":0,"props":{"labelText":"How a press is read","layoutMode":"0","padding":"0","children":"[{\"id\":26,\"uid\":\"ba3f74b1-7690-4321-9d4e-4c56e319deb0\",\"type\":\"label\",\"x\":10,\"y\":12,\"w\":600,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"A tap is acted on when the button is RELEASED, and a press held past the Long Press Time is a hold instead \\u2014 which is what stops one press from being both. Only Speed Up and Speed Down have a hold meaning: tapped they move the set speed one increment, held they ramp it continuously.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":27,\"uid\":\"0a05026c-c154-4aa5-931d-db31de28a40c\",\"type\":\"label\",\"x\":10,\"y\":84,\"w\":600,\"h\":80,\"groupId\":0,\"props\":{\"labelText\":\"Each condition is an expression over any channel \\u2014 `cruise_sw == 2` for a stalk position, a plain switch, a CAN flag, or a rule with more in it. A button that means several things simply appears in several of them: put the same position in Set When and Speed Down When and you have described a Set/Coast button exactly.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":28,\"uid\":\"fa8fabad-d8fb-40b0-9583-7ef0cb630976\",\"type\":\"label\",\"x\":10,\"y\":174,\"w\":600,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"A condition whose inputs cannot be trusted reads FALSE, so a stalk that has lost its calibration cannot engage cruise. That is also why the brake and clutch are NOT conditions \\u2014 see the Limits page.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":29,"uid":"77a5ee7b-ee4a-41b9-9ea8-14e3b0852d46","type":"panel","x":10,"y":400,"w":620,"h":184,"groupId":0,"props":{"labelText":"The rest of it","layoutMode":"0","padding":"0","children":"[{\"id\":30,\"uid\":\"fa06ae8a-de36-4f40-a76f-561b573b79e2\",\"type\":\"label\",\"x\":10,\"y\":10,\"w\":570,\"h\":20,\"groupId\":13,\"props\":{\"labelText\":\"Limits\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Vehicle Functions/Cruise Control/Limits\"}},{\"id\":31,\"uid\":\"c0fbb053-c8ee-48a2-98a8-a024a8fc9573\",\"type\":\"label\",\"x\":10,\"y\":38,\"w\":570,\"h\":20,\"groupId\":14,\"props\":{\"labelText\":\"Tuning\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Vehicle Functions/Cruise Control/Tuning\"}},{\"id\":32,\"uid\":\"4432d550-054c-4950-ad70-84a232b53fe0\",\"type\":\"label\",\"x\":10,\"y\":66,\"w\":570,\"h\":20,\"groupId\":15,\"props\":{\"labelText\":\"Proportional Gain\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Vehicle Functions/Cruise Control/Proportional Gain\"}},{\"id\":33,\"uid\":\"20db6050-21eb-4fff-82f1-e4235059fe49\",\"type\":\"label\",\"x\":10,\"y\":94,\"w\":570,\"h\":20,\"groupId\":16,\"props\":{\"labelText\":\"Integral Gain\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Vehicle Functions/Cruise Control/Integral Gain\"}},{\"id\":34,\"uid\":\"e1bbbe85-7ff7-49f2-b89f-e0c2257b8724\",\"type\":\"label\",\"x\":10,\"y\":122,\"w\":570,\"h\":20,\"groupId\":17,\"props\":{\"labelText\":