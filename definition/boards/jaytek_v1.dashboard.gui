s  (4 checks)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Sensors/Engine/Accelerator Pedal 2/Diagnostics\"}},{\"id\":29,\"uid\":\"c5582f52-db15-464e-a8e6-9e2d6c81cc02\",\"type\":\"label\",\"x\":10,\"y\":342,\"w\":284,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"What this input must complain about, when, and with which code.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[app_2]"},"Configuration/Sensors/Engine/Accelerator Pedal 2/Diagnostics":{"uid":"49ad7c3d-ea94-40da-9942-3d0ebf49e6b8","canvasWidth":1280,"canvasHeight":336,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Accelerator Pedal 2 — Diagnostics","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"94007880-302a-4225-a4bd-d97c5572e025","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"sensors.sensor[*].enabled"}},{"id":2,"uid":"3ccc72ae-4f49-4e08-845e-47c0887ec765","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"5f0c7ef0-f9ec-457d-9fb0-a306ddd24026","type":"label","x":136,"y":4,"w":864,"h":24,"groupId":0,"props":{"labelText":"What this input must complain about — and with which code. A check with no code is one this sensor cannot report, and is not offered.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"32108634-342c-4876-b539-055be50d2c71","type":"panel","x":10,"y":30,"w":1260,"h":296,"groupId":0,"props":{"labelText":"Checks","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":5,\"uid\":\"c915c665-849f-4ce7-8f05-316f105ced19\",\"type\":\"label\",\"x\":34,\"y\":6,\"w\":200,\"h\