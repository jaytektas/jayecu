gnalName\":\"sensors.sensor[*].diag_op_max\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":33,\"uid\":\"0dfecaa1-04eb-441d-9e63-de40d8f3f514\",\"type\":\"enum\",\"x\":346,\"y\":216,\"w\":110,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.op_max\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":34,\"uid\":\"37ef2183-6427-47cd-944d-4b095160294a\",\"type\":\"label\",\"x\":462,\"y\":220,\"w\":60,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"P103B\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":35,\"uid\":\"bc8ec53f-661b-4864-ac2b-e634e8505c96\",\"type\":\"label\",\"x\":34,\"y\":241,\"w\":515,\"h\":16,\"groupId\":6,\"props\":{\"labelText\":\"The calibrated reading is above what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":36,\"uid\":\"43407d7a-95ae-4c55-b7b5-85e0ad06cd1e\",\"type\":\"label\",\"x\":560,\"y\":38,\"w\":140,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"DTC Delay\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":37,\"uid\":\"ff559b5e-bfeb-4b21-921d-cd67912adeba\",\"type\":\"configedit\",\"x\":706,\"y\":34,\"w\":123,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"sensors.sensor[*].diag_delay_ms\"}},{\"id\":38,\"uid\":\"910bf9c6-8816-45a1-b0b9-9145dab9ae7f\",\"type\":\"label\",\"x\":560,\"y\":68,\"w\":400,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"How long a check has to keep failing before it becomes a fault. A sensor that blips once on a starter crank is not a broken sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":39,\"uid\":\"15385c18-ecef-4f52-a1da-6c623f75c3fd\",\"type\":\"label\",\"x\":560,\"y\":110,\"w\":400,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Precondition\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":40,\"uid\":\"78824e64-6bc4-49ef-bacf-a1a36fdfc723\",\"type\":\"expression\",\"x\":560,\"y\":132,\"w\":400,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].precond_expr\"}},{\"id\":41,\"uid\":\"0c8127d0-7483-49a2-92a6-c1fdc05db7e9\",\"type\":\"label\",\"x\":560,\"y\":164,\"w\":400,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"The plausibility checks only run while this holds \\u2014 an oil pressure of zero is a fault at 3000 rpm and the truth with the engine stopped.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":42,\"uid\":\"e605efa2-cee9-4de2-8d3a-d0151801042d\",\"type\":\"label\",\"x\":990,\"y\":34,\"w\":250,\"h\":170,\"groupId\":0,\"props\":{\"labelText\":\"The electrical pair tests the RAW input in the input's own units, before calibration; the plausibility pair tests the calibrated reading. Severity is what the DTC records and what the protection levels read. A check with no code is one this sensor cannot report, and is not offered \\u2014 which is why two sensors show different rows here.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[lambda_7]"},"Configuration/Sensors/O2 & Lambda/Wideband O2 8":{"uid":"0b2ad8a1-7b98-47d4-a464-abdaef40010e","canvasWidth":1280,"canvasHeight":700,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Wideband O2 8","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"a8271bf1-78dc-4183-bf19-aa824bf26653","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"sensors.sensor[*].enabled"}},{"id":2,"uid":"01e629e5-cfd8-4d52-9df9-7c3b68b38416","type":"label","x":40,"y":5,"w":90,"h":20,"gro