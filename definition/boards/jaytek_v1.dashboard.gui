73ad\",\"type\":\"expression\",\"x\":56,\"y\":314,\"w\":560,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"engine_protection.threshold_monitors[6].condition\"}},{\"id\":34,\"uid\":\"05eb5a24-c240-4330-9ede-46149c8d5510\",\"type\":\"combobox\",\"x\":626,\"y\":316,\"w\":200,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"engine_protection.threshold_monitors[6].action\",\"enableCondition\":\"[#engine_protection.threshold_monitors[6].condition] > 0\"}},{\"id\":35,\"uid\":\"fa4a79b3-fc26-48d6-baa6-abe0c82a980c\",\"type\":\"indicator\",\"x\":836,\"y\":316,\"w\":44,\"h\":26,\"groupId\":0,\"props\":{\"signalName\":\"bit([$monitor_flags], 6)\",\"onTitle\":\"!\",\"offTitle\":\"\",\"onBg\":\"#ff453a\",\"onFg\":\"#000000\",\"offBg\":\"#2a2a2e\",\"offFg\":\"#6e7178\",\"fontName\":\"|15|0|0\"}},{\"id\":36,\"uid\":\"e086e4c5-ae82-404f-a386-b3e9636ab543\",\"type\":\"label\",\"x\":10,\"y\":364,\"w\":40,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"8\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":37,\"uid\":\"8f1f9c90-009d-4230-9cfd-5600ebb1b4af\",\"type\":\"expression\",\"x\":56,\"y\":360,\"w\":560,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"engine_protection.threshold_monitors[7].condition\"}},{\"id\":38,\"uid\":\"55687bab-8761-45ee-bb3f-1936376ffd74\",\"type\":\"combobox\",\"x\":626,\"y\":362,\"w\":200,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"engine_protection.threshold_monitors[7].action\",\"enableCondition\":\"[#engine_protection.threshold_monitors[7].condition] > 0\"}},{\"id\":39,\"uid\":\"91773924-16d3-478b-8f2d-1f1412d9c581\",\"type\":\"indicator\",\"x\":836,\"y\":362,\"w\":44,\"h\":26,\"groupId\":0,\"props\":{\"signalName\":\"bit([$monitor_flags], 7)\",\"onTitle\":\"!\",\"offTitle\":\"\",\"onBg\":\"#ff453a\",\"onFg\":\"#000000\",\"offBg\":\"#2a2a2e\",\"offFg\":\"#6e7178\",\"fontName\":\"|15|0|0\"}}]"}},{"id":40,"uid":"d7d9b218-18bc-4fd7-aaff-d44d674fa1af","type":"panel","x":920,"y":46,"w":350,"h":470,"groupId":0,"props":{"labelText":"Writing One","layoutMode":"0","padding":"0","children":"[{\"id\":41,\"uid\":\"5b620e66-4124-4db4-8aaf-dec73ec0f767\",\"type\":\"label\",\"x\":10,\"y\":10,\"w\":330,\"h\":386,\"groupId\":0,\"props\":{\"labelText\":\"Write what SHOULD NOT be true. \\\"oil_pressure < 100 and rpm > 2000\\\" is a pressure limit that only applies while the engine is turning \\u2014 which the low/high pair this replaces could not say at all. Channels, config settings, arithmetic between two channels, bits of a status word, and age(signal) for \\\"this one went quiet\\\" are all fair game.\\n\\nRECORD ONLY is worth using first: it sets the slot's flag and nothing else, so the condition can be proven right before it is given authority to stop the engine. The Trip lamp beside each row is that flag.\\n\\nThere is no debounce. The VM is stateless by design \\u2014 no timers, no latches \\u2014 so a condition true for one frame cuts for one frame, and a noisy signal wants margin in the condition rather than a tighter limit.\\n\\nA condition that cannot be evaluated is DISARMED and raises a config fault: a protection whose question is broken must not be allowed to answer \\\"cut\\\".\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":42,\"uid\":\"ffc1862d-3c62-44fc-967b-1de1eabf9a48\",\"type\":\"label\",\"x\":10,\"y\":404,\"w\":330,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Engine Protection\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Protection/Engine Protection\"}}]"}}]},"Configuration/Protection/Lambda Protection":{"uid":"220d34a9-de5c-4f0c-8fa8-4eb110104ae7","canvasWidth":1280,"canvasHeight":694,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Lambda Protection","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"f5ff3cf6-fd00-43a3-9ca1-12b5fe88b11b","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"lambda_protect.enabled"}},{"id":2,"uid":"fc188b1a-e23c-4753-baaf-9de8b2c23fcc","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"9b606bfc-59f9-4ae5-8db6-b0f8cdd70ace","type":"label","x":136,"y":4,"w":613,"h":24,"groupId":0,"props":{"labelText":"Cuts if the mixture stays leaner than a limit under load — the last line before a hole in a piston.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"f9fac992-ca37-4a57-aa5c-faf8dd657ced","type":"panel","x":10,"y":30,"w":400,"h":160,"groupId":0,"props":{"labelText":"Trip","layoutMode":"0","padding":"0","children":"[{\"id\":5,\"uid\":\"9d5279e5-3038-458f-b546-c295ce50334c\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":250,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Lean Limit (lambda)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#lambda_protect.enabled] == 1\"}},{\"id\":6,\"uid\":\"8a88fe91-7fe7-4be3-88ea-5d581b6ede69\",\"type\":\"configedit\",\"x\":266,\"y\":12,\"w\":110,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"lambda_protect.max_lambda\",\"enableCondition\":\"[#lambda_protect.enabled] == 1\"}},{\"id\":7,\"uid\":\"b061d96c-b005-483f-b98d-b84fc7e1fd5b\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":250,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Monitor Above TPS\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#lambda_protect.enabled] == 1\"}},{\"id\":8,\"uid\":\"2c0e9ab8-18c0-4c73-b07a-e7082833f533\",\"type\":\"configedit\",\"x\":266,\"y\":72,\"w\":110,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"lambda_protect.min_tps\",\"enableCondition\":\"[#lambda_protect.enabled] == 1\"}},{\"id\":9,\"uid\":\"43ea0a7f-2aac-402a-a72d-062ceb913c3f\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":226,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Monitor Above RPM\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#lambda_protect.enabled] == 1\"}},{\"id\":10,\"uid\":\"0897003a-8374-4fc6-a72f-945dd145e28c\",\"type\":\"configedit\",\"x\":242,\"y\":102,\"w\":134,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"lambda_protect.min_rpm\",\"enableCondition\":\"[#lambda_protect.enabled] == 1\"}},{\"id\":25,\"uid\":\"0ef3219f-04da-4286-9727-014c6c411ca3\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":250,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Lean Margin vs Target\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#lambda_protect.enabled] == 1\"}},{\"id\":26,\"uid\":\"a960961d-e033-4a96-9d42-0f0e3af6124f\",\"type\":\"configedit\",\"x\":266,\"y\":42,\"w\":110,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"lambda_protect.lean_margin_pct\",\"enableCondition\":\"[#lambda_protect.enabled] == 1\"}}]"}},{"id":11,"uid":"99687cb9-c61e-47b5-89f7-2381187e1695","type":"panel","x":420,"y":30,"w":400,"h":70,"groupId":0,"props":{"labelText":"Timing","layoutMode":"0","padding":"0","children":"[{\"id\":12,\"uid\":\"4179fcd8-41dc-4d68-90ac-7e8cb4f99c8a\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":245,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Lean Timeout\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#lambda_protect.enabled] == 1\"}},{\"id\":13,\"uid\":\"cd1a3f31-6a1f-4b24-9f74-50e52fcd348c\",\"type\":\"configedit\",\"x\":261,\"y\":12,\"w\":115,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"lambda_protect.timeout_ms\",\"enableCondition\":\"[#lambda_protect.enabled] == 1\"}}]"}},{"id":14,"uid":"752465ba-f109-4cc1-97e0-b270ba94da7d","type":"panel","x":10,"y":594,"w":1260,"h":90,"groupId":0,"props":{"labelText":"Live","layoutMode":"0","padding":"0","children":"[{\"id\":15,\"uid\":\"a66dabb6-a662-41e0-a93b-5b5592df1bc1\",\"type\":\"value\",\"x\":14,\"y\":12,\"w\":140,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"lambda_protect_active\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":16,\"uid\":\"42621bd9-c043-483f-8914-b88aea43e4f0\",\"type\":\"label\",\"x\":14,\"y\":42,\"w\":140,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"Protection Cut\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":17,\"uid\":\"dacfabaa-0cce-43e9-8103-7295d039fce0\",\"type\":\"value\",\"x\":164,\"y\":12,\"w\":140,\"h\":30,\"groupId\":8,\"props\":{\"signalName\":\"lambda_1\",\"format\":\"%.2f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":18,\"uid\":\"6812d83d-559f-4a46-88b5-398e6e7eeeca\",\"type\":\"label\",\"x\":164,\"y\":42,\"w\":140,\"h\":20,\"groupId\":8,\"props\":{\"labelText\":\"Lambda\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":19,\"uid\":\"5fcaf098-6e19-4a2b-9212-56cfc519906f\",\"type\":\"value\",\"x\":314,\"y\":12,\"w\":140,\"h\":30,\"groupId\":9,\"props\":{\"signalName\":\"lambda_target\",\"format\":\"%.2f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":20,\"uid\":\"0f0240f2-264b-437b-a0bc-333393085428\",\"type\":\"label\",\"x\":314,\"y\":42,\"w\":140,\"h\":20,\"groupId\":9,\"props\":{\"labelText\":\"Target\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":21,\"uid\":\"8937b6e0-8a90-45b4-92b2-9f68e329b2d3\",\"type\":\"value\",\"x\":464,\"y\":12,\"w\":140,\"h\":30,\"groupId\":10,\"props\":{\"signalName\":\"rpm\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":22,\"uid\":\"4c517e45-8a28-47b1-81df-9739f0cbf2f0\",\"type\":\"label\",\"x\":464,\"y\":42,\"w\":140,\"h\":20,\"groupId\":10,\"props\":{\"labelText\":\"Engine RPM\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"31441054-aa2a-4366-8eeb-f268425c55d7\",\"type\":\"value\",\"x\":614,\"y\":12,\"w\":140,\"h\":30,\"groupId\":11,\"props\":{\"signalName\":\"tps\",\"format\":\"%.1f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":24,\"uid\":\"fd6ce140-62e7-49b8-958c-dae85be44409\",\"type\":\"label\",\"x\":614,\"y\":42,\"w\":140,\"h\":20,\"groupId\":11,\"props\":{\"labelText\":\"Throttle\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}}]"}}]},"Configuration/Protection/Misfire Detection":{"uid":"7b177da7-c2e4-471e-986c-3fe00f644c79","canvasWidth":1280,"canvasHeight":690,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Misfire Detection","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"25e5e8f9-fb00-4721-a0ed-5bb9cd471261","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"misfire.enabled"}},{"id":2,"uid":"4c05455e-50c9-42cc-bebf-f2b73e279a17","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"78b98b48-c586-457e-98de-062fed6957c6","type":"label","x":136,"y":4,"w":864,"h":40,"groupId":0,"props":{"labelText":"A cylinder that does not fire makes its crank segment take longer than its neighbours. This is the arithmetic that turns that into a fault code — and, if you let it, into a fuel cut.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"c51d59f5-7372-48c0-a304-fcfba349a452","type":"panel","x":10,"y":46,"w":400,"h":134,"groupId":0,"props":{"labelText":"Detecting","layoutMode":"0","padding":"0","enableCondition":"[#misfire.enabled] == 1","children":"[{\"id\":5,\"uid\":\"c7a2dd05-cd08-4cee-8de6-92a1058c2ce7\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":150,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Threshold\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":6,\"uid\":\"2c904975-e304-45bc-b11b-fc95960c4e23\",\"type\":\"configedit\",\"x\":166,\"y\":12,\"w\":108,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"misfire.threshold_pct\"}},{\"id\":7,\"uid\":\"218ef31e-753a-433a-bc6f-38ce98ebdba0\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":150,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Min RPM\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":8,\"uid\":\"42ef2800-2984-42ff-a209-1d9710b07848\",\"type\":\"configedit\",\"x\":166,\"y\":42,\"w\":134,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"misfire.min_rpm\"}},{\"id\":9,\"uid\":\"19b4aee8-4775-410d-a0c6-3f226377f8f7\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":150,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Max RPM\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":10,\"uid\":\"d38514fa-d133-41e5-9403-36e2acb55757\",\"type\":\"configedit\",\"x\":166,\"y\":72,\"w\":134,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"misfire.max_rpm\"}}]"}},{"id":11,"uid":"8965d99a-4422-4947-bf0c-62aae3236c05","type":"label","x":10,"y":186,"w":390,"h":104,"groupId":0,"props":{"labelText":"Threshold is how much longer than the running mean a segment must be to count. The default is a starting point, not a measurement: a real engine's own torsional variation sets the floor, and it is found by watching roughness with the engine healthy. Outside the RPM band nothing is counted — cranking and the top of the range are both too noisy to judge.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":12,"uid":"d7bfef9b-709b-4dad-97f1-7a542c86ccf8","type":"panel","x":10,"y":302,"w":400,"h":134,"groupId":0,"props":{"labelText":"Reporting","layoutMode":"0","padding":"0","enableCondition":"[#misfire.enabled] == 1","children":"[{\"id\":13,\"uid\":\"fd819d32-50ec-45f8-b39b-4f7cfa243ed3\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":150,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Window\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":14,\"uid\":\"cf361b7c-e914-47d8-8c2c-6eab590cce0a\",\"type\":\"configedit\",\"x\":166,\"y\":12,\"w\":142,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"misfire.window_cycles\"}},{\"id\":15,\"uid\":\"e6716ddf-a88b-40db-a9da-f5ff0f4808ba\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":150,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"Events Before DTC\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":16,\"uid\":\"8cb250ad-e797-48b6-8344-e33c439b70fc\",\"type\":\"configedit\",\"x\":166,\"y\":42,\"w\":100,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"misfire.events_to_dtc\"}},{\"id\":17,\"uid\":\"b36fe3ad-f846-4723-aefc-27b18de55275\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":150,\"h\":20,\"groupId\":8,\"props\":{\"labelText\":\"Cylinders for P0300\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":18,\"uid\":\"88321e87-3066-4b17-aa32-98fb5fa94ef5\",\"type\":\"configedit\",\"x\":166,\"y\":72,\"w\":100,\"h\":30,\"groupId\":8,\"props\":{\"signalName\":\"misfire.multi_cyl_for_p0300\"}}]"}},{"id":19,"uid":"7a6fac82-6398-41f9-9079-e33759337f79","type":"label","x":10,"y":442,"w":390,"h":104,"groupId":0,"props":{"labelText":"One bad cycle is not a fault: a cylinder needs that many events inside the window before its own P030x is raised, and when several cylinders are over threshold at once the code becomes P0300 — random/multiple — instead of a list of individual ones. The OBD monitors this mirrors use 200- and 1000-revolution windows for the same job.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":20,"uid":"3ba15d57-6a6e-4218-a123-1183fb9599c4","type":"panel","x":420,"y":46,"w":420,"h":134,"groupId":0,"props":{"labelText":"Segment Correction","layoutMode":"0","padding":"0","enableCondition":"[#misfire.enabled] == 1","children":"[{\"id\":21,\"uid\":\"4569cb4d-f47b-4be0-8b82-f5bb25029c0e\",\"type\":\"checkbox\",\"x\":10,\"y\":12,\"w\":22,\"h\":22,\"groupId\":9,\"props\":{\"signalName\":\"misfire.learn_enabled\"}},{\"id\":22,\"uid\":\"0dc7c3aa-2b39-4990-ae2c-bf641bb03f3e\",\"type\":\"label\",\"x\":40,\"y\":9,\"w\":220,\"h\":20,\"groupId\":9,\"props\":{\"labelText\":\"Learn on overrun\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":23,\"uid\":\"832b64c8-345e-4bb1-9494-d57965c7cf38\",\"type\":\"label\",\"x\":10,\"y\":54,\"w\":150,\"h\":20,\"groupId\":10,\"props\":{\"labelText\":\"Learn Rate\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":24,\"uid\":\"2b4fde24-9c19-4df1-b3a5-d74d7909d6b2\",\"type\":\"configedit\",\"x\":166,\"y\":50,\"w\":100,\"h\":30,\"groupId\":10,\"props\":{\"signalName\":\"misfire.learn_rate\"}}]"}},{"id":25,"uid":"c2b90fa7-d5cd-48a0-8bf3-02866198ed6e","type":"label","x":420,"y":186,"w":410,"h":120,"groupId":0,"props":{"labelText":"A trigger wheel is never perfect, and a narrow tooth makes one cylinder's segment permanently long — which reads as a cylinder that always misfires. So the correction is LEARNED during overrun fuel cut, when nothing is firing and every segment should be identical. The twelve learned trims live in RAM and are persisted to SD: they are a property of this engine's wheel, not part of the tune, and they do not travel with it.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":26,"uid":"19d00e7d-4140-489c-9a90-527a51f026af","type":"panel","x":420,"y":316,"w":420,"h":170,"groupId":0,"props":{"labelText":"Acting On It","layoutMode":"0","padding":"0","enableCondition":"[#misfire.enabled] == 1","children":"[{\"id\":27,\"uid\":\"f8599057-ab56-4aad-97c4-99b5db799a95\",\"type\":\"checkbox\",\"x\":10,\"y\":12,\"w\":22,\"h\":22,\"groupId\":11,\"props\":{\"signalName\":\"misfire.cut_fuel\"}},{\"id\":28,\"uid\":\"9d312da3-bae5-4448-a223-63e81b1e9300\",\"type\":\"label\",\"x\":40,\"y\":9,\"w\":220,\"h\":20,\"groupId\":11,\"props\":{\"labelText\":\"Cut fuel to a dead cylinder\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":29,\"uid\":\"cb165f01-f3c1-4a21-aa12-2a929f09d85c\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":400,\"h\":98,\"groupId\":0,\"props\":{\"labelText\":\"Raw fuel through a dead cylinder goes into the catalyst and destroys it, so cutting the injector protects the exhaust. It is off by default because it is a decision about the engine rather than a diagnostic one: a cylinder cut on a false positive is a cylinder you have switched off.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":30,"uid":"151bb59a-4caf-4240-b99f-7ae5e9f31eaf","type":"panel","x":420,"y":490,"w":420,"h":190,"groupId":0,"props":{"labelText":"Learned Segment Trim  (per cylinder)","layoutMode":"0","padding":"0","enableCondition":"[#misfire.enabled] == 1","children":"[{\"id\":31,\"uid\":\"e242fa73-9cc7-4f01-be07-464c28469fd7\",\"type\":\"label\",\"x\":10,\"y\":12,\"w\":60,\"h\":20,\"groupId\":12,\"props\":{\"labelText\":\"Cyl 1\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"condition\":\"[#engine.cylinder_count] >= 1\"}},{\"id\":32,\"uid\":\"6dce8309-730b-48e0-9061-5c1f45cc45b3\",\"type\":\"value\",\"x\":72,\"y\":8,\"w\":110,\"h\":30,\"groupId\":12,\"props\":{\"signalName\":\"misfire.misfire_seg_1\",\"format\":\"%.2f\",\"align\":\"Right\",\"showUnit\":\"0\",\"fontName\":\"|16|0|0\",\"borderWidth\":\"1\",\"borderRadius\":\"3\",\"condition\":\"[#engine.cylinder_count] >= 1\"}},{\"id\":33,\"uid\":\"28ac5010-5582-4c07-a02e-b21e29d360e8\",\"type\":\"label\",\"x\":10,\"y\":37,\"w\":60,\"h\":20,\"groupId\":13,\"props\":{\"labelText\":\"Cyl 2\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"condition\":\"[#engine.cylinder_count] >= 2\"}},{\"id\":34,\"uid\":\"86612f80-a301-4c84-ac39-865f3293a2c2\",\"type\":\"value\",\"x\":72,\"y\":33,\"w\":110,\"h\":30,\"groupId\":13,\"props\":{\"signalName\":\"misfire.misfire_seg_2\",\"format\":\"%.2f\",\"align\":\"Right\",\"showUnit\":\"0\",\"fontName\":\"|16|0|0\",\"borderWidth\":\"1\",\"borderRadius\":\"3\",\"condition\":\"[#engine.cylinder_count] >= 2\"}},{\"id\":35,\"uid\":\"bb12ffb0-52dd-4c1c-ac11-40320e7287c3\",\"type\":\"label\",\"x\":10,\"y\":62,\"w\":60,\"h\":20,\"groupId\":14,\"props\":{\"labelText\":\"Cyl 3\",\"align\"