",\"x\":10,\"y\":132,\"w\":274,\"h\":76,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].source\",\"condition\":\"[#sensors.sensor[*].interface] == 0 || [#sensors.sensor[*].interface] == 1 || [#sensors.sensor[*].interface] == 3 || [#sensors.sensor[*].interface] == 4 || [#sensors.sensor[*].interface] == 6 || [#sensors.sensor[*].interface] == 7\"}},{\"id\":10,\"uid\":\"6885b8bb-090b-482e-bfb9-2e16239d6a57\",\"type\":\"label\",\"x\":10,\"y\":220,\"w\":90,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"CAN Field\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 5\"}},{\"id\":11,\"uid\":\"767a7d7e-77f4-4630-a0f7-9196cf55cba2\",\"type\":\"canfield\",\"x\":106,\"y\":216,\"w\":170,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].can_frame\",\"condition\":\"[#sensors.sensor[*].interface] == 5\"}},{\"id\":12,\"uid\":\"fa591ecc-0ab2-4515-8dea-1ff19c4922f9\",\"type\":\"checkbox\",\"x\":10,\"y\":252,\"w\":22,\"h\":22,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].flags.invert\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":13,\"uid\":\"9c1c5647-564e-45f8-88ae-a58c0bc26fef\",\"type\":\"label\",\"x\":40,\"y\":249,\"w\":220,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Invert  (switch inputs)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":14,\"uid\":\"b9de29bb-c1dc-419a-b85e-60c60460d2c4\",\"type\":\"label\",\"x\":10,\"y\":292,\"w\":274,\"h\":224,\"groupId\":0,\"props\":{\"labelText\":\"Interface says HOW the pin is read, and decides which inputs the picker offers \\u2014 a frequency sensor cannot be wired to an analogue pin. Two sensors on one pin is a fault, not a preference. A CAN sensor has no pin at all: it reads a field defined on the Receive page for its bus, named here by that frame and the field's start bit. A field whose own Signal is set is greyed in the list \\u2014 the frame writes that channel itself, and the sensor publishing it too would put two producers on one channel.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":15,"uid":"f2159e7a-1bf8-4dca-8c58-50915268ad8e","type":"panel","x":320,"y":30,"w":630,"h":662,"groupId":0,"props":{"labelText":"2 · Calibration","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":16,\"uid\":\"0543fee9-71c3-4de3-b321-3e95a2b91e55\",\"type\":\"table\",\"x\":10,\"y\":10,\"w\":600,\"h\":96,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"axisMode\":\"1\",\"displayUnit\":\"Auto\",\"displayUnitX\":\"Auto\",\"displayUnitY\":\"Auto\",\"cellTrace\":\"2\"}},{\"id\":17,\"uid\":\"697b715d-374f-4ff6-ab9a-e7b6a5ff4cff\",\"type\":\"curve\",\"x\":10,\"y\":114,\"w\":600,\"h\":450,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"displayUnit\":\"Auto\",\"axisUnit\":\"Auto\",\"valueUnit\":\"Auto\"}},{\"id\":18,\"uid\":\"f557e3c3-0fd6-4836-9c8f-2b623bcc51cd\",\"type\":\"label\",\"x\":10,\"y\":568,\"w\":600,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"Raw in along the top, reading out underneath. Right-click either for insert, delete, linearise \\u2014 or to save this curve to a file and load it into the next car with the same sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\",\"signalName\":\"sensors.sensor[*].cal\"}},{\"id\":19,\"uid\":\"5927c6d8-ae81-4d1d-84b7-662485048c70\",\"type\":\"bands\",\"x\":10,\"y\":10,\"w\":600,\"h\":616,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\"}}]"}},{"id":20,"uid":"0a1d4d73-be55-4dda-a9f2-1474ccde8953","type":"panel","x":960,"y":30,"w":310,"h":662,"groupId":0,"props":{"labelText":"3 · Output","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":21,\"uid\":\"f3e21624-8938-45d9-8d27-a677a8de9ba9\",\"type\":\"value\",\"x\":12,\"y\":10,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"signalName\":\"[$*]\",\"format\":\"%.2f\",\"fontName\":\"|30|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"4\"}},{\"id\":22,\"uid\":\"01a7e4ac-164a-4740-8b6e-427443e144f9\",\"type\":\"label\",\"x\":12,\"y\":74,\"w\":284,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Reading  (what everything downstream sees)\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"9b8c6d06-4bda-4b95-afc5-8070fffc17db\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":90,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Type\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":24,\"uid\":\"e9d6ef99-0119-4141-895f-c1d48e364a99\",\"type\":\"label\",\"x\":106,\"y\":106,\"w\":190,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Lambda\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":25,\"uid\":\"5a28fe05-ec7e-43fa-abab-43c81c82d38e\",\"type\":\"label\",\"x\":10,\"y\":142,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"This input's type is fixed by the ECU \\u2014 it is what the sensor IS. Only the generic inputs (aux, rotary trim) can be re-typed.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":26,\"uid\":\"e5d00cea-e33b-4589-bbe8-bd5b61b45d86\",\"type\":\"label\",\"x\":10,\"y\":214,\"w\":284,\"h\":98,\"groupId\":0,\"props\":{\"labelText\":\"Input and output are both on screen because a calibration is a claim about how one becomes the other: watch the pair move together and a wrong curve shows itself immediately.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":27,\"uid\":\"e7ccc357-ab4e-4297-9e66-139935e13ad9\",\"type\":\"panel\",\"x\":10,\"y\":308,\"w\":284,\"h\":1,\"groupId\":0,\"props\":{\"bgColor\":\"#8a8f98\",\"padding\":\"0\"}},{\"id\":28,\"uid\":\"39edf563-5d58-49b4-93ef-e98ba231fc79\",\"type\":\"label\",\"x\":10,\"y\":318,\"w\":284,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Diagnostics  (4 checks)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Sensors/O2 & Lambda/Wideband O2 1/Diagnostics\"}},{\"id\":29,\"uid\":\"0d60a4b1-9ec2-402f-976f-1f4e7e41bf31\",\"type\":\"label\",\"x\":10,\"y\":342,\"w\":284,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"What this input must complain about, when, and with which code.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[lambda_1]"},"Configuration/Sensors/O2 & Lambda/Wideband O2 1/Diagnostics":{"uid":"277307e7-92ea-4f3c-af56-d765ffa4a076","canvasWidth":1280,"canvasHeight":336,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Wideband O2 1 — Diagnostics","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"730078ca-10da-47cc-b29f-b6fe97dd9577","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"sensors.sensor[*].enabled"}},{"id":2,"uid":"6cdb089b-812a-435d-a881-70996388df0a","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"b77798b0-d984-4837-b6a2-698e39eac73c","type":"label","x":136,"y":4,"w":864,"h":24,"groupId":0,"props":{"labelText":"What this input must complain about — and with which code. A check with no code is one this sensor cannot report, and is not offered.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"1b6335cf-a4b0-4ed8-95ad-a6d62ab82a47","type":"panel","x":10,"y":30,"w":1260,"h":296,"groupId":0,"props":{"labelText":"Checks","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":5,\"uid\":\"4ad977c5-ff29-4c64-acc9-364979817cd6\",\"type\":\"label\",\"x\":34,\"y\":6,\"w\":200,