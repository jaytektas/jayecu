4,\"y\":127,\"w\":515,\"h\":16,\"groupId\":4,\"props\":{\"labelText\":\"The pin reads above this \\u2014 a short to power, or a missing pull-down.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"cc8c1120-9994-492e-8091-b6029d7c7b6b\",\"type\":\"label\",\"x\":10,\"y\":148,\"w\":500,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Plausibility  (calibrated reading)\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":24,\"uid\":\"1a0d30d7-550b-4823-be77-da64d3e2201b\",\"type\":\"checkbox\",\"x\":10,\"y\":172,\"w\":22,\"h\":22,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.op_min\"}},{\"id\":25,\"uid\":\"b7d6d5af-8118-44ad-be79-42a8ebb07641\",\"type\":\"label\",\"x\":40,\"y\":170,\"w\":194,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Detect Reading Low\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":26,\"uid\":\"0ab1aa63-3466-4dc5-abfd-d8163b76bc2c\",\"type\":\"configedit\",\"x\":240,\"y\":170,\"w\":96,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_op_min\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":27,\"uid\":\"4374f582-7017-440b-9eb7-6a7663b92b0e\",\"type\":\"enum\",\"x\":346,\"y\":170,\"w\":110,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.op_min\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":28,\"uid\":\"52ef0d4c-2060-4594-9125-0166a9930916\",\"type\":\"label\",\"x\":462,\"y\":174,\"w\":60,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"P129A\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":29,\"uid\":\"12b04a3a-7d3e-40a1-84ce-4f7cc3128168\",\"type\":\"label\",\"x\":34,\"y\":195,\"w\":515,\"h\":16,\"groupId\":5,\"props\":{\"labelText\":\"The calibrated reading is below what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":30,\"uid\":\"80ebc6ac-ea3e-4e23-81fa-3670cadbb5a8\",\"type\":\"checkbox\",\"x\":10,\"y\":218,\"w\":22,\"h\":22,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.op_max\"}},{\"id\":31,\"uid\":\"2ef8a0b0-d65e-473f-8a58-edfa3c67bb6e\",\"type\":\"label\",\"x\":40,\"y\":216,\"w\":194,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Detect Reading High\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":32,\"uid\":\"bd1c0ed3-b765-4767-842d-c494b855bfbc\",\"type\":\"configedit\",\"x\":240,\"y\":216,\"w\":96,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_op_max\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":33,\"uid\":\"136e4087-cd8d-4be8-b9be-8691be45a8ca\",\"type\":\"enum\",\"x\":346,\"y\":216,\"w\":110,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.op_max\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":34,\"uid\":\"6f889b70-39e7-425c-b315-fcab7577b328\",\"type\":\"label\",\"x\":462,\"y\":220,\"w\":60,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"P129B\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":35,\"uid\":\"0ec8c181-4521-4255-b52d-f777f96358ec\",\"type\":\"label\",\"x\":34,\"y\":241,\"w\":515,\"h\":16,\"groupId\":6,\"props\":{\"labelText\":\"The calibrated reading is above what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":36,\"uid\":\"85daf766-0d2e-42f4-ad00-87bc5709ec7b\",\"type\":\"label\",\"x\":10,\"y\":262,\"w\":500,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Behaviour\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":37,\"uid\":\"e5dd63f4-dbca-4a0f-ad47-a661851dbd94\",\"type\":\"checkbox\",\"x\":10,\"y\":286,\"w\":22,\"h\":22,\"groupId\":7,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.stuck\"}},{\"id\":38,\"uid\":\"aa72b59b-6a8d-4b7d-8794-b919f4bfac6f\",\"type\":\"label\",\"x\":40,\"y\":284,\"w\":194,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"Detect Stuck\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":39,\"uid\":\"7d875e3b-9ab7-4474-bdf0-bf798b3fcf24\",\"type\":\"configedit\",\"x\":240,\"y\":284,\"w\":96,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"sensors.sensor[*].diag_stuck_ms\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.stuck] == 1\"}},{\"id\":40,\"uid\":\"b9839418-fc1c-48c1-ac8e-14277305e9c4\",\"type\":\"enum\",\"x\":346,\"y\":284,\"w\":110,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.stuck\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.stuck] == 1\"}},{\"id\":41,\"uid\":\"11ff508e-da02-4a24-82c1-7208f7264a0c\",\"type\":\"label\",\"x\":462,\"y\":288,\"w\":60,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"P129C\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.stuck] == 1\"}},{\"id\":42,\"uid\":\"b463d348-2a70-44df-8720-63a73f82c759\",\"type\":\"label\",\"x\":34,\"y\":309,\"w\":515,\"h\":16,\"groupId\":7,\"props\":{\"labelText\":\"The reading has not moved at all for this long \\u2014 a switch input that never changes.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":43,\"uid\":\"35e16a53-c229-4e0e-ad15-e8316ed0d604\",\"type\":\"label\",\"x\":560,\"y\":38,\"w\":140,\"h\":20,\"groupId\":8,\"props\":{\"labelText\":\"DTC Delay\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":44,\"uid\":\"9884ffd5-86ab-42e2-91a6-ab0c09c657d7\",\"type\":\"configedit\",\"x\":706,\"y\":34,\"w\":123,\"h\":30,\"groupId\":8,\"props\":{\"signalName\":\"sensors.sensor[*].diag_delay_ms\"}},{\"id\":45,\"uid\":\"8a536359-4562-467f-8e81-55ba7e5cb99b\",\"type\":\"label\",\"x\":560,\"y\":68,\"w\":400,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"How long a check has to keep failing before it becomes a fault. A sensor that blips once on a starter crank is not a broken sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":46,\"uid\":\"d0982716-2f9c-485f-af95-e3545d12c581\",\"type\":\"label\",\"x\":560,\"y\":110,\"w\":400,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Precondition\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":47,\"uid\":\"b20f6b97-5cdc-4437-82f0-900079dd2aeb\",\"type\":\"expression\",\"x\":560,\"y\":132,\"w\":400,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].precond_expr\"}},{\"id\":48,\"uid\":\"85223904-57cd-41f0-8186-2433a4f147f1\",\"type\":\"label\",\"x\":560,\"y\":164,\"w\":400,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"The plausibility checks only run while this holds \\u2014 an oil pressure of zero is a fault at 3000 rpm and the truth with the engine stopped.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":49,\"uid\":\"dc87e198-6d15-4bc0-86bc-2f612cd8830c\",\"type\":\"label\",\"x\":990,\"y\":34,\"w\":250,\"h\":170,\"groupId\":0,\"props\":{\"labelText\":\"The electrical pair tests the RAW input in the input's own units, before calibration; the plausibility pair tests the calibrated reading. Severity is what the DTC records and what the protection levels read. A check with no code is one this sensor cannot report, and is not offered \\u2014 which is why two sensors show different rows here.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[vehicle_dynamics]"},"Configuration/Sensors/Chassis/Wheelie Bar Pressure":{"uid":"9d79e83b-dd4d-4aa2-a756-0fa0c9b91a3b","canvasWidth":1280,"canvasHeight":700,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Wheelie Bar Pressure","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"ae69bca7-3f0f-4860-998d-2535fd64ebc7","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"sensors.sensor[*].enabled"}},{"id":2,"uid":"c5e8cfe3-ed6c-4611-95e7-9446d3640d85","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"2e989f4f-1bdd-4caf-9fe1-4afd13d16e58","type":"label","x":136,"y":4,"w":379,"h":24,"groupId":0,"props":{"labelText":"What this input is wired to, and what its curve makes of it.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"dd338f36-b05a-4d69-a175-6082a4cd15ef","type":"panel","x":10,"y":30,"w":300,"h":662,"groupId":0,"props":{"labelText":"1 · Input","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":5,\"uid\":\"55a0040b-b40f-4df5-a95f-64cb00442fd6\",\"type\":\"value\",\"x\":12,\"y\":10,\"w\":274,\"h\":54,\"groupId\":0,\"props\":{\"signalName\":\"[$~]\",\"fontName\":\"|26|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"4\"}},{\"id\":6,\"uid\":\"5f80fc9e-f70c-45db-acb6-722c5eb06b8f\",\"type\":\"label\",\"x\":12,\"y\":66,\"w\":274,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Raw input  (as the pin reads it)\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":7,\"uid\":\"18d66dec-58cb-42ca-b69a-7db79c49079e\",\"type\":\"label\",\"x\":10,\"y\":100,\"w\":90,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Interface\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":8,\"uid\":\"86c66ad2-b2eb-4abc-b1e4-26e5e4fd0fa0\",\"type\":\"combobox\",\"x\":106,\"y\":96,\"w\":150,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].interface\"}},{\"id\":9,\"uid\":\"e1cdb1d4-ea67-4403-a009-bcbe6ed5584f\",\"type\":\"wiring\",\"x\":10,\"y\":132,\"w\":274,\"h\":76,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].source\",\"condition\":\"[#sensors.sensor[*].interface] == 0 || [#sensors.sensor[*].interface] == 1 || [#sensors.sensor[*].interface] == 3 || [#sensors.sensor[*].interface] == 4 || [#sensors.sensor[*].interface] == 6 || [#sensors.sensor[*].interface] == 7\"}},{\"id\":10,\"uid\":\"9a454afe-1d6d-4c74-87df-a8f3994b1d46\",\"type\":\"label\",\"x\":10,\"y\":220,\"w\":90,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"CAN Field\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 5\"}},{\"id\":11,\"uid\":\"f153c87d-e4fd-4064-a170-bb8d295d2909\",\"type\":\"canfield\",\"x\":106,\"y\":216,\"w\":170,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].can_frame\",\"condition\":\"[#sensors.sensor[*].interface] == 5\"}},{\"id\":12,\"uid\":\"93e735fa-a549-4657-870b-5f10d2e0cd17\",\"type\":\"checkbox\",\"x\":10,\"y\":252,\"w\":22,\"h\":22,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].flags.invert\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":13,\"uid\":\"b26d7942-8a3d-49c1-8916-84aa68bd8039\",\"type\":\"label\",\"x\":40,\"y\":249,\"w\":220,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Invert  (switch inputs)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":14,\"uid\":\"176b200a-0010-4b81-8d49-a8b2fd14d132\",\"type\":\"label\",\"x\":10,\"y\":292,\"w\":274,\"h\":224,\"groupId\":0,\"props\":{\"labelText\":\"Interface says HOW the pin is read, and decides which inputs the picker offers \\u2014 a frequency sensor cannot be wired to an analogue pin. Two sensors on one pin is a fault, not a preference. A CAN sensor has no pin at all: it reads a field defined on the Receive page for its bus, named here by that frame and the field's start bit. A field whose own Signal is set is greyed in the list \\u2014 the frame writes that channel itself, and the sensor publishing it too would put two producers on one channel.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":15,"uid":"11d8c9f6-e38f-455e-9814-cafdaa2202f7","type":"panel","x":320,"y":30,"w":630,"h":662,"groupId":0,"props":{"labelText":"2 · Calibration","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":16,\"uid\":\"6e11175a-3fd1-41b4-93b2-cbb1e79daed1\",\"type\":\"table\",\"x\":10,\"y\":10,\"w\":600,\"h\":96,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"axisMode\":\"1\",\"displayUnit\":\"Auto\",\"displayUnitX\":\"Auto\",\"displayUnitY\":\"Auto\",\"cellTrace\":\"2\"}},{\"id\":17,\"uid\":\"4a46edf2-f82b-44e8-8e52-c4f0c08f7ff4\",\"type\":\"curve\",\"x\":10,\"y\":114,\"w\":600,\"h\":450,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"displayUnit\":\"Auto\",\"axisUnit\":\"Auto\",\"valueUnit\":\"Auto\"}},{\"id\":18,\"uid\":\"3d37b1cf-eaea-4ffe-9e9d-a8f14dd253da\",\"type\":\"label\",\"x\":10,\"y\":568,\"w\":600,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"Raw in along the top, reading out underneath. Right-click either for insert, delete, linearise \\u2014 or to save this curve to a file and load it into the next car with the same sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\",\"signalName\":\"sensors.sensor[*].cal\"}},{\"id\":19,\"uid\":\"4b2c2c5f-e53f-4961-bcc4-ef455e7b3632\",\"type\":\"bands\",\"x\":10,\"y\":10,\"w\":600,\"h\":616,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\"}}]"}},{"id":20,"uid":"1880a697-e936-4f2c-8ceb-2e6703e7091f","type":"panel","x":960,"y":30,"w":310,"h":662,"groupId":0,"props":{"labelText":"3 · Output","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":21,\"uid\":\"d3481d5d-55ac-49fd-a530-d4f729a0036e\",\"type\":\"value\",\"x\":12,\"y\":10,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"signalName\":\"[$*]\",\"format\":\"%.2f\",\"fontName\":\"|30|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"4\"}},{\"id\":22,\"uid\":\"8b156154-0377-451e-8b66-8b57c3f542c8\",\"type\":\"label\",\"x\":12,\"y\":74,\"w\":284,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Reading  (what everything downstream sees)\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"639e416e-1926-4e5f-ac65-da62d1b4d17e\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":90,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Type\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":24,\"uid\":\"99b83b37-f3da-4ce2-8261-19ec3123bf39\",\"type\":\"label\",\"x\":106,\"y\":106,\"w\":190,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Pressure\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":25,\"uid\":\"5d3b1d5e-a966-45be-a2bd-2c7972ff1e86\",\"type\":\"label\",\"x\":10,\"y\":142,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"This input's type is fixed by the ECU \\u2014 it is what the sensor IS. Only the generic inputs (aux, rotary trim) can be re-typed.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":26,\"uid\":\"9a0372f7-15c1-4697-8d56-2c54c763d433\",\"type\":\"label\",\"x\":10,\"y\":214,\"w\":284,\"h\":98,\"groupId\":0,\"props\":{\"labelText\":\"Input and output are both on screen because a calibration is a claim about how one becomes the other: watch the pair move together and a wrong curve shows itself immediately.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":27,\"uid\":\"e1e67209-4e6f-4db7-93d9-d0c93f638872\",\"type\":\"panel\",\"x\":10,\"y\":308,\"w\":284,\"h\":1,\"groupId\":0,\"props\":{\"bgColor\":\"#8a8f98\",\"padding\":\"0\"}},{\"id\":28,\"uid\":\"09eb4249-9e06-4ee9-9627-89