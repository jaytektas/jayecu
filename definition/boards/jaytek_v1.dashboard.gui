\"id\":21,\"uid\":\"f14ca9bd-bc7f-4993-a3be-5c6c7ad867c4\",\"type\":\"label\",\"x\":10,\"y\":90,\"w\":300,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Outputs  (all slots)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Electrical/Outputs\"}}]"}}],"elementScope":"outputs.output[41]"},"Configuration/Datalogging":{"uid":"df511558-ebbf-479d-bc7a-411e68439e65","canvasWidth":1280,"canvasHeight":694,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Datalogging","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"492a9fbc-04d4-41a7-bf90-e157dfc1bbbe","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"datalog.enabled"}},{"id":2,"uid":"40fa7133-36df-47f7-9443-810334c44a71","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"8104129a-2165-40f7-a625-77459ac139bb","type":"label","x":136,"y":4,"w":864,"h":56,"groupId":0,"props":{"labelText":"How fast the ECU writes to its own SD card. WHAT it records and WHEN it starts are a recording profile rather than settings, and they are edited together in Logging › Onboard Logging… — the channel list, the start and stop conditions, the minimum and maximum run times, the re-arm delay, and what to do when a condition cannot be answered. Activate there writes the whole profile to the ECU.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"daeb795f-97a0-4a4a-97ea-99919875e5b6","type":"panel","x":10,"y":62,"w":400,"h":70,"groupId":0,"props":{"labelText":"Logging","layoutMode":"0","padding":"0","children":"[{\"id\":5,\"uid\":\"d2900913-a3c8-4597-b7f2-e5aac9298068\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":247,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"SD Datalog Rate\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#datalog.enabled] == 1\"}},{\"id\":6,\"uid\":\"a114c2b4-1de0-40ba-a098-9b5851cefdee\",\"type\":\"configedit\",\"x\":263,\"y\":12,\"w\":113,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"datalog.rate_hz\",\"enableCondition\":\"[#datalog.enabled] == 1\"}}]"}},{"id":7,"uid":"a8eaf6b4-733e-4fdb-a16c-33503f96fdb6","type":"panel","x":10,"y":594,"w":1260,"h":90,"groupId":0,"props":{"labelText":"Live","layoutMode":"0","padding":"0","children":"[{\"id\":8,\"uid\":\"a6fbab73-4fdd-4177-b7d9-59938aad111d\",\"type\":\"value\",\"x\":14,\"y\":12,\"w\":140,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"rpm\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":9,\"uid\":\"87a65b24-9f5e-4ebf-b93e-9aa0d7f3a628\",\"type\":\"label\",\"x\":14,\"y\":42,\"w\":140,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Engine RPM\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":10,\"uid\":\"cb6b24ec-e489-426f-8450-1979194594c1\",\"type\":\"value\",\"x\":164,\"y\":12,\"w\":140,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"dtc_active\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":11,\"uid\":\"df0cdbc6-ea46-476d-877d-4ea429b291ef\",\"type\":\"label\",\"x\":164,\"y\":42,\"w\":140,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Active DTCs\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}}]"}}]},"Configuration/CAN Bus":{"uid":"de45c6a7-ae0d-470e-8872-74c9cf6e84f0","canvasWidth":1280,"canvasHeight":173,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"CAN Bus","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"1e25cb3d-c637-4bf6-92dc-270150675c57","type":"label","x":10,"y":4,"w":990,"h":40,"groupId":0,"props":{"labelText":"Two physical CAN controllers and the OBD-II responder. Each bus has a page for the wire itself — bit rate, listen-only, and what it is doing right now — with the frames it sends and decodes underneath it. There is no switch here: each of the three has its own, on its own page.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"93bae9cd-cc44-41c7-82e7-3ddb81369fc2","type":"panel","x":10,"y":46,"w":320,"h":117,"groupId":0,"props":{"labelText":"In this branch","layoutMode":"0","padding":"0","children":"[{\"id\":3,\"uid\":\"f2fb89ac-8dd8-4d45-9012-53258dc7d691\",\"type\":\"label\",\"x\":10,\"y\":10,\"w\":250,\"h\":20,\"groupId\":2,\"props\":{\"labelText\":\"CAN1\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/CAN Bus/CAN1\"}},{\"id\":4,\"uid\":\"83f51fd9-ca52-4841-94bb-761c5a8a50d3\",\"type\":\"label\",\"x\":10,\"y\":35,\"w\":250,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"CAN2\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/CAN Bus/CAN2\"}},{\"id\":5,\"uid\":\"9a1cd5a2-0dce-4324-ad0f-e4c067ae229c\",\"type\":\"label\",\"x\":10,\"y\":60,\"w\":250,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"OBD-II\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/CAN Bus/OBD-II\"}}]"}}]},"Configuration/CAN Bus/OBD-II":{"uid":"a63bfc03-6b5a-4500-9180-36d1669d86a4","canvasWidth":1280,"canvasHeight":256,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"OBD-II","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"35b03898-54c1-44c7-a650-adb49fb97073","type":"label","x":10,"y":4,"w":990,"h":40,"groupId":0,"props":{"labelText":"A generic scan tool plugged into the car talks to this. It ANSWERS — mode 01 live data, mode 03 stored codes — and says nothing unprompted, which is the opposite of everything under CAN1 and CAN2. Independent of them: it can sit on a bus that also carries your own frames, or on one of its own.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"d5a5dd60-9c62-4775-804d-abd8ba664ad8","type":"panel","x":10,"y":46,"w":520,"h":200,"groupId":0,"props":{"labelText":"OBD-II","layoutMode":"0","padding":"0","children":"[{\"id\":3,\"uid\":\"3cdc5380-44e4-4ea7-aa20-720a07ee5d4b\",\"type\":\"checkbox\",\"x\":10,\"y\":15,\"w\":22,\"h\":22,\"groupId\":2,\"props\":{\"signalName\":\"can.obd_enabled\"}},{\"id\":4,\"uid\":\"f64cabb4-ecb0-4a95-aad8-fb5a405e1ef4\",\"type\":\"label\",\"x\":40,\"y\":16,\"w\":460,\"h\":20,\"groupId\":2,\"props\":{\"labelText\":\"Enabled\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":5,\"uid\":\"232c5acb-82b8-4803-a4ac-c4c4061cd27e\",\"type\":\"label\",\"x\":10,\"y\":50,\"w\":110,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Bus\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#can.obd_enabled] == 1\"}},{\"id\":6,\"uid\":\"3642c247-25fb-4f7d-99e5-bdf857817ce7\",\"type\":\"combobox\",\"x\":126,\"y\":46,\"w\":150,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"can.obd_bus\",\"condition\":\"[#can.obd_enabled] == 1\"}},{\"id\":7,\"uid\":\"4e75fbef-6d12-44e9-8bd6-200ee4a5c481\",\"type\":\"label\",\"x\":10,\"y\":86,\"w\":500,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"Put the scan tool on a bus of its own and it cannot see, or interfere with, the traffic on the other one \\u2014 which on a tuning or instrument bus is usually what you want. The bus it names must itself be enabled.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}]},"Configuration/CAN Bus/CAN1":{"uid":"18260381-9918-4172-885d-9df2b1d41439","canvasWidth":1280,"canvasHeight":408,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"CAN1","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"0a57937d-660b-4cd0-ba98-4cb0438a51c6","type":"label","x":10,"y":4,"w":990,"h":40,"groupId":0,"props":{"labelText":"CAN1 is a physical CAN controller. Nothing here is about what the bus CARRIES — that is Transmit and Receive below it — this is the wire itself: whether it is brought up, how fast, and whether the ECU is allowed to talk on it.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"1c98b4d4-8e44-43aa-b7f1-eba41e5cab1b","type":"panel","x":10,"y":46,"w":430,"h":284,"groupId":0,"props":{"labelText":"Setup","layoutMode":"0","padding":"0","children":"[{\"id\":3,\"uid\":\"98b41308-13e9-4754-9b80-fda5358c6083\",\"type\":\"checkbox\",\"x\":10,\"y\":15,\"w\":22,\"h\":22,\"groupId\":2,\"props\":{\"signalName\":\"can.bus[0].enabled\"}},{\"id\":4,\"uid\":\"60c5c890-bd48-4f33-9c1b-457ade919878\",\"type\":\"label\",\"x\":40,\"y\":16,\"w\":370,\"h\":20,\"groupId\":2,\"props\":{\"labelText\":\"Enabled\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":5,\"uid\":\"f6a5745a-cb2c-4a40-ae40-a052c5cb0a08\",\"type\":\"label\",\"x\":10,\"y\":50,\"w\":110,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Bitrate\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#can.bus[0].enabled] == 1\",\"enableCondition\":\"canframes(0) == 0\"}},{\"id\":6,\"uid\":\"eb8fa12f-dcc9-4b78-9f35-48cf581790e5\",\"type\":\"combobox\",\"x\":126,\"y\":46,\"w\":150,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"can.bus[0].bitrate\",\"condition\":\"[#can.bus[0].enabled] == 1\",\"enableCondition\":\"canframes(0) == 0\"}},{\"id\":7,\"uid\":\"c60046b4-ed9d-4de1-be33-aaefaca15b47\",\"type\":\"checkbox\",\"x\":10,\"y\":83,\"w\":22,\"h\":22,\"groupId\":4,\"props\":{\"signalName\":\"can.bus[0].listen_only\",\"condition\":\"[#can.bus[0].enabled] == 1\"}},{\"id\":8,\"uid\":\"640c8dda-d988-4743-9195-1cbfff146e39\",\"type\":\"label\",\"x\":40,\"y\":84,\"w\":370,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Listen Only\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#can.bus[0].enabled] == 1\"}},{\"id\":9,\"uid\":\"a2822879-168d-4a8c-873f-281e1e580cf1\",\"type\":\"label\",\"x\":10,\"y\":120,\"w\":410,\"h\":134,\"groupId\":0,\"props\":{\"labelText\":\"Listen Only never transmits \\u2014 not even an acknowledgement \\u2014 so the ECU can be put on somebody else's bus without affecting it. A bus that is off is not initialised at all. Every node on a bus must agree on the bit rate: a mismatch never ACKs, which looks exactly like nothing being connected \\u2014 which is why the rate is fixed once this bus carries a frame. Clear its Transmit and Receive lists to change it.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":10,"uid":"4a24646e-4171-4338-a036-61485ec93c1d","type":"panel","x":456,"y":46,"w":430,"h":352,"groupId":0,"props":{"labelText":"Right Now","layoutMode":"0","padding":"0","children":"[{\"id\":11,\"uid\":\"511423ea-a4ba-43ad-a8f3-b9ae4fd27670\",\"type\":\"value\",\"x\":14,\"y\":14,\"w\":120,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"[$can1_load_pct]\",\"format\":\"%.1f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":12,\"uid\":\"523fdc2d-8a78-44bf-ab62-62fb3cad1f91\",\"type\":\"label\",\"x\":14,\"y\":44,\"w\":120,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Bus Load\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":13,\"uid\":\"24872125-1b49-43a7-926b-933f235884c2\",\"type\":\"value\",\"x\":150,\"y\":14,\"w\":120,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"[$can1_tx_fps]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":14,\"uid\":\"1b133d73-4c89-40d0-943d-6e020cbcee0d\",\"type\":\"label\",\"x\":150,\"y\":44,\"w\":120,\"h\":20,\"groupId\":6,\"