a8f98\"}},{\"id\":45,\"uid\":\"1490de86-1ea2-451a-8cf0-4447434dbf6f\",\"type\":\"label\",\"x\":10,\"y\":172,\"w\":360,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Outputs\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Electrical/Outputs\"}},{\"id\":46,\"uid\":\"9d600147-9ef4-43f5-b6de-199b0b2d59f8\",\"type\":\"label\",\"x\":10,\"y\":198,\"w\":360,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"Leaves both H-bridges free, so this is the mode to use alongside a drive-by-wire throttle.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":47,"uid":"b589f2de-8616-41b7-9dd5-7ec510295cf1","type":"panel","x":810,"y":46,"w":460,"h":320,"groupId":0,"props":{"labelText":"Right Now","layoutMode":"0","padding":"0","children":"[{\"id\":48,\"uid\":\"d501a09b-8842-4a3f-9124-7363e9cfa394\",\"type\":\"value\",\"x\":15,\"y\":14,\"w\":130,\"h\":30,\"groupId\":12,\"props\":{\"signalName\":\"[$idle_duty]\",\"format\":\"%.1f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":49,\"uid\":\"b71068a1-16cb-4360-bf97-291f20575380\",\"type\":\"label\",\"x\":15,\"y\":44,\"w\":130,\"h\":20,\"groupId\":12,\"props\":{\"labelText\":\"Demand\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":50,\"uid\":\"7c2ac3cc-0f67-43a7-a173-2118f979a14f\",\"type\":\"value\",\"x\":150,\"y\":14,\"w\":130,\"h\":30,\"groupId\":13,\"props\":{\"signalName\":\"[$rpm]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"Center\"}},{\"id\":51,\"uid\":\"a88ff054-506b-4480-8fbe-1b2d224709b8\",\"type\":\"label\",\"x\":150,\"y\":44,\"w\":130,\"h\":20,\"groupId\":13,\"props\":{\"labelText\":\"Engine RPM\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":52,\"uid\":\"219ea958-ed3d-4807-bab4-d9f577be6bdb\",\"type\":\"value\",\"x\":285,\"y\":14,\"w\":130,\"h\":30,\"groupId\":14,\"props\":{\"signalName\":\"[$idle_target_rpm]\",\"format\":\"%.0f\",\"fontName\":\"|20|0|0\",\"align\":\"C