id\":11,\"uid\":\"d568dc34-dadc-45dc-801a-2dfc09efae38\",\"type\":\"checkbox\",\"x\":10,\"y\":58,\"w\":22,\"h\":22,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.stuck\"}},{\"id\":12,\"uid\":\"30e81026-30fb-493f-b043-02d5d9a62af2\",\"type\":\"label\",\"x\":40,\"y\":56,\"w\":194,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Detect Stuck\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":13,\"uid\":\"a6f7afa0-2eb8-42e4-8fb4-6482bf23e441\",\"type\":\"configedit\",\"x\":240,\"y\":56,\"w\":96,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].diag_stuck_ms\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.stuck] == 1\"}},{\"id\":14,\"uid\":\"fd1fdbe3-71f9-4621-9b6f-cb4c35e91aa8\",\"type\":\"enum\",\"x\":346,\"y\":56,\"w\":110,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.stuck\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.stuck] == 1\"}},{\"id\":15,\"uid\":\"c4063868-f81b-4fda-a031-8bb5230fd7f2\",\"type\":\"label\",\"x\":462,\"y\":60,\"w\":60,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"P1274\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.stuck] == 1\"}},{\"id\":16,\"uid\":\"bb516849-991a-441a-a106-8f2a857a06b1\",\"type\":\"label\",\"x\":34,\"y\":81,\"w\":515,\"h\":16,\"groupId\":3,\"props\":{\"labelText\":\"The reading has not moved at all for this long \\u2014 a switch input that never changes.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":17,\"uid\":\"291dd3ca-fd38-4fb7-8dc6-ee189434176b\",\"type\":\"label\",\"x\":560,\"y\":38,\"w\":140,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"DTC Delay\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":18,\"uid\":\"930cb3e8-48cf-48a2-87c6-39de5278d4c7\",\"type\":\"configedit\",\"x\":706,\"y\":34,\"w\":123,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].diag_delay_ms\"}},{\"id\":19,\"uid\":\"b234bd20-8863-4c1a-9160-900c8c453b6b\",\"type\":\"label\",\"x\":560,\"y\":68,\"w\":400,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"How long a check has to keep failing before it becomes a fault. A sensor that blips once on a starter crank is not a broken sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":20,\"uid\":\"25fbf6c5-5eac-4555-aeba-61e3dc973fd0\",\"type\":\"label\",\"x\":560,\"y\":110,\"w\":400,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Precondition\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":21,\"uid\":\"5bad4e9c-8296-4380-90e3-8a4642636316\",\"type\":\"expression\",\"x\":560,\"y\":132,\"w\":400,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].precond_expr\"}},{\"id\":22,\"uid\":\"8c27299f-b8fc-4f6d-872c-d1154049e25f\",\"type\":\"label\",\"x\":560,\"y\":164,\"w\":400,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"The plausibility checks only run while this holds \\u2014 an oil pressure of zero is a fault at 3000 rpm and the truth with the engine stopped.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":23,\"uid\":\"cdc38f6f-9367-4c5b-806f-4ec612c824bd\",\"type\":\"label\",\"x\":990,\"y\":34,\"w\":250,\"h\":170,\"groupId\":0,\"props\":{\"labelText\":\"The electrical pair tests the RAW input in the input's own units, before calibration; the plausibility pair tests the calibrated reading. Severity is what the DTC records and what the protection levels read. A check with no code is one this sensor cannot report, and is not offered \\u2014 which is why two sensors show different rows here.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[power_steering_sw]"},"Configuration/Sensors/Chassis/Ride Height Sensor Front":{"uid":"7f89adb5-697c-4b62-917e-23f6018c1535","canvasWidth":1280,"canvasHei