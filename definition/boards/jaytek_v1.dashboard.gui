fast this output is chopped. A fixed frequency, an expression, or a table it names — the duty is on the output's own page; this is only the carrier.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"21f4233b-aa0a-4829-87a8-7ac81a2ec94c","type":"panel","x":10,"y":30,"w":470,"h":168,"groupId":0,"props":{"labelText":"Carrier","layoutMode":"0","padding":"0","children":"[{\"id\":3,\"uid\":\"e0fced16-5ae6-4b03-85c2-682b7a5dd9f9\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":240,\"h\":20,\"groupId\":2,\"props\":{\"labelText\":\"Frequency From\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":4,\"uid\":\"f3f8d9d2-c087-4e1f-9c36-2d2ab9ab9f97\",\"type\":\"combobox\",\"x\":256,\"y\":12,\"w\":190,\"h\":30,\"groupId\":2,\"props\":{\"signalName\":\"outputs.output[*].freq_source\"}},{\"id\":5,\"uid\":\"2e5cbf1a-4636-4025-bdce-395198c23978\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":330,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Fixed Frequency\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 0\"}},{\"id\":6,\"uid\":\"80d40fe9-8924-4ab6-b7bc-778dbf09f132\",\"type\":\"configedit\",\"x\":346,\"y\":42,\"w\":100,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"outputs.output[*].pwm_freq_hz\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 0\"}},{\"id\":7,\"uid\":\"c42e98b1-cb04-47d6-b004-60d1818a8849\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":180,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Frequency Table\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 1\"}},{\"id\":8,\"uid\":\"83eee1e6-f933-4b44-9902-f474ce91366e\",\"type\":\"enum\",\"x\":196,\"y\":72,\"w\":250,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"outputs.output[*].freq_table_sel\",\"enableCondition\":\"[#outputs.output[*].function