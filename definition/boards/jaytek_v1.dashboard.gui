unction] == 3\"}},{\"id\":82,\"uid\":\"a1910e46-c52a-43a3-bbe1-2f3224b59782\",\"type\":\"configedit\",\"x\":286,\"y\":42,\"w\":100,\"h\":30,\"groupId\":29,\"props\":{\"signalName\":\"outputs.output[*].offset_x10\",\"enableCondition\":\"[#outputs.output[*].function] == 3\"}},{\"id\":83,\"uid\":\"8ec44ed5-5b94-4172-8e8d-4d15d22ff18d\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":270,\"h\":20,\"groupId\":30,\"props\":{\"labelText\":\"Clamp Low (x10)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3\"}},{\"id\":84,\"uid\":\"b790efc3-5021-4cfe-99e0-de009a4a8ce0\",\"type\":\"configedit\",\"x\":286,\"y\":72,\"w\":100,\"h\":30,\"groupId\":30,\"props\":{\"signalName\":\"outputs.output[*].clamp_lo_x10\",\"enableCondition\":\"[#outputs.output[*].function] == 3\"}},{\"id\":85,\"uid\":\"f4c68349-8b14-42e7-b05b-5c31bc17e7f4\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":270,\"h\":20,\"groupId\":31,\"props\":{\"labelText\":\"Clamp High (x10)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3\"}},{\"id\":86,\"uid\":\"babb26f7-73b1-4691-936f-4c893c8ec523\",\"type\":\"configedit\",\"x\":286,\"y\":102,\"w\":100,\"h\":30,\"groupId\":31,\"props\":{\"signalName\":\"outputs.output[*].clamp_hi_x10\",\"enableCondition\":\"[#outputs.output[*].function] == 3\"}},{\"id\":87,\"uid\":\"d3025d23-4391-4da2-aefc-c7ac5c6c08fc\",\"type\":\"label\",\"x\":10,\"y\":136,\"w\":270,\"h\":20,\"groupId\":32,\"props\":{\"labelText\":\"Failsafe (x10)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3\"}},{\"id\":88,\"uid\":\"ca001250-482e-4678-b71c-29c9759d0dfa\",\"type\":\"configedit\",\"x\":286,\"y\":132,\"w\":100,\"h\":30,\"groupId\":32,\"props\":{\"signalName\":\"outputs.output[*].failsafe_x10\",\"enableCondition\":\"[#outputs.output[*].function] == 3\"}}]"}},{"id":89,"uid":"7396664d-0c1f-49ae-8bd1-dd41621d78b2","type":"label","x":860,"y":230,"w":330,"h":116,"groupId":0,"props":{"labelText":"Scale and offset are a straight line from the engineering value to the actuator command, so two known points define them. The clamps are the ACTUATOR's limits rather than a control decision, and the failsafe is what is emitted when no candidate is valid — arbitration always emits something.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":90,"uid":"ef1b7d5f-f48b-4627-84bf-661f588bd96d","type":"panel","x":860,"y":358,"w":410,"h":92,"groupId":0,"props":{"labelText":"Right Now","layoutMode":"0","padding":"0","children":"[{\"id\":91,\"uid\":\"5b0a697b-8bac-4aef-ba19-29d1d106a34e\",\"type\":\"value\",\"x\":10,\"y\":12,\"w\":180,\"h\":40,\"groupId\":0,\"props\":{\"signalName\":\"[$*]\",\"format\":\"%.0f\",\"fontName\":\"|22|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"3\"}},{\"id\":92,\"uid\":\"1ff6942a-23a8-4535-bd39-ab14871327c2\",\"type\":\"label\",\"x\":200,\"y\":14,\"w\":200,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Commanded output\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":93,\"uid\":\"b02b7c29-13ba-4b4b-91ab-73476ae32af9\",\"type\":\"label\",\"x\":200,\"y\":38,\"w\":200,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Outputs  (every pin)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Electrical/Outputs\"}}]"}},{"id":94,"uid":"f4a81d77-b880-48d2-8101-3d9e9080c579","type":"panel","x":860,"y":458,"w":410,"h":256,"groupId":0,"props":{"labelText":"Bench Test","layoutMode":"0","padding":"0","children":"[{\"id\":95,\"uid\":\"0a38c2f8-3427-4abe-923f-909855037ceb\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":252,\"h\":20,\"groupId\":33,\"props\":{\"labelText\":\"Count\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":96,\"uid\":\"ddf0891c-cee8-4e19-b545-12f833967740\",\"type\":\"configedit\",\"x\":268,\"y\":12,\"w\":118,\"h\":30,\"groupId\":33,\"props\":{\"signalName\":\"pc.test_count\"}},{\"id\":97,\"uid\":\"2c