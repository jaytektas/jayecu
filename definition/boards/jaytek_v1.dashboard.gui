df66186904\",\"type\":\"checkbox\",\"x\":10,\"y\":58,\"w\":22,\"h\":22,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.raw_min\"}},{\"id\":12,\"uid\":\"b22da394-4348-49cc-a82a-aa0a2c9523a9\",\"type\":\"label\",\"x\":40,\"y\":56,\"w\":194,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Detect Raw Low\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":13,\"uid\":\"a49ede9f-aa48-451e-8747-f00f271cbe1d\",\"type\":\"configedit\",\"x\":240,\"y\":56,\"w\":96,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].diag_raw_min\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_min] == 1\"}},{\"id\":14,\"uid\":\"8a55c36b-7e53-447f-8734-7ec0e86f3665\",\"type\":\"enum\",\"x\":346,\"y\":56,\"w\":110,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.raw_min\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_min] == 1\"}},{\"id\":15,\"uid\":\"2a232980-1a53-4c9b-a50c-70194d8c448c\",\"type\":\"label\",\"x\":462,\"y\":60,\"w\":60,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"P10B0\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_min] == 1\"}},{\"id\":16,\"uid\":\"82cf47b7-0e39-4010-b386-13543d4c60b7\",\"type\":\"label\",\"x\":34,\"y\":81,\"w\":515,\"h\":16,\"groupId\":3,\"props\":{\"labelText\":\"The pin reads below this \\u2014 an open circuit, or a short to ground.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":17,\"uid\":\"7ae4f14c-06ff-4c22-89d9-8a59f02966ab\",\"type\":\"checkbox\",\"x\":10,\"y\":104,\"w\":22,\"h\":22,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.raw_max\"}},{\"id\":18,\"uid\":\"21af5803-6b31-42bf-b196-6ee9464ccbf1\",\"type\":\"label\",\"x\":40,\"y\":102,\"w\":194,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Detect Raw High\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":19,\"uid\":\"01ff5c05-85f0-4ed7-abd9-8a5ac2e82d18\",\"type\":\"configedit\",\"x\":240,\"y\":102,\"w\":96,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].diag_raw_max\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_max] == 1\"}},{\"id\":20,\"uid\":\"9d634633-ae4d-493f-b0d8-8fc7ecc5ffdd\",\"type\":\"enum\",\"x\":346,\"y\":102,\"w\":110,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.raw_max\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_max] == 1\"}},{\"id\":21,\"uid\":\"48112b8a-60b7-4075-908d-0926fec5d198\",\"type\":\"label\",\"x\":462,\"y\":106,\"w\":60,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"P10B1\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_max] == 1\"}},{\"id\":22,\"uid\":\"9fd59e7e-1bd6-4fec-839d-a8c6ea039211\",\"type\":\"label\",\"x\":34,\"y\":127,\"w\":515,\"h\":16,\"groupId\":4,\"props\":{\"labelText\":\"The pin reads above this \\u2014 a short to power, or a missing pull-down.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"f74ca283-ab1c-43fd-b7dd-ae8e052be0d9\",\"type\":\"label\",\"x\":10,\"y\":148,\"w\":500,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Plausibility  (calibrated reading)\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":24,\"uid\":\"cf3dfc02-94f9-4ef2-aa38-2f69fb6b0704\",\"type\":\"checkbox\",\"x\":10,\"y\":172,\"w\":22,\"h\":22,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.op_min\"}},{\"id\":25,\"uid\":\"2cc5e746-18f0-49fd-99de-2f555eaca152\",\"type\":\"label\",\"x\":40,\"y\":170,\"w\":194,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Detect Reading Low\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":26,\"uid\":\"3e447cbe-a29b-4894-9aac-81698e031901\",\"type\":\"configedit\",\"x\":240,\"y\":170,\"w\":96,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_op_min\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":27,\"uid\":\"1f4b4e76-1e56-4831-8c04-4481f383a917\",\"type\":\"enum\",\"x\":346,\"y\":170,\"w\":110,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.op_min\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":28,\"uid\":\"a9b16f05-74f6-475f-bb70-fba3eebef3c3\",\"type\":\"label\",\"x\":462,\"y\":174,\"w\":60,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"P10B2\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":29,\"uid\":\"a23a278a-1dca-4219-9c52-30fc879d234c\",\"type\":\"label\",\"x\":34,\"y\":195,\"w\":515,\"h\":16,\"groupId\":5,\"props\":{\"labelText\":\"The calibrated reading is below what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":30,\"uid\":\"01da1a9d-9d34-4758-913b-5cf832704ee7\",\"type\":\"checkbox\",\"x\":10,\"y\":218,\"w\":22,\"h\":22,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.op_max\"}},{\"id\":31,\"uid\":\"1b73828c-2757-4ce5-bb3f-df4d00f8223b\",\"type\":\"label\",\"x\":40,\"y\":216,\"w\":194,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Detect Reading High\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":32,\"uid\":\"c44b41d5-b513-4970-8d70-a0553e2a755c\",\"type\":\"configedit\",\"x\":240,\"y\":216,\"w\":96,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_op_max\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":33,\"uid\":\"50fc0983-7ee9-42c9-ba2a-c98e0b793c31\",\"type\":\"enum\",\"x\":346,\"y\":216,\"w\":110,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.op_max\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":34,\"uid\":\"a9029bfc-9984-4908-bf5a-d05a2b4b56b1\",\"type\":\"label\",\"x\":462,\"y\":220,\"w\":60,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"P10B3\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":35,\"uid\":\"dbf29b80-8dc1-458f-8cf7-f2dae11f50a4\",\"type\":\"label\",\"x\":34,\"y\":241,\"w\":515,\"h\":16,\"groupId\":6,\"props\":{\"labelText\":\"The calibrated reading is above what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":36,\"uid\":\"a8be88ff-4e4f-4541-8f52-8b862237a6e3\",\"type\":\"label\",\"x\":560,\"y\":38,\"w\":140,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"DTC Delay\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":37,\"uid\":\"99d5c7c4-4049-408d-a2ad-e1be01440f22\",\"type\":\"configedit\",\"x\":706,\"y\":34,\"w\":123,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"sensors.sensor[*].diag_delay_ms\"}},{\"id\":38,\"uid\":\"8635bd05-8e43-43e8-9d5e-4f50387bda80\",\"type\":\"label\",\"x\":560,\"y\":68,\"w\":400,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"How long a check has to keep failing before it becomes a fault. A sensor that blips once on a starter crank is not a broken sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":39,\"uid\":\"49e81c71-8507-41a5-8585-3f953d06d767\",\"type\":\"label\",\"x\":560,\"y\":110,\"w\":400,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Precondition\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":40,\"uid\":\"f770886a-69df-4e93-91a9-b252349efa07\",\"type\":\"expression\",\"x\":560,\"y\":132,\"w\":400,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].precond_expr\"}},{\"id\":41,\"uid\":\"3f32a352-4d45-4e0c-8f71-63108bfa9e2e\",\"type\":\"label\",\"x\":560,\"y\":164,\"w\":400,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"The plausibility checks only run while this holds \\u2014 an oil pressure of zero is a fault at 3000 rpm and the truth with the engine stopped.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":42,\"uid\":\"16acdb5e-a23d-4851-9878-553378b9447e\",\"type\":\"label\",\"x\":990,\"y\":34,\"w\":250,\"h\":170,\"groupId\":0,\"props\":{\"labelText\":\"The electrical pair tests the RAW input in the input's own units, before calibration; the plausibility pair tests the calibrated reading. Severity is what the DTC records and what the protection levels read. A check with no code is one this sensor cannot report, and is not offered \\u2014 which is why two sensors show different rows here.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[clt_return]"},"Configuration/Sensors/Engine/Crank Case Pressure":{"uid":"07bae58d-45b1-483c-b83e-a8a7573097bb","canvasWidth":1280,"canvasHeight":700,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Crank Case Pressure","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"0b1c73dd-650b-49ae-a206-20bd9358a7ca","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"sensors.sensor[*].enabled"}},{"id":2,"uid":"19e521e7-942c-4275-9304-1c96184a9ede","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"3719ce0b-e455-474b-9aaa-5edbf484e849","type":"label","x":136,"y":4,"w":379,"h":24,"groupId":0,"props":{"labelText":"What this input is wired to, and what its curve makes of it.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"3ad41c64-87f2-4476-babc-55ab9fe96d53","type":"panel","x":10,"y":30,"w":300,"h":662,"groupId":0,"props":{"labelText":"1 · Input","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":5,\"uid\":\"61129a3a-50dc-4b92-b4d0-85e7e0d66aec\",\"type\":\"value\",\"x\":12,\"y\":10,\"w\":274,\"h\":54,\"groupId\":0,\"props\":{\"signalName\":\"[$~]\",\"fontName\":\"|26|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"4\"}},{\"id\":6,\"uid\":\"8a16fc48-4b27-40d7-b846-e867ff316333\",\"type\":\"label\",\"x\":12,\"y\":66,\"w\":274,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Raw input  (as the pin reads it)\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":7,\"uid\":\"446edf29-f4de-4cb1-b62d-cc5edb9f88c1\",\"type\":\"label\",\"x\":10,\"y\":100,\"w\":90,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Interface\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":8,\"uid\":\"fd35d0b6-b002-4906-ba29-23fdc43f3c63\",\"type\":\"combobox\",\"x\":106,\"y\":96,\"w\":150,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].interface\"}},{\"id\":9,\"uid\":\"cfcfc564-f0b6-4ad0-8dfc-5fe1d9f5cdc6\",\"type\":\"wiring\",\"x\":10,\"y\":132,\"w\":274,\"h\":76,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].source\",\"condition\":\"[#sensors.sensor[*].interface] == 0 || [#sensors.sensor[*].interface] == 1 || [#sensors.sensor[*].interface] == 3 || [#sensors.sensor[*].interface] == 4 || [#sensors.sensor[*].interface] == 6 || [#sensors.sensor[*].interface] == 7\"}},{\"id\":10,\"uid\":\"ea16d63e-c7eb-4af1-8922-b63eb6a15401\",\"type\":\"label\",\"x\":10,\"y\":220,\"w\":90,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"CAN Field\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 5\"}},{\"id\":11,\"uid\":\"bfb92cfe-113e-48e6-8b7f-a0d02d14ebe1\",\"type\":\"canfield\",\"x\":106,\"y\":216,\"w\":170,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].can_frame\",\"condition\":\"[#sensors.sensor[*].interface] == 5\"}},{\"id\":12,\"uid\":\"0ed5359b-082a-49bf-bf9f-493970ff866e\",\"type\":\"checkbox\",\"x\":10,\"y\":252,\"w\":22,\"h\":22,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].flags.invert\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":13,\"uid\":\"8e5b64dc-cb5b-495f-b619-76df4c3b9f45\",\"type\":\"label\",\"x\":40,\"y\":249,\"w\":220,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Invert  (switch inputs)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":14,\"uid\":\"c138154b-9b63-4a5b-9448-679ad5da77b3\",\"type\":\"label\",\"x\":10,\"y\":292,\"w\":274,\"h\":224,\"groupId\":0,\"props\":{\"labelText\":\"Interface says HOW the pin is read, and decides which inputs the picker offers \\u2014 a frequency sensor cannot be wired to an analogue pin. Two sensors on one pin is a fault, not a preference. A CAN sensor has no pin at all: it reads a field defined on the Receive page for its bus, named here by that frame and the field's start bit. A field whose own Signal is set is greyed in the list \\u2014 the frame writes that channel itself, and the sensor publishing it too would put two producers on one channel.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":15,"uid":"a57e75cc-a032-4722-b2c8-a1b45a69fadd","type":"panel","x":320,"y":30,"w":630,"h":662,"groupId":0,"props":{"labelText":"2 · Calibration","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":16,\"uid\":\"9453e87d-6e7e-43d7-9663-7d61e85b0c0a\",\"type\":\"table\",\"x\":10,\"y\":10,\"w\":600,\"h\":96,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"axisMode\":\"1\",\"displayUnit\":\"Auto\",\"displayUnitX\":\"Auto\",\"displayUnitY\":\"Auto\",\"cellTrace\":\"2\"}},{\"id\":17,\"uid\":\"fb68bbd6-babd-43c9-87ac-343238f29f2b\",\"type\":\"curve\",\"x\":10,\"y\":114,\"w\":600,\"h\":450,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"displayUnit\":\"Auto\",\"axisUnit\":\"Auto\",\"valueUnit\":\"Auto\"}},{\"id\":18,\"uid\":\"ac8270b6-be99-4448-a61e-11274ce83d0c\",\"type\":\"label\",\"x\":10,\"y\":568,\"w\":600,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"Raw in along the top, reading out underneath. Right-click either for insert, delete, linearise \\u2014 or to save this curve to a file and load it into the next car with the same sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\",\"signalName\":\"sensors.sensor[*].cal\"}},{\"id\":19,\"uid\":\"c614d014-7cd3-4ebe-9604-d823e475fa22\",\"type\":\"bands\",\"x\":10,\"y\":10,\"w\":600,\"h\":616,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\"}}]"}},{"id":20,"uid":"5d689bcb-f028-4fa1-a24f-e5997d8b035b","type":"panel","x":960,"y":30,"w":310,"h":662,"groupId":0,"props":{"labelText":"3 · Output","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":21,\"uid\":\"bf3cfd7b-e10e-4490-8a60-81ea29138115\",\"type\":\"value\",\"x\":12,\"y\":10,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"signalName\":\"[$*]\",\"format\":\"%.2f\",\"fontName\":\"|30|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"4\"}},{\"id\":22,\"uid\":\"f8890452-1296-4ec7-a72c-2c7133f995c2\",\"type\":\"label\",\"x\":12,\"y\":74,\"w\":284,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Reading  (what everything downstream sees)\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"75effa69-0015-4e43-9a21-580ec7c31297\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":90,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Type\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":24,\"uid\":\"7f9b057c-ed6f-4eee-bf14-6091635951ff\",\"type\":\"label\",\"x\":106,\"y\":106,\"w\":190,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Pressure\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":25,\"uid\":\"f18bdbbe-e978-4e3b-9e2a-9fdd6b310bec\",\"type\":\"label\",\"x\":10,\"y\":142,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"This input's type is fixed by the ECU \\u2014 it is what the sensor IS. Only the generic inputs (aux, rotary trim) can be re-typed.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":26,\"uid\":\"99354fb7-fb62-4164-998f-90eff5567966\",\"type\":\"label\",\"x\":10,\"y\":214,\"w\":284,\"h\":98,\"groupId\":0,\"props\":{\"labelText\":\"Input and output are both on screen because a calibration is a claim about how one becomes the other: watch the pair move together and a wrong curve shows itself immediately.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":27,\"uid\":\"738d20e2-17cd-433c-af4c-c0fb10c91fc4\",\"type\":\"panel\",\"x\":10,\"y\":308,\"w\":284,\"h\":1,\"groupId\":0,\"props\":{\"bgColor\":\"#8a8f98\",\"padding\":\"0\"}},{\"id\":28,\"uid\":\"c5cec72d-8f92-4e7c-b253-54a0b44b57be\",\"type\":\"label\",\"x\":10,\"y\":318,\"w\":284,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Diagnostics  (4 checks)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Sensors/Engine/Crank Case Pressure/Diagnostics\"}},{\"id\":29,\"uid\":\"a5c161d5-5f62-4383-a35e-5e91d3d65435\",\"type\":\"label\",\"x\":10,\"y\":342,\"w\":284,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"What this input must complain about, when, and with which code.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[crankcase_pressure]"},"Configuration/Sensors/Engine/Crank Case Pressure/Diagnostics":{"uid":"102d1c45-07b2-4d4b-bc0e-e4a133f688e5","canvasWidth":1280,"canvasHeight":336,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Crank Case Pressure — Diagnostics","layout":0,"gridColumns":2,"focusIndex