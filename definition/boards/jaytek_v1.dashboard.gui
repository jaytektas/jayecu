isible and indexed like any other target, not buried in a trim. Authority is the leash: a trim reaching 25% is hiding a VE table that is 25% wrong, and the answer is Apply to Base Table, not a longer leash.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"2a987e4e-52c1-4eb8-a799-4cfa1ad5eab4","type":"panel","x":10,"y":110,"w":400,"h":250,"groupId":0,"props":{"labelText":"Sensor","layoutMode":"0","padding":"0","children":"[{\"id\":5,\"uid\":\"1f2035c2-3685-42f4-8324-661e81502db9\",\"type\":\"label\",\"x\":10,\"y\":16,\"w\":170,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Unbanked/Bank 1\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#lambda.enabled] == 1\"}},{\"id\":6,\"uid\":\"2bc737bc-93ad-45fa-a757-138b894c2d46\",\"type\":\"combobox\",\"x\":186,\"y\":12,\"w\":190,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"lambda.o2_src_1\",\"enableCondition\":\"[#lambda.enabled] == 1\",\"ranges\":\"#ff453a,,,,0,[$o2_src_fault]\"}},{\"id\":7,\"uid\":\"345c4b48-d942-4cfe-84d3-4b296d37faa5\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":170,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Bank 2\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#lambda.enabled] == 1 and [#lambda.o2_src_1] != 0\"}},{\"id\":8,\"uid\":\"6f0f0828-fc6b-49d2-9a09-7a7365128db9\",\"type\":\"combobox\",\"x\":186,\"y\":42,\"w\":190,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"lambda.o2_src_2\",\"enableCondition\":\"[#lambda.enabled] == 1 and [#lambda.o2_src_1] != 0\",\"ranges\":\"#ff453a,,,,0,[$o2_src_fault]\"}},{\"id\":9,\"uid\":\"242f12dc-423e-403b-821a-9eaf4f561fb0\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":250,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Target Voltage\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#lambda.enabled] == 1 and [#lambda.o2_src_1] > 0 and [#lambda.o2_src_1] < 3\"}},{\"id\":10,\"uid\":\"ed2b84f2-a21c-47ac-8a90-17937eb0246d\",\"type\":\"configedit\",\"x\":266