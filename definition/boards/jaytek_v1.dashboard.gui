\":4,\"props\":{\"labelText\":\"P1009\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.raw_max] == 1\"}},{\"id\":22,\"uid\":\"f9b5ed65-77be-4ef6-9072-06056fa12c9e\",\"type\":\"label\",\"x\":34,\"y\":127,\"w\":515,\"h\":16,\"groupId\":4,\"props\":{\"labelText\":\"The pin reads above this \\u2014 a short to power, or a missing pull-down.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"bb9f4337-5c18-4d2f-82b6-985ee1368d59\",\"type\":\"label\",\"x\":10,\"y\":148,\"w\":500,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Plausibility  (calibrated reading)\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":24,\"uid\":\"5f2912ed-3710-471f-97b3-4627f355000e\",\"type\":\"checkbox\",\"x\":10,\"y\":172,\"w\":22,\"h\":22,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.op_min\"}},{\"id\":25,\"uid\":\"94f9d35c-0c7a-47b2-bdf5-5fac178e31d8\",\"type\":\"label\",\"x\":40,\"y\":170,\"w\":194,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Detect Reading Low\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":26,\"uid\":\"bfa16900-b5c6-411a-9bbd-a2d43a4737a7\",\"type\":\"configedit\",\"x\":240,\"y\":170,\"w\":96,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_op_min\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":27,\"uid\":\"df1ee979-94d8-4c43-8f42-7b5e105996fe\",\"type\":\"enum\",\"x\":346,\"y\":170,\"w\":110,\"h\":30,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.op_min\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":28,\"uid\":\"3a62dcf6-79b3-4e6d-9362-65a147df3e3b\",\"type\":\"label\",\"x\":462,\"y\":174,\"w\":60,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"P100A\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_min] == 1\"}},{\"id\":29,\"uid\":\"fea32040-bb00-4943-8609-d3bc2776f23d\",\"type\":\"label\",\"x\":34,\"y\":195,\"w\":515,\"h\":16,\"groupId\":5,\"props\":{\"labelText\":\"The calibrated reading is below what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":30,\"uid\":\"84180704-4e7c-420d-90f3-7f8416b47ede\",\"type\":\"checkbox\",\"x\":10,\"y\":218,\"w\":22,\"h\":22,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_enable.op_max\"}},{\"id\":31,\"uid\":\"a1db00a9-6f0e-46c2-afcb-2062231e6006\",\"type\":\"label\",\"x\":40,\"y\":216,\"w\":194,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Detect Reading High\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":32,\"uid\":\"e8cefe39-ea5e-486a-ba22-9dd35a7016a0\",\"type\":\"configedit\",\"x\":240,\"y\":216,\"w\":96,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_op_max\",\"displayUnit\":\"Auto\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":33,\"uid\":\"48eb842c-ca23-4693-b042-0a7f5533d6b3\",\"type\":\"enum\",\"x\":346,\"y\":216,\"w\":110,\"h\":30,\"groupId\":6,\"props\":{\"signalName\":\"sensors.sensor[*].diag_severity.op_max\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":34,\"uid\":\"7312be1f-cfa6-4529-a86f-bdc89ef32fab\",\"type\":\"label\",\"x\":462,\"y\":220,\"w\":60,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"P100B\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"fgColor\":\"#8a8f98\",\"enableCondition\":\"[#sensors.sensor[*].diag_enable.op_max] == 1\"}},{\"id\":35,\"uid\":\"daa1207d-06a2-4dd3-b890-ce935c394463\",\"type\":\"label\",\"x\":34,\"y\":241,\"w\":515,\"h\":16,\"groupId\":6,\"props\":{\"labelText\":\"The calibrated reading is above what this engine could plausibly produce.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":36,\"uid\":\"a6203829-c1fa-46aa-8fed-e2115c0d1f8a\",\"type\":\"label\",\"x\":560,\"y\":38,\"w\":140,\"h\":20,\"groupId\":7,\"props\":{\"labelText\":\"DTC Delay\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":37,\"uid\":\"569bfbc3-50a7-4ced-9e44-20c570b87a2b\",\"type\":\"configedit\",\"x\":706,\"y\":34,\"w\":123,\"h\":30,\"groupId\":7,\"props\":{\"signalName\":\"sensors.sensor[*].diag_delay_ms\"}},{\"id\":38,\"uid\":\"86cc069e-dba4-4f57-924f-a7d66b621bd4\",\"type\":\"label\",\"x\":560,\"y\":68,\"w\":400,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"How long a check has to keep failing before it becomes a fault. A sensor that blips once on a starter crank is not a broken sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":39,\"uid\":\"9f7a5a80-a033-41cf-a2f9-3234e3bb7bb1\",\"type\":\"label\",\"x\":560,\"y\":110,\"w\":400,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Precondition\",\"align\":\"Left\",\"fontName\":\"|15|1|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":40,\"uid\":\"b53f20be-ff98-4695-b771-6b3ac21191d7\",\"type\":\"expression\",\"x\":560,\"y\":132,\"w\":400,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].precond_expr\"}},{\"id\":41,\"uid\":\"34f031c4-9a97-411e-bec3-3f44702cb989\",\"type\":\"label\",\"x\":560,\"y\":164,\"w\":400,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"The plausibility checks only run while this holds \\u2014 an oil pressure of zero is a fault at 3000 rpm and the truth with the engine stopped.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":42,\"uid\":\"84676182-e7f6-4451-b8db-64559bfb1718\",\"type\":\"label\",\"x\":990,\"y\":34,\"w\":250,\"h\":170,\"groupId\":0,\"props\":{\"labelText\":\"The electrical pair tests the RAW input in the input's own units, before calibration; the plausibility pair tests the calibrated reading. Severity is what the DTC records and what the protection levels read. A check with no code is one this sensor cannot report, and is not offered \\u2014 which is why two sensors show different rows here.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[lambda_1]"},"Configuration/Sensors/O2 & Lambda/Wideband O2 2":{"uid":"489d54f3-775e-43b1-8c4b-4f0aa2b0765a","canvasWidth":1280,"canvasHeight":700,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Wideband O2 2","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"ae0ebdc7-22b9-4be3-8450-19208a62799a","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"sensors.sensor[*].enabled"}},{"id":2,"uid":"70fffa55-a734-42f2-a52a-9377a170deb8","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"4ec5618b-4ce0-463c-b7a4-d50eb1383179","type":"label","x":136,"y":4,"w":379,"h":24,"groupId":0,"props":{"labelText":"What this input is wired to, and what its curve makes of it.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":4,"uid":"8dc34cbd-ca92-4746-a7a7-6a72f7945b29","type":"panel","x":10,"y":30,"w":300,"h":662,"groupId":0,"props":{"labelText":"1 · Input","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":5,\"uid\":\"f8ae140c-1e93-40d1-92a5-07bb9640b1ee\",\"type\":\"value\",\"x\":12,\"y\":10,\"w\":274,\"h\":54,\"groupId\":0,\"props\":{\"signalName\":\"[$~]\",\"fontName\":\"|26|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"4\"}},{\"id\":6,\"uid\":\"5c9f927e-593f-48f6-9529-3f1b0bb07269\",\"type\":\"label\",\"x\":12,\"y\":66,\"w\":274,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Raw input  (as the pin reads it)\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":7,\"uid\":\"b8873fc0-ee7f-442c-8514-7776df0fc5eb\",\"type\":\"label\",\"x\":10,\"y\":100,\"w\":90,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Interface\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":8,\"uid\":\"c920d43d-98df-4616-83df-322a033bfc75\",\"type\":\"combobox\",\"x\":106,\"y\":96,\"w\":150,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"sensors.sensor[*].interface\"}},{\"id\":9,\"uid\":\"2e72e081-9da8-456b-91d1-1da4e2cdef89\",\"type\":\"wiring\",\"x\":10,\"y\":132,\"w\":274,\"h\":76,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].source\",\"condition\":\"[#sensors.sensor[*].interface] == 0 || [#sensors.sensor[*].interface] == 1 || [#sensors.sensor[*].interface] == 3 || [#sensors.sensor[*].interface] == 4 || [#sensors.sensor[*].interface] == 6 || [#sensors.sensor[*].interface] == 7\"}},{\"id\":10,\"uid\":\"de09c73b-e50e-44b2-a83c-eb34efe5df87\",\"type\":\"label\",\"x\":10,\"y\":220,\"w\":90,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"CAN Field\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 5\"}},{\"id\":11,\"uid\":\"725bb45b-3d76-44fb-bc5c-03b6af9c5b15\",\"type\":\"canfield\",\"x\":106,\"y\":216,\"w\":170,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"sensors.sensor[*].can_frame\",\"condition\":\"[#sensors.sensor[*].interface] == 5\"}},{\"id\":12,\"uid\":\"1df2ed98-8a2c-45b8-983c-f02d1c7e1b80\",\"type\":\"checkbox\",\"x\":10,\"y\":252,\"w\":22,\"h\":22,\"groupId\":5,\"props\":{\"signalName\":\"sensors.sensor[*].flags.invert\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":13,\"uid\":\"b63d8dba-8f99-4fe8-a341-5970ec33d468\",\"type\":\"label\",\"x\":40,\"y\":249,\"w\":220,\"h\":20,\"groupId\":5,\"props\":{\"labelText\":\"Invert  (switch inputs)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"condition\":\"[#sensors.sensor[*].interface] == 4\"}},{\"id\":14,\"uid\":\"782fc9c7-f774-4769-890a-02cc08dac681\",\"type\":\"label\",\"x\":10,\"y\":292,\"w\":274,\"h\":224,\"groupId\":0,\"props\":{\"labelText\":\"Interface says HOW the pin is read, and decides which inputs the picker offers \\u2014 a frequency sensor cannot be wired to an analogue pin. Two sensors on one pin is a fault, not a preference. A CAN sensor has no pin at all: it reads a field defined on the Receive page for its bus, named here by that frame and the field's start bit. A field whose own Signal is set is greyed in the list \\u2014 the frame writes that channel itself, and the sensor publishing it too would put two producers on one channel.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}},{"id":15,"uid":"b33c23d1-ffb5-4273-ac22-eed2b2dffb24","type":"panel","x":320,"y":30,"w":630,"h":662,"groupId":0,"props":{"labelText":"2 · Calibration","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":16,\"uid\":\"39f62872-97b3-484c-9d4d-4d7afc4cdb0b\",\"type\":\"table\",\"x\":10,\"y\":10,\"w\":600,\"h\":96,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"axisMode\":\"1\",\"displayUnit\":\"Auto\",\"displayUnitX\":\"Auto\",\"displayUnitY\":\"Auto\",\"cellTrace\":\"2\"}},{\"id\":17,\"uid\":\"d86b457a-03b9-4b7b-ae7b-2e3e475ea205\",\"type\":\"curve\",\"x\":10,\"y\":114,\"w\":600,\"h\":450,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\",\"displayUnit\":\"Auto\",\"axisUnit\":\"Auto\",\"valueUnit\":\"Auto\"}},{\"id\":18,\"uid\":\"5564c94d-700d-4f9e-99cb-d3aa29229fcf\",\"type\":\"label\",\"x\":10,\"y\":568,\"w\":600,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"Raw in along the top, reading out underneath. Right-click either for insert, delete, linearise \\u2014 or to save this curve to a file and load it into the next car with the same sensor.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\",\"signalName\":\"sensors.sensor[*].cal\"}},{\"id\":19,\"uid\":\"7a117540-51e9-4913-a2f4-97f85fa25d71\",\"type\":\"bands\",\"x\":10,\"y\":10,\"w\":600,\"h\":616,\"groupId\":0,\"props\":{\"signalName\":\"sensors.sensor[*].cal\"}}]"}},{"id":20,"uid":"cb40ff97-2973-46c1-b27b-73e74ca0f1da","type":"panel","x":960,"y":30,"w":310,"h":662,"groupId":0,"props":{"labelText":"3 · Output","layoutMode":"0","padding":"0","enableCondition":"[#sensors.sensor[*].enabled] == 1","children":"[{\"id\":21,\"uid\":\"210a4029-1fab-4538-8d4b-9de1c58b2226\",\"type\":\"value\",\"x\":12,\"y\":10,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"signalName\":\"[$*]\",\"format\":\"%.2f\",\"fontName\":\"|30|0|0\",\"align\":\"Center\",\"borderWidth\":\"1\",\"borderRadius\":\"4\"}},{\"id\":22,\"uid\":\"b8d95568-b2f9-45dd-b246-746e7bd2c68c\",\"type\":\"label\",\"x\":12,\"y\":74,\"w\":284,\"h\":18,\"groupId\":0,\"props\":{\"labelText\":\"Reading  (what everything downstream sees)\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":23,\"uid\":\"1207ae61-72ba-4c5b-896f-b6df372176d6\",\"type\":\"label\",\"x\":10,\"y\":106,\"w\":90,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Type\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":24,\"uid\":\"6d2d5671-06d6-4f1b-a9b4-93ba09dd0c72\",\"type\":\"label\",\"x\":106,\"y\":106,\"w\":190,\"h\":20,\"groupId\":6,\"props\":{\"labelText\":\"Lambda\",\"align\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":25,\"uid\":\"40ba2c9a-75c3-4f40-ab76-c07f586780a9\",\"type\":\"label\",\"x\":10,\"y\":142,\"w\":284,\"h\":62,\"groupId\":0,\"props\":{\"labelText\":\"This input's type is fixed by the ECU \\u2014 it is what the sensor IS. Only the generic inputs (aux, rotary trim) can be re-typed.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":26,\"uid\":\"ae6555f5-4e18-4517-bab8-40bb964b6580\",\"type\":\"label\",\"x\":10,\"y\":214,\"w\":284,\"h\":98,\"groupId\":0,\"props\":{\"labelText\":\"Input and output are both on screen because a calibration is a claim about how one becomes the other: watch the pair move together and a wrong curve shows itself immediately.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}},{\"id\":27,\"uid\":\"e600d5f8-50da-46f8-9de4-7a7837dc4c0d\",\"type\":\"panel\",\"x\":10,\"y\":308,\"w\":284,\"h\":1,\"groupId\":0,\"props\":{\"bgColor\":\"#8a8f98\",\"padding\":\"0\"}},{\"id\":28,\"uid\":\"b1cb1d13-08dd-4660-96ba-8f452ce4677c\",\"type\":\"label\",\"x\":10,\"y\":318,\"w\":284,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Diagnostics  (4 checks)\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"link\":\"Configuration/Sensors/O2 & Lambda/Wideband O2 2/Diagnostics\"}},{\"id\":29,\"uid\":\"98409e2e-6d98-44a8-a556-c0d200947633\",\"type\":\"label\",\"x\":10,\"y\":342,\"w\":284,\"h\":44,\"groupId\":0,\"props\":{\"labelText\":\"What this input must complain about, when, and with which code.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}],"elementScope":"sensors.sensor[lambda_2]"},"Configuration/Sensors/O2 & Lambda/Wideband O2 2/Diagnostics":{"uid":"54422972-27e8-4eab-b3dc-1457fe3b41ec","canvasWidth":1280,"canvasHeight":336,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Wideband O2 2 — Diagnostics","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"fb4e47c6-c13a-43b5-8f39-b50a155df045","type":"checkbox","x":10,"y":3,"w":22,"h":22,"groupId":2,"props":{"signalName":"sensors.sensor[*].enabled"}},{"id":2,"uid":"81e041bc-dfd2-4cf7-8bc7-ff8a6e43c948","type":"label","x":40,"y":5,"w":90,"h":20,"groupId":2,"props":{"labelText":"Enabled","align":"Left","fontName":"|16|0|0"}},{"id":3,"uid":"e80f440a-a7ee-4e12-bbdb-225c26ac8587","type":"label","x":136,"y":4,"w":864,"h":24,"groupId":0,"props":{"labelText":"What this input must complain about 