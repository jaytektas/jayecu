1\"}},{\"id\":51,\"uid\":\"2d8ce423-b06e-461c-946e-34ad601bb354\",\"type\":\"configedit\",\"x\":348,\"y\":184,\"w\":80,\"h\":30,\"groupId\":8,\"props\":{\"signalName\":\"idle.idle_up[5].rpm_offset\",\"enableCondition\":\"[#idle.idle_up[5].enabled] == 1 and [#idle.mode] == 1\"}},{\"id\":52,\"uid\":\"0da454be-8450-4470-af69-d90bff6b2cb1\",\"type\":\"configedit\",\"x\":438,\"y\":184,\"w\":80,\"h\":30,\"groupId\":8,\"props\":{\"signalName\":\"idle.idle_up[5].base_offset_x10\",\"enableCondition\":\"[#idle.idle_up[5].enabled] == 1\"}},{\"id\":53,\"uid\":\"e91fa9fc-d660-45bc-9bc2-8fe5a51209fa\",\"type\":\"configedit\",\"x\":528,\"y\":184,\"w\":90,\"h\":30,\"groupId\":8,\"props\":{\"signalName\":\"idle.idle_up[5].on_delay_ms\",\"enableCondition\":\"[#idle.idle_up[5].enabled] == 1\"}},{\"id\":54,\"uid\":\"994d43ba-43df-4386-9f1d-15fba67e2e11\",\"type\":\"configedit\",\"x\":628,\"y\":184,\"w\":90,\"h\":30,\"groupId\":8,\"props\":{\"signalName\":\"idle.idle_up[5].decay_ms\",\"enableCondition\":\"[#idle.idle_up[5].enabled] == 1\"}}]"}},{"id":55,"uid":"dd66cf92-037e-436f-9e17-a6d150481c03","type":"panel","x":840,"y":46,"w":430,"h":340,"groupId":0,"props":{"labelText":"How a Slot Works","layoutMode":"0","padding":"0","children":"[{\"id\":56,\"uid\":\"6b6e46df-8585-425b-b6d8-e121fbd875af\",\"type\":\"label\",\"x\":10,\"y\":10,\"w\":400,\"h\":224,\"groupId\":0,\"props\":{\"labelText\":\"ABOVE is the level the input signal must exceed to count as active \\u2014 0.5 for a plain 0/1 switch, a real number for an analogue input like a pressure sender.\\n\\nON DELAY is how long it must hold before the offset engages, which keeps a switch that chatters from stepping the idle. DECAY is how long the offset takes to ramp away after the input releases \\u2014 an offset that vanishes instantly makes the idle dip.\\n\\nThe RPM offset raises the closed-loop TARGET; the duty offset raises the base directly, which is what an open-loop idle needs. A slot may use either or both.\",\"align\":\"Left\"