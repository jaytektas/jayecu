":20,\"groupId\":13,\"props\":{\"labelText\":\"Last Error\",\"align\":\"Center\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\"}},{\"id\":29,\"uid\":\"e27b5cec-9bf7-4bb0-8949-53f0a5d30eb5\",\"type\":\"label\",\"x\":14,\"y\":238,\"w\":410,\"h\":80,\"groupId\":0,\"props\":{\"labelText\":\"A transmit error count above 127 is error-passive and 255 is bus-off; Refused counts frames the driver would not take, which is a jammed mailbox rather than a quiet wire. A bus reading zero load with errors climbing is talking to nobody.\",\"align\":\"Left\",\"fontName\":\"|15|0|0\",\"fgColor\":\"#8a8f98\",\"wrap\":\"1\"}}]"}}]},"Configuration/CAN Bus/CAN2/Transmit":{"uid":"806b45e4-3f3e-4d34-909d-a967bbc14c9d","canvasWidth":1280,"canvasHeight":716,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"CAN2 Transmit","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"287e9465-7a1b-48d2-8a99-6f78efd49044","type":"label","x":10,"y":4,"w":990,"h":56,"groupId":0,"props":{"labelText":"Frames this ECU SENDS on CAN2, each on its own period, built from whatever the signal bus is carrying at the time. A transmit frame is unsolicited traffic — it goes on a wire that may already belong to something else — so a frame can be parked with its Enabled tick without losing how it was set up. CAN2 must be enabled on its own page (CAN Bus ▸ CAN2); edits live in ECU RAM until you burn.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"e1ae1c07-de6d-4d46-aeff-297e423359b0","type":"genericcan","x":10,"y":62,"w":1260,"h":644,"groupId":0,"props":{"bus":"1","dir":"Transmit"}}]},"Configuration/CAN Bus/CAN2/Receive":{"uid":"afec5d4b-f227-4f3f-aca2-bf9a0c98f8b5","canvasWidth":1280,"canvasHeight":716,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"CAN2 Receive","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"3c750e2b-4d9b-43b0-8eb7-3e7ebb6b9717","type":"label","x":10,"y":4,"w":990,"h":56,"groupId":0,"props":{"labelText":"Frames this ECU DECODES on CAN2. Each signal lands on the bus with a TTL, so a sender going quiet leaves an absent channel rather than a number frozen at its last value. A signal left as “none” is one a SENSOR reads: point that sensor's CAN Field at the field and it publishes the channel with its own calibration and diagnostics. CAN2 must be enabled on its own page (CAN Bus ▸ CAN2); edits live in ECU RAM until you burn.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"83503fd4-cab2-421a-8b27-f526cc2a7cb2","type":"genericcan","x":10,"y":62,"w":1260,"h":644,"groupId":0,"props":{"bus":"1","dir":"Receive"}}]},"Configuration/Vehicle Functions/Launch Control/Launch End RPM":{"uid":"b952c492-a21c-4e18-a722-579532b94dd9","canvasWidth":1280,"canvasHeight":352,"minWidth":1280,"canvasStatic":3,"canvasAnchor":0,"guideW":0,"guideH":0,"title":"Launch End RPM","layout":0,"gridColumns":2,"focusIndex":0,"borderColor":"","borderWidth":0,"borderStyle":1,"borderRadius":4,"titleFont":"","titleColor":"","titlePadding":4,"titleStyle":1,"titlePlace":0,"titleEdge":0,"titleAlign":0,"widgets":[{"id":1,"uid":"efa5adfa-a8c5-49ec-a2c5-f138c32a4633","type":"label","x":10,"y":4,"w":990,"h":56,"groupId":0,"props":{"labelText":"The End RPM is the limit itself — the RPM at which every cylinder is cut — and its two axes ship switched off, so it is one number until you say otherwise. The ignition map is the ACTUAL advance while launch is active, not a correction on the main map: away from the launch cell it should read like the normal calibration, because the engine runs through it on the way there and back.","align":"Left","fontName":"|15|0|0","fgColor":"#8a8f98","wrap":"1"}},{"id":2,"uid":"0f108738-d6a3-49df-b6e3-59478334f339","type":"table","x":10,"y":62,"w":401,"h":222,"groupId":0,"props":{"signalName":"launch.end_rpm_table","axisMode":"1","displayUnit":"Auto","displayUnitX":"Auto","displayUnitY":"Auto","displayUnitZ":"Auto","cellTrace":"2","anchorX":"both","anchorY":"both"}},{"id":3,"uid":"43fa503e-e74c-499c-9420-f901a62a7327","type":"value","x":10,"y":292,"w":111,"h":30,"groupId":2,"props":{"signalName":"launch.end_rpm_table","format":"%.0f","fontName":"|20|0|0","align":"Center","anchorY":"bottom"}},{"id":4,"uid":"fea81a8f-e82f-4217-8859-0e517460be65","type":"label","x":10,"y":322,"w":111,"h":20,"groupId":2,"props":{"labelText":"Launch End RPM","align":"Center","fontName":"|15|0|0","fgColor":"#8a8f98","anchorY":"bottom"}},{"id":5,"uid":"76f43132-6175-4ad8-b24e-e897ecaa19e8","type":"value","x":133,"y":292,"w":95,"h":30,"groupId":3,"props":{"signalName":"launch_active","format":"%.0f","fontName":"|20|0|0","align":"Center","anchorY":"bottom"}},{"id":6,"uid":"d3f10304-f560-42ed-acb0-3ab2c74722eb","type":"label","x":133,"y":322,"w":95,"h":20,"groupId":3,"props":{"labelText":"Launch Active","align":"Center","fontName":"|15|0|0","fgColor":"#8a8f98","anchorY":"bottom"}},{"id":7,"uid":"6b10ffcf-224e-4e3b-a883-6b81b7504263","type":"value","x":240,"y":292,"w":83,"h":30,"groupId":4,"props":{"signalName":"launch_end_rpm","format":"%.0f","fontName":"|20|0|0","align":"Center","anchorY":"bottom"}},{"id":8,"uid":"d6b03d58-6d34-48f1-a3b3-ff296d1a7a8b","type":"label","x":240,"y":322,"w":83,"h":20,"groupId":4,"props":{"labelText":"End RPM","align":"Center","fontName":"|15|0|0","fgColor":"#8a8f98","anchorY":"bottom"}},{"id":9,"uid":"ea49841f-686b-4b27-9c1b-dab98785ad2d","type":"value","x":335,"y":292,"w":84,"h":30,"groupId":5,"props":{"signalName":"rpm","format":"%.0f","fontName":"|20|0|0","align":"Center","anchorY":"bottom"}},{"id":10,"uid":"e5442109-707e-4678-84