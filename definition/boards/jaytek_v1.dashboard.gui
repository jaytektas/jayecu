lign\":\"Left\",\"fontName\":\"|16|0|0\"}},{\"id\":4,\"uid\":\"f3f8d9d2-c087-4e1f-9c36-2d2ab9ab9f97\",\"type\":\"combobox\",\"x\":256,\"y\":12,\"w\":190,\"h\":30,\"groupId\":2,\"props\":{\"signalName\":\"outputs.output[*].freq_source\"}},{\"id\":5,\"uid\":\"2e5cbf1a-4636-4025-bdce-395198c23978\",\"type\":\"label\",\"x\":10,\"y\":46,\"w\":330,\"h\":20,\"groupId\":3,\"props\":{\"labelText\":\"Fixed Frequency\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 0\"}},{\"id\":6,\"uid\":\"80d40fe9-8924-4ab6-b7bc-778dbf09f132\",\"type\":\"configedit\",\"x\":346,\"y\":42,\"w\":100,\"h\":30,\"groupId\":3,\"props\":{\"signalName\":\"outputs.output[*].pwm_freq_hz\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 0\"}},{\"id\":7,\"uid\":\"c42e98b1-cb04-47d6-b004-60d1818a8849\",\"type\":\"label\",\"x\":10,\"y\":76,\"w\":180,\"h\":20,\"groupId\":4,\"props\":{\"labelText\":\"Frequency Table\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 1\"}},{\"id\":8,\"uid\":\"83eee1e6-f933-4b44-9902-f474ce91366e\",\"type\":\"enum\",\"x\":196,\"y\":72,\"w\":250,\"h\":30,\"groupId\":4,\"props\":{\"signalName\":\"outputs.output[*].freq_table_sel\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 1\"}},{\"id\":9,\"uid\":\"c90a2050-3b96-4bc4-8849-9382b8b6c480\",\"type\":\"label\",\"x\":10,\"y\":108,\"w\":110,\"h\":20,\"groupId\":0,\"props\":{\"labelText\":\"Expression\",\"align\":\"Left\",\"fontName\":\"|16|0|0\",\"enableCondition\":\"[#outputs.output[*].function] == 3 and [#outputs.output[*].freq_source] == 2\"}},{\"id\":10,\"uid\":\"328fc0a9-3f82-4fd2-b608-440ae0c6dcea\",\"type\":\"expression\",\"x\":124,\"y\":104,\"w\":336,\"h\":30,\"groupId\":0,\"props\":{\"signalName\":\"outputs.output[*].freq_expr\",\"enableConditi